# The app runs immediately in demo mode without Supabase.
CP_OFS_DEMO_MODE=true
NEXT_PUBLIC_CP_OFS_DEMO_MODE=true

# Fill these when connecting the real Supabase database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Organization defaults
CP_OFS_DEFAULT_ORG_SLUG=comeplayers
CP_OFS_TIMEZONE=Asia/Jakarta
CP_OFS_FUNCTIONAL_CURRENCY=IDR

# Safety switches. Keep false until production workflows are validated.
CP_OFS_FINANCE_MUTATIONS_ENABLED=false
CP_OFS_PAYROLL_MUTATIONS_ENABLED=false
CP_OFS_INVENTORY_MUTATIONS_ENABLED=false
