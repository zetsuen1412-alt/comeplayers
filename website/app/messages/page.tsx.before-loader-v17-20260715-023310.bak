function displayName(profile?: Profile | null) {
  return profile?.username || profile?.full_name || "ComePlayers User";
}

function profileInitial(profile?: Profile | null) {
  return displayName(profile).slice(0, 1).toUpperCase();
}

function safeAvatarUrl(profile?: Profile | null) {
  const value = String(profile?.avatar_url || "").trim();
  if (!value) return "";
  if (
    value.startsWith("/") ||
    value.startsWith("https://") ||
    value.startsWith("http://")
  ) {
    return value;
  }
  return "";
}

function safeServerIconUrl(value?: string | null) {
  const iconUrl = String(value || "").trim();
  if (
    iconUrl.startsWith("/") ||
    iconUrl.startsWith("https://") ||
    /^data:image\/(?:png|jpeg|webp);base64,/i.test(iconUrl)
  ) {
    return iconUrl;
  }
  return "";
}

async function fileToServerIcon(file: File) {
  if (!new Set(["image/jpeg", "image/png", "image/webp"]).has(file.type)) {
    throw new Error("Server icon must be a JPG, PNG, or WEBP image.");
  }
  if (file.size <= 0 || file.size > 5 * 1024 * 1024) {
    throw new Error("Server icon must be smaller than 5 MB.");
  }

  const objectUrl = URL.createObjectURL(file);
  try {
    const source = await new Promise<HTMLImageElement>((resolve, reject) => {
      const image = document.createElement("img");
      image.onload = () => resolve(image);
      image.onerror = () => reject(new Error("Server icon could not be decoded."));
      image.src = objectUrl;
    });
    const canvas = document.createElement("canvas");
    canvas.width = 256;
    canvas.height = 256;
    const context = canvas.getContext("2d");
    if (!context) throw new Error("Image processing is unavailable.");
    const sourceSize = Math.min(source.naturalWidth, source.naturalHeight);
    const sourceX = Math.max(0, (source.naturalWidth - sourceSize) / 2);
    const sourceY = Math.max(0, (source.naturalHeight - sourceSize) / 2);
    context.drawImage(
      source,
      sourceX,
      sourceY,
      sourceSize,
      sourceSize,
      0,
      0,
      256,
      256,
    );
    const encoded = canvas.toDataURL("image/webp", 0.82);
    if (encoded.length > 400_000) {
      throw new Error("Compressed server icon is still too large.");
    }
    return encoded;
  } finally {
    URL.revokeObjectURL(objectUrl);
  }
}

const avatarSizes = {
  sm: "h-9 w-9 text-xs",
  md: "h-10 w-10 text-xs",
  lg: "h-12 w-12 text-sm",
  message: "h-10 w-10 text-sm",
};

function ProfileAvatar({
  profile,
  size = "md",
  className = "",
  fallback,
  live = false,
  title,
}: {
  profile?: Profile | null;
  size?: keyof typeof avatarSizes;
  className?: string;
  fallback?: ReactNode;
  live?: boolean;
  title?: string;
}) {
  const avatarUrl = safeAvatarUrl(profile);
  const style: CSSProperties | undefined = avatarUrl
    ? { backgroundImage: `url("${avatarUrl.replace(/"/g, "%22")}")` }
    : undefined;

  return (
    <div
      aria-label={title || displayName(profile)}
      className={`relative flex shrink-0 items-center justify-center rounded-full bg-white/10 bg-cover bg-center font-black text-cyan-300 ring-1 ring-white/10 ${avatarSizes[size]} ${className}`}
      style={style}
    >
      {avatarUrl ? null : fallback || profileInitial(profile)}
      {live ? (
        <span className="absolute -right-1 -top-1 rounded-full bg-red-500 p-1 text-[8px] text-white">
          <FaVideo />
        </span>
      ) : null}
    </div>
  );
}

function ServerAvatar({
  iconUrl,
  name,
  className = "",
}: {
  iconUrl?: string | null;
  name: string;
  className?: string;
}) {
  const safeIcon = safeServerIconUrl(iconUrl);
  const style: CSSProperties | undefined = safeIcon
    ? { backgroundImage: `url("${safeIcon.replace(/"/g, "%22")}")` }
    : undefined;
  return (
    <span
      className={`flex shrink-0 items-center justify-center bg-[#10273a] bg-cover bg-center font-black text-cyan-200 ${className}`}
      style={style}
      aria-label={`${name} server icon`}
    >
      {safeIcon ? null : name.slice(0, 1).toUpperCase() || <FaServer />}
    </span>
  );
}

function isAdminProfile(profile?: Profile | null) {
  return String(profile?.role || "").toLowerCase() === "admin";
}

function isGroupRoom(room?: Room | null) {
  return String(room?.room_type || "").toLowerCase() === "group";
}

function roomTitle(room?: Room | null) {
  if (!room) return "Conversation";
  if (isGroupRoom(room)) return room.server?.name || room.title || "Server";
  return displayName(room.other);
}

function roomInitial(room?: Room | null) {
  if (!room) return "C";
  if (isGroupRoom(room)) return roomTitle(room).slice(0, 1).toUpperCase();
  return profileInitial(room.other);
}

function formatDate(value?: string | null) {
  if (!value) return "";
  return new Intl.DateTimeFormat("id-ID", {
    day: "2-digit",
    month: "short",
    hour: "2-digit",
    minute: "2-digit",
  }).format(new Date(value));
}

function formatMessageTime(value?: string | null) {
  if (!value) return "";
  const date = new Date(value);
  const now = new Date();
  const sameDay =
    date.getFullYear() === now.getFullYear() &&
    date.getMonth() === now.getMonth() &&
    date.getDate() === now.getDate();
  const time = new Intl.DateTimeFormat("en-US", {
    hour: "2-digit",
    minute: "2-digit",
    hour12: true,
  }).format(date);
  return sameDay ? `Today ${time}` : `${formatDate(value)} ${time}`;
}

function LiveDuration({ startedAt }: { startedAt?: string | null }) {
  const [now, setNow] = useState(() => Date.now());

  useEffect(() => {
    if (!startedAt) return;
    const timer = window.setInterval(() => setNow(Date.now()), 1000);
    return () => window.clearInterval(timer);
  }, [startedAt]);

  if (!startedAt) return <span>00:00:00</span>;
  const started = new Date(startedAt).getTime();
  const totalSeconds = Number.isFinite(started)
    ? Math.max(0, Math.floor((now - started) / 1000))
    : 0;
  const hours = Math.floor(totalSeconds / 3600);
  const minutes = Math.floor((totalSeconds % 3600) / 60);
  const seconds = totalSeconds % 60;
  return (
    <span>
      {String(hours).padStart(2, "0")}:{String(minutes).padStart(2, "0")}:{String(seconds).padStart(2, "0")}
    </span>
  );
}

function formatSize(value?: number | null) {
  const size = Number(value || 0);
  if (size < 1024) return `${size} B`;
  if (size < 1024 * 1024) return `${(size / 1024).toFixed(1)} KB`;
  return `${(size / (1024 * 1024)).toFixed(1)} MB`;
}

function memberRoleLabel(role?: string | null) {
  const normalized = String(role || "member").toLowerCase();
  if (normalized === "owner") return "Creator";
  if (normalized === "moderator") return "Leader";
  if (normalized === "buyer") return "Buyer";
  if (normalized === "seller") return "Seller";
  return "Member";
}

function canManageMembers(role?: string | null, profile?: Profile | null) {
  const normalized = String(role || "").toLowerCase();
  return (
    isAdminProfile(profile) ||
    normalized === "admin" ||
    normalized === "owner" ||
    normalized === "moderator" ||
    normalized === "group_owner" ||
    normalized === "group_moderator"
  );
}

function canAssignGroupLeaders(role?: string | null, profile?: Profile | null) {
  const normalized = String(role || "").toLowerCase();
  return (
    isAdminProfile(profile) ||
    normalized === "admin" ||
    normalized === "group_owner"
  );
}

function isLiveRoom(room?: Room | null) {
  return String(room?.stream_status || "").toLowerCase() === "live";
}

function isTradeRoom(room?: Room | null) {
  return Boolean(
    room?.product_id || room?.order_id || room?.product || room?.order,
  );
}

function bucketMatches(room: Room, bucket: RoomBucket) {
  if (bucket === "live") return isLiveRoom(room);
  if (bucket === "group") return isGroupRoom(room);
  if (bucket === "trade") return isTradeRoom(room);
  if (bucket === "direct") return !isGroupRoom(room) && !isTradeRoom(room);
  return true;
}

function isImageAttachment(attachment?: Attachment | null) {
  return String(attachment?.mime_type || "").startsWith("image/");
}

function isGenericAttachmentMessage(message?: string | null) {
  return (
    String(message || "")
      .trim()
      .toLowerCase() === "attachment"
  );
}

function AttachmentViewer({ attachment }: { attachment: Attachment }) {
  const [url, setUrl] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const isImage = isImageAttachment(attachment);

  async function reveal(silent = false) {
    setLoading(true);
    if (!silent) setError("");
    try {
      const data = await authenticatedFetchJson<{ url: string }>(
        `/api/messages/attachments/${attachment.id}`,
      );
      setUrl(data.url);
    } catch (loadError) {
      setError(
        loadError instanceof Error
          ? loadError.message
          : "Could not open attachment.",
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    if (!isImage) return;
    setUrl("");
    setError("");
    void reveal(true);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [attachment.id, isImage]);

  if (isImage) {
    if (url) {
      return (
        <a
          href={url}
          target="_blank"
          rel="noreferrer"
          className="inline-block max-w-full"
        >
          {/* eslint-disable-next-line @next/next/no-img-element */}
          <img
            src={url}
            alt={attachment.file_name}
            className="max-h-[430px] max-w-full rounded-2xl border border-white/10 object-contain shadow-2xl shadow-black/30"
            onError={() => {
              setUrl("");
              void reveal(true);
            }}
          />
        </a>
      );
    }

    return (
      <div className="inline-flex min-h-36 min-w-64 max-w-full items-center justify-center rounded-2xl border border-white/10 bg-black/30 px-5 py-4 text-sm text-gray-400">
        {loading ? "Loading image..." : "Image preview is unavailable."}
        {error ? (
          <button
            onClick={() => void reveal()}
            className="ml-3 rounded-lg border border-white/20 px-3 py-2 text-xs font-black text-white hover:bg-white hover:text-black"
          >
            Retry
          </button>
        ) : null}
      </div>
    );
  }

  return (
    <div className="rounded-2xl border border-white/15 bg-black/20 p-3">
      <div className="flex items-center gap-3">
        <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-white/10 text-xl">
          {attachment.mime_type === "application/pdf" ? (
            <FaFilePdf />
          ) : (
            <FaPaperclip />
          )}
        </div>
        <div className="min-w-0 flex-1">
          <p className="truncate text-sm font-black">{attachment.file_name}</p>
          <p className="text-xs opacity-60">
            {formatSize(attachment.size_bytes)}
          </p>
        </div>
      </div>

      <button
        onClick={() => void reveal()}
        disabled={loading}
        className="mt-3 rounded-lg border border-white/20 px-3 py-2 text-xs font-black hover:bg-white hover:text-black disabled:opacity-50"
      >
        {loading
          ? "Opening..."
          : url
            ? "Refresh secure link"
            : "Open secure attachment"}
      </button>
      {url ? (
        <a
          href={url}
          target="_blank"
          rel="noreferrer"
          className="ml-2 inline-flex rounded-lg bg-cyan-400 px-3 py-2 text-xs font-black text-black"
        >
          View file
        </a>
      ) : null}
      {error ? <p className="mt-2 text-xs text-red-300">{error}</p> : null}
    </div>
  );
}

function MessageReplyPreview({ reply }: { reply?: ReplyPreview | null }) {
  if (!reply) return null;
  return (
    <div className="mb-2 rounded-xl border-l-2 border-cyan-400/70 bg-black/20 px-3 py-2 text-xs text-gray-400">
      <p className="font-black text-cyan-300">
        Replying to {displayName(reply.sender)}
      </p>
      <p className="mt-1 truncate">{reply.message || "Message unavailable"}</p>
    </div>
  );
}

function MessageInteractions({
  message,
  mine,
  onReply,
  onEdit,
  onDelete,
  onReact,
  onReport,
}: {
  message: Message;
  mine: boolean;
  onReply: () => void;
  onEdit: () => void;
  onDelete: () => void;
  onReact: (emoji: string) => void;
  onReport: () => void;
}) {
  if (message.deleted_at) return null;
  return (
    <div className="mt-2 flex flex-wrap items-center gap-1.5">
      {(message.reactions || []).map((reaction) => (
        <button
          key={reaction.emoji}
          type="button"
          onClick={() => onReact(reaction.emoji)}
          className={`rounded-full border px-2 py-1 text-xs font-black transition ${
            reaction.reacted_by_me
              ? "border-cyan-300 bg-cyan-400/20 text-cyan-200"
              : "border-white/10 bg-white/5 text-gray-300 hover:border-white/30"
          }`}
          title={`${reaction.count} reaction`}
        >
          {reaction.emoji} {reaction.count}
        </button>
      ))}
      <div className="flex items-center gap-1 opacity-0 transition group-hover:opacity-100 group-focus-within:opacity-100">
        <button
          type="button"
          onClick={onReply}
          className="rounded-lg px-2 py-1 text-xs text-gray-400 hover:bg-white/10 hover:text-white"
          title="Reply"
        >
          <FaReply />
        </button>
        {CHAT_REACTION_EMOJIS.map((emoji) => (
          <button
            key={emoji}
            type="button"
            onClick={() => onReact(emoji)}
            className="rounded-lg px-1.5 py-1 text-xs hover:bg-white/10"
            title={`React ${emoji}`}
          >
            {emoji}
          </button>
        ))}
        {mine ? (
          <>
            <button
              type="button"
              onClick={onEdit}
              className="rounded-lg px-2 py-1 text-xs text-gray-400 hover:bg-white/10 hover:text-white"
              title="Edit"
            >
              <FaEdit />
            </button>
            <button
              type="button"
              onClick={onDelete}
              className="rounded-lg px-2 py-1 text-xs text-gray-400 hover:bg-red-400/10 hover:text-red-300"
              title="Delete"
            >
              <FaTrash />
            </button>
          </>
        ) : (
          <button
            type="button"
            onClick={onReport}
            className="rounded-lg px-2 py-1 text-xs text-gray-400 hover:bg-red-400/10 hover:text-red-300"
            title="Report"
          >
            <FaFlag />
          </button>
        )}
      </div>
    </div>
  );
}

function StreamVideoFallback({
  title,
  hostName,
  text,
}: {
  title: string;
  hostName: string;
  text: string;
}) {
  return (
    <div className="absolute inset-0 z-10 flex flex-col items-center justify-center bg-[#020617]/88 p-4 text-center">
      <FaBroadcastTower className="mb-3 text-2xl text-cyan-300" />
      <p className="max-w-md text-sm font-black text-white">
        {title || "Live gameplay"}
      </p>
      <p className="mt-1 max-w-md text-xs text-gray-300">{text}</p>
      <p className="mt-2 text-[11px] font-bold uppercase tracking-wider text-cyan-200">
        Host: {hostName}
      </p>
    </div>
  );
}

function GroupLiveStreamPanel({
  room,
  userId,
  profile,
  onRoomRefresh,
  onWatchingChange,
  onHostingChange,
  onViewerCountChange,
  compact = false,
  stageOnly = false,
}: {
  room: Room;
  userId: string;
  profile: Profile | null;
  onRoomRefresh: (roomId: string) => Promise<void>;
  onWatchingChange?: (watching: boolean) => void;
  onHostingChange?: (hosting: boolean) => void;
  onViewerCountChange?: (count: number) => void;
  compact?: boolean;
  stageOnly?: boolean;
}) {
  const [localStream, setLocalStream] = useState<MediaStream | null>(null);
  const [remoteStream, setRemoteStream] = useState<MediaStream | null>(null);
  const [hosting, setHosting] = useState(false);
  const [watching, setWatching] = useState(false);
  const [busy, setBusy] = useState(false);
  const [streamError, setStreamError] = useState("");
  const [onlineCount, setOnlineCount] = useState(0);
  const [watcherCount, setWatcherCount] = useState(0);
  const [streamReady, setStreamReady] = useState(false);
  const [remoteVideoReady, setRemoteVideoReady] = useState(false);
  const [streamTitle, setStreamTitle] = useState(
    room.stream_title || "Live gameplay",
  );
  const localVideoRef = useRef<HTMLVideoElement | null>(null);
  const remoteVideoRef = useRef<HTMLVideoElement | null>(null);
  const channelRef = useRef<ReturnType<typeof supabase.channel> | null>(null);
  const peersRef = useRef<Map<string, RTCPeerConnection>>(new Map());
  const candidateQueueRef = useRef<Map<string, RTCIceCandidateInit[]>>(
    new Map(),
  );
  const localStreamRef = useRef<MediaStream | null>(null);
  const remoteStreamRef = useRef<MediaStream | null>(null);
  const hostingRef = useRef(false);
  const watchingRef = useRef(false);
  const stoppingRef = useRef(false);

  const live = String(room.stream_status || "idle").toLowerCase() === "live";
  const hostIsMe = live && room.stream_host_id === userId;
  const hostName = hostIsMe ? "You" : displayName(room.stream_host);
  const streamState = room.stream;
  const liveHref =
    streamState?.watch_url ||
    `/messages?room=${encodeURIComponent(room.id)}&live=1`;

  useEffect(() => {
    setStreamTitle(room.stream_title || "Live gameplay");
  }, [room.id, room.stream_title]);

  useEffect(() => {
    const video = localVideoRef.current;
    if (!video) return;
    video.srcObject = localStream;
    if (localStream) {
      void video.play().catch(() => null);
    }
  }, [localStream]);

  useEffect(() => {
    remoteStreamRef.current = remoteStream;
    setRemoteVideoReady(false);
    const video = remoteVideoRef.current;
    if (!video) return;
    video.srcObject = remoteStream;
    if (remoteStream) {
      void video.play().catch(() => {
        setStreamError(
          "Tap the video controls if playback does not start automatically.",
        );
      });
    }
  }, [remoteStream]);

  useEffect(() => {
    watchingRef.current = watching;
    onWatchingChange?.(watching);
    return () => onWatchingChange?.(false);
  }, [onWatchingChange, watching]);

  useEffect(() => {
    onViewerCountChange?.(watcherCount);
    return () => onViewerCountChange?.(0);
  }, [onViewerCountChange, watcherCount]);

  useEffect(() => {
    onHostingChange?.(hosting);
    return () => onHostingChange?.(false);
  }, [hosting, onHostingChange]);

  useEffect(() => {
    const handleVoiceLobbyLeft = (event: Event) => {
      const detail = (
        event as CustomEvent<{ roomId?: string; channelId?: string }>
      ).detail;
      if (!detail || detail.roomId !== room.id) return;

      if (hostingRef.current || hostIsMe) {
        void stopStreaming();
        return;
      }
      if (watchingRef.current) {
        stopWatching();
      }
    };

    window.addEventListener(
      "comeplayers:voice-lobby-left",
      handleVoiceLobbyLeft as EventListener,
    );
    return () => {
      window.removeEventListener(
        "comeplayers:voice-lobby-left",
        handleVoiceLobbyLeft as EventListener,
      );
    };
    // stopStreaming and stopWatching intentionally use the latest refs/state.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [hostIsMe, room.id]);


  useEffect(() => {
    const handleForceStopLive = (event: Event) => {
      const detail = (event as CustomEvent<{ roomId?: string }>).detail;
      if (!detail || detail.roomId !== room.id) return;
      if (hostingRef.current || hostIsMe) {
        void stopStreaming();
      } else if (watchingRef.current) {
        stopWatching();
      }
    };

    window.addEventListener(
      "comeplayers:force-stop-live",
      handleForceStopLive as EventListener,
    );
    return () => {
      window.removeEventListener(
        "comeplayers:force-stop-live",
        handleForceStopLive as EventListener,
      );
    };
    // stopStreaming and stopWatching intentionally use the latest refs/state.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [hostIsMe, room.id]);

  function closePeer(peerId: string) {
    peersRef.current.get(peerId)?.close();
    peersRef.current.delete(peerId);
    candidateQueueRef.current.delete(peerId);
  }

  function closePeers() {
    for (const peer of peersRef.current.values()) {
      peer.close();
    }
    peersRef.current.clear();
    candidateQueueRef.current.clear();
  }

  function stopMediaTracks() {
    const activeStream = localStreamRef.current;
    activeStream?.getTracks().forEach((track) => track.stop());
    localStreamRef.current = null;
    if (typeof window !== "undefined") {
      window.dispatchEvent(
        new CustomEvent("comeplayers:screen-stream", {
          detail: { roomId: room.id, stream: null },
        }),
      );
    }
  }

  async function sendSignal(event: string, payload: SignalPayload) {
    const channel = channelRef.current;
    if (!channel) throw new Error("Live channel is still connecting.");
    const result = await channel.send({
      type: "broadcast",
      event,
      payload: { ...payload, from: userId },
    });
    if (result !== "ok") {
      throw new Error("Live signal could not be sent.");
    }
  }

  async function flushCandidateQueue(peerId: string, peer: RTCPeerConnection) {
    const queued = candidateQueueRef.current.get(peerId) || [];
    candidateQueueRef.current.delete(peerId);
    for (const candidate of queued) {
      await peer.addIceCandidate(new RTCIceCandidate(candidate));
    }
  }

  function createPeer(peerId: string) {
    const existing = peersRef.current.get(peerId);
    if (
      existing &&
      existing.connectionState !== "closed" &&
      existing.connectionState !== "failed"
    ) {
      return existing;
    }
    if (existing) closePeer(peerId);

    const peer = new RTCPeerConnection({
      iceServers: STREAM_ICE_SERVERS,
    });

    peer.onicecandidate = (event) => {
      if (!event.candidate) return;
      void sendSignal("ice-candidate", {
        to: peerId,
        candidate: event.candidate.toJSON(),
      }).catch(() => null);
    };

    peer.ontrack = (event) => {
      const stream = event.streams[0] || new MediaStream([event.track]);
      setRemoteVideoReady(false);
      setRemoteStream(stream);
      setWatching(true);
      setStreamError("");
    };

    peer.onconnectionstatechange = () => {
      if (peer.connectionState === "connected") {
        setStreamError("");
        return;
      }
      if (peer.connectionState === "failed") {
        setStreamError(
          "The live connection failed. Try again or configure a TURN server for different networks.",
        );
      }
      if (["closed", "disconnected", "failed"].includes(peer.connectionState)) {
        closePeer(peerId);
        if (!hostingRef.current) {
          setRemoteStream(null);
        }
      }
    };

    peersRef.current.set(peerId, peer);
    return peer;
  }

  async function createOfferForViewer(viewerId: string) {
    const media = localStreamRef.current;
    if (!media || !hostingRef.current) return;

    let peer = createPeer(viewerId);
    if (peer.signalingState !== "stable") {
      closePeer(viewerId);
      peer = createPeer(viewerId);
    }

    for (const track of media.getTracks()) {
      if (!peer.getSenders().some((sender) => sender.track?.id === track.id)) {
        peer.addTrack(track, media);
      }
    }

    const offer = await peer.createOffer();
    await peer.setLocalDescription(offer);
    await sendSignal("offer", { to: viewerId, sdp: offer });
  }

  async function handleOffer(payload: SignalPayload) {
    if (!payload.from || payload.to !== userId || !payload.sdp) return;
    const peer = createPeer(payload.from);
    await peer.setRemoteDescription(new RTCSessionDescription(payload.sdp));
    await flushCandidateQueue(payload.from, peer);
    const answer = await peer.createAnswer();
    await peer.setLocalDescription(answer);
    setWatching(true);
    await sendSignal("answer", { to: payload.from, sdp: answer });
  }

  async function handleAnswer(payload: SignalPayload) {
    if (!payload.from || payload.to !== userId || !payload.sdp) return;
    const peer = peersRef.current.get(payload.from);
    if (!peer) return;
    await peer.setRemoteDescription(new RTCSessionDescription(payload.sdp));
    await flushCandidateQueue(payload.from, peer);
  }

  async function handleCandidate(payload: SignalPayload) {
    if (!payload.from || payload.to !== userId || !payload.candidate) return;
    const peer = peersRef.current.get(payload.from) || createPeer(payload.from);
    if (!peer.remoteDescription) {
      const queued = candidateQueueRef.current.get(payload.from) || [];
      queued.push(payload.candidate);
      candidateQueueRef.current.set(payload.from, queued);
      return;
    }
    await peer.addIceCandidate(new RTCIceCandidate(payload.candidate));
  }

  async function requestViewerConnection(hostId: string) {
    if (!hostId || hostId === userId) return;
    closePeers();
    setRemoteStream(null);
    setWatching(true);
    setStreamError("");
    await sendSignal("viewer-join", { viewerId: userId, hostId });
  }

  useEffect(() => {
    if (!room.id || !userId) return;

    closePeers();
    stopMediaTracks();
    hostingRef.current = false;
    watchingRef.current = false;
    setHosting(false);
    setWatching(false);
    setLocalStream(null);
    setRemoteStream(null);
    setRemoteVideoReady(false);
    setStreamError("");

    const channel = supabase.channel(`group-stream:${room.id}`, {
      config: {
        private: true,
        presence: { key: userId },
      },
    });
    channelRef.current = channel;

    channel
      .on("broadcast", { event: "viewer-join" }, (event) => {
        const payload = event.payload as SignalPayload;
        if (!payload.viewerId || payload.viewerId === userId) return;
        if (payload.hostId && payload.hostId !== userId) return;
        void createOfferForViewer(payload.viewerId).catch((signalError) => {
          setStreamError(
            signalError instanceof Error
              ? signalError.message
              : "Could not connect the viewer.",
          );
        });
      })
      .on("broadcast", { event: "stream-started" }, (event) => {
        const payload = event.payload as SignalPayload;
        if (!payload.hostId || payload.hostId === userId) return;
        setStreamError("");
        void onRoomRefresh(room.id).catch(() => null);
      })
      .on("broadcast", { event: "offer" }, (event) => {
        void handleOffer(event.payload as SignalPayload).catch(
          (signalError) => {
            setStreamError(
              signalError instanceof Error
                ? signalError.message
                : "Could not join stream.",
            );
          },
        );
      })
      .on("broadcast", { event: "answer" }, (event) => {
        void handleAnswer(event.payload as SignalPayload).catch(
          (signalError) => {
            setStreamError(
              signalError instanceof Error
                ? signalError.message
                : "Could not connect viewer.",
            );
          },
        );
      })
      .on("broadcast", { event: "ice-candidate" }, (event) => {
        void handleCandidate(event.payload as SignalPayload).catch(() => null);
      })
      .on("broadcast", { event: "stream-ended" }, (event) => {
        const payload = event.payload as SignalPayload;
        if (payload.hostId === userId) return;
        closePeers();
        setRemoteStream(null);
        setRemoteVideoReady(false);
        setWatching(false);
        setStreamError("");
        void onRoomRefresh(room.id).catch(() => null);
      })
      .on("presence", { event: "sync" }, () => {
        const state = channel.presenceState() as Record<
          string,
          Array<{ watching?: boolean }>
        >;
        const entries = Object.values(state).flat();
        const count = entries.length;
        setOnlineCount(count);
        setWatcherCount(
          entries.reduce(
            (sum, entry) => sum + (entry.watching === true ? 1 : 0),
            0,
          ),
        );
      })
      .subscribe((status) => {
        if (status === "SUBSCRIBED") {
          setStreamReady(true);
          setStreamError("");
          void channel.track({
            userId,
            name: displayName(profile),
            streaming: hostingRef.current,
            onlineAt: new Date().toISOString(),
          });
        }
        if (status === "CHANNEL_ERROR" || status === "TIMED_OUT") {
          setStreamReady(false);
          setStreamError("Live channel permission is not available yet.");
        }
      });

    return () => {
      const wasHosting = hostingRef.current;
      if (wasHosting) {
        void authenticatedFetchJson(`/api/messages/rooms/${room.id}/stream`, {
          method: "POST",
          body: JSON.stringify({ action: "stop" }),
        }).catch(() => null);
      }
      closePeers();
      stopMediaTracks();
      hostingRef.current = false;
      watchingRef.current = false;
      channelRef.current = null;
      setHosting(false);
      setWatching(false);
      setLocalStream(null);
      setRemoteStream(null);
      setRemoteVideoReady(false);
      setStreamReady(false);
      void supabase.removeChannel(channel);
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [room.id, userId, profile?.id]);

  useEffect(() => {
    const channel = channelRef.current;
    if (!streamReady || !channel) return;
    void channel.track({
      userId,
      name: displayName(profile),
      streaming: hosting,
      watching,
      onlineAt: new Date().toISOString(),
    });
  }, [hosting, profile, streamReady, userId, watching]);

  useEffect(() => {
    if (live || hostingRef.current) return;
    closePeers();
    setRemoteStream(null);
    setRemoteVideoReady(false);
    setWatching(false);
  }, [live, room.id]);

  async function startStreaming() {
    setBusy(true);
    setStreamError("");
    try {
      if (!streamReady || !channelRef.current) {
        throw new Error(
          "Live channel is still connecting. Try again in a moment.",
        );
      }
      if (!navigator.mediaDevices?.getDisplayMedia) {
        throw new Error("Screen sharing is not supported in this browser.");
      }

      closePeers();
      setWatching(false);
      setRemoteStream(null);
      setRemoteVideoReady(false);

      const media = await navigator.mediaDevices.getDisplayMedia({
        video: { frameRate: { ideal: 30, max: 30 } },
        audio: true,
      });
      const videoTrack = media.getVideoTracks()[0];
      if (!videoTrack) {
        media.getTracks().forEach((track) => track.stop());
        throw new Error("No screen video track was selected.");
      }

      localStreamRef.current = media;
      setLocalStream(media);
      window.dispatchEvent(
        new CustomEvent("comeplayers:screen-stream", {
          detail: { roomId: room.id, stream: media },
        }),
      );

      videoTrack.addEventListener(
        "ended",
        () => {
          if (hostingRef.current) void stopStreaming();
        },
        { once: true },
      );

      await authenticatedFetchJson<{ room: Room }>(
        `/api/messages/rooms/${room.id}/stream`,
        {
          method: "POST",
          body: JSON.stringify({ action: "start", title: streamTitle }),
        },
      );

      hostingRef.current = true;
      setHosting(true);
      await channelRef.current.track({
        userId,
        name: displayName(profile),
        streaming: true,
        onlineAt: new Date().toISOString(),
      });
      await sendSignal("stream-started", { hostId: userId });
      await onRoomRefresh(room.id);
    } catch (startError) {
      closePeers();
      stopMediaTracks();
      hostingRef.current = false;
      setHosting(false);
      setLocalStream(null);
      setRemoteStream(null);
      setRemoteVideoReady(false);
      setWatching(false);
      setStreamError(
        startError instanceof Error
          ? startError.message
          : "Could not start live stream.",
      );
    } finally {
      setBusy(false);
    }
  }

  async function stopStreaming() {
    if (stoppingRef.current) return;
    stoppingRef.current = true;
    setBusy(true);
    setStreamError("");
    try {
      await sendSignal("stream-ended", { hostId: userId }).catch(() => null);
      closePeers();
      stopMediaTracks();
      hostingRef.current = false;
      setHosting(false);
      setLocalStream(null);
      setRemoteStream(null);
      setRemoteVideoReady(false);
      setWatching(false);
      await authenticatedFetchJson<{ room: Room }>(
        `/api/messages/rooms/${room.id}/stream`,
        {
          method: "POST",
          body: JSON.stringify({ action: "stop" }),
        },
      );
      await channelRef.current?.track({
        userId,
        name: displayName(profile),
        streaming: false,
        onlineAt: new Date().toISOString(),
      });
      await onRoomRefresh(room.id);
    } catch (stopError) {
      setStreamError(
        stopError instanceof Error
          ? stopError.message
          : "Could not stop live stream.",
      );
    } finally {
      stoppingRef.current = false;
      setBusy(false);
    }
  }

  async function watchStream() {
    setStreamError("");
    const streamData = await authenticatedFetchJson<{
      stream: PublicChatStreamState;
    }>(`/api/messages/rooms/${room.id}/stream`).catch(() => null);
    const hostId = streamData?.stream.host_id || room.stream_host_id;
    if (!streamData?.stream.is_live && !live) {
      setStreamError("No member is live right now.");
      return;
    }
    if (!hostId) {
      setStreamError("Live host is not available yet.");
      return;
    }
    if (!streamReady || !channelRef.current) {
      setStreamError("Live channel is still connecting.");
      return;
    }
    await requestViewerConnection(hostId);
  }

  function stopWatching() {
    closePeers();
    setRemoteStream(null);
    setRemoteVideoReady(false);
    setWatching(false);
    setStreamError("");
  }

  useEffect(() => {
    if (!live || !room.stream_host_id || watching || !streamReady) return;
    const params = new URLSearchParams(window.location.search);
    if (params.get("room") !== room.id || params.get("live") !== "1") return;

    const timer = window.setTimeout(() => {
      void watchStream();
    }, 500);
    return () => window.clearTimeout(timer);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [live, room.id, room.stream_host_id, streamReady, watching]);

  const showLocalVideo = Boolean(localStream);
  const showRemoteVideo = Boolean(watching || remoteStream);
  const streamDisplayTitle =
    live || hosting
      ? streamTitle || room.stream_title || room.title || "Server Live"
      : room.stream_title || room.title || "Server Live";
  const compactRoster = (room.members || []).slice(0, 4);
  const compactWatchingCount = watcherCount;
  const compactRemainingMembers = Math.max(
    0,
    Number(room.member_count || room.members?.length || 0) -
      compactRoster.length,
  );

  if (stageOnly) {
    const stageVisible = showLocalVideo || showRemoteVideo;
    return (
      <section
        data-live-stage
        data-active={stageVisible}
        className={`${stageVisible ? "block" : "sr-only"} overflow-hidden rounded-2xl border border-cyan-400/25 bg-black shadow-[0_0_38px_rgba(6,182,212,0.12)]`}
      >
        <button
          type="button"
          data-group-live-start
          onClick={() => void startStreaming()}
          disabled={busy || !streamReady || live || hosting}
          className="sr-only"
        >
          Start Live
        </button>
        <button
          type="button"
          data-group-live-stop
          onClick={() => {
            if (hosting || hostIsMe) void stopStreaming();
            else stopWatching();
          }}
          disabled={busy || (!hosting && !hostIsMe && !watching)}
          className="sr-only"
        >
          Stop Live
        </button>
        <button
          type="button"
          data-group-live-watch
          onClick={() => void watchStream()}
          disabled={busy || !streamReady || !live || hosting || hostIsMe}
          className="sr-only"
        >
          Watch Live
        </button>

        {stageVisible ? (
          <div className="relative aspect-video w-full overflow-hidden bg-black">
            {showLocalVideo ? (
              <video
                ref={localVideoRef}
                autoPlay
                muted
                playsInline
                className="h-full w-full bg-black object-contain"
              />
            ) : null}
            {showRemoteVideo ? (
              remoteStream ? (
                <>
                  <video
                    ref={remoteVideoRef}
                    autoPlay
                    playsInline
                    onLoadedData={() => setRemoteVideoReady(true)}
                    onPlaying={() => setRemoteVideoReady(true)}
                    onWaiting={() => setRemoteVideoReady(false)}
                    className="h-full w-full bg-black object-contain"
                  />
                  {!remoteVideoReady ? (
                    <StreamVideoFallback
                      title={streamDisplayTitle}
                      hostName={hostName}
                      text="Stream tersambung. Menunggu frame video pertama dari host..."
                    />
                  ) : null}
                </>
              ) : (
                <StreamVideoFallback
                  title={streamDisplayTitle}
                  hostName={hostName}
                  text={streamState?.fallback_text || "Connecting to live stream..."}
                />
              )
            ) : null}
            <div className="pointer-events-none absolute left-4 top-4 flex items-center gap-2 rounded-full border border-red-400/30 bg-black/65 px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-red-200 backdrop-blur">
              <FaCircle className="text-[7px] text-red-500" />
              {hosting || hostIsMe ? "You are live" : `${hostName} is live`}
            </div>
          </div>
        ) : null}

        {streamError ? (
          <div className="border-t border-red-400/20 bg-red-400/10 px-4 py-3 text-xs text-red-200">
            {streamError}
          </div>
        ) : null}
      </section>
    );
  }

  if (compact) {
    return (
      <div
        data-stream-expanded={showLocalVideo || showRemoteVideo}
        className="rounded-2xl border border-cyan-400/25 bg-[#071827]/82 p-5 shadow-[0_0_34px_rgba(6,182,212,0.12),inset_0_0_32px_rgba(6,182,212,0.04)] backdrop-blur-xl"
      >
        <div className="flex items-center justify-between gap-3 text-[11px] font-black uppercase tracking-[0.12em]">
          <span className="inline-flex items-center gap-2 text-cyan-300">
            <FaBroadcastTower /> Server Live
          </span>
          <span className="text-gray-400">
            {compactWatchingCount} watching
          </span>
          {live || hosting ? (
            <span className="rounded-full bg-red-500 px-2 py-1 text-[10px] text-white">
              LIVE
            </span>
          ) : null}
        </div>

        <h3 className="mt-5 truncate text-2xl font-black text-white">
          {streamDisplayTitle}
        </h3>
        <p className="mt-1 text-sm font-bold text-gray-200">
          {hosting
            ? "You are live now"
            : live
              ? `${hostName} is live`
              : "Squad Session"}
        </p>
        <div className="mt-4 flex flex-wrap gap-3 text-xs text-gray-400">
          <span className="inline-flex items-center gap-2">
            <FaGamepad className="text-gray-500" />{" "}
            {room.party_game || "Server Game"}
          </span>
          <span className="inline-flex items-center gap-2">
            <FaCrosshairs className="text-gray-500" />{" "}
            {room.party_rank || room.party_mode || "Squad Session"}
          </span>
        </div>

        <div className="mt-5 flex items-center justify-between gap-3">
          <div className="flex items-center -space-x-2">
            {compactRoster.length ? (
              compactRoster.map((member) => (
                <ProfileAvatar
                  key={member.user_id}
                  profile={member.profile}
                  size="sm"
                  className="border-2 border-[#071827]"
                />
              ))
            ) : (
              <ProfileAvatar
                profile={room.stream_host || profile}
                size="sm"
                className="border-2 border-[#071827]"
              />
            )}
            {compactRemainingMembers > 0 ? (
              <span className="flex h-9 w-9 items-center justify-center rounded-full border-2 border-[#071827] bg-white/10 text-[10px] font-black text-gray-200">
                +{compactRemainingMembers}
              </span>
            ) : null}
          </div>
        </div>

        <div className="mt-5">
          {hosting || hostIsMe ? (
            <button
              type="button"
              data-group-live-stop
              onClick={() => void stopStreaming()}
              disabled={busy}
              className="flex h-12 w-full items-center justify-center gap-2 rounded-xl border border-red-400/35 bg-red-500/15 text-sm font-black text-red-100 transition hover:bg-red-500 hover:text-white disabled:opacity-50"
            >
              <FaStop /> Stop Live
            </button>
          ) : live ? (
            watching ? (
              <button
                type="button"
                data-group-live-stop
                onClick={stopWatching}
                className="flex h-12 w-full items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/5 text-sm font-black text-white transition hover:bg-white/10"
              >
                <FaStop /> Leave Stream
              </button>
            ) : (
              <a
                data-group-live-watch
                href={liveHref}
                target="_blank"
                rel="noreferrer"
                aria-disabled={busy || !streamReady}
                onClick={(event) => {
                  if (busy || !streamReady) {
                    event.preventDefault();
                    return;
                  }
                  if (
                    event.metaKey ||
                    event.ctrlKey ||
                    event.shiftKey ||
                    event.altKey
                  )
                    return;
                  event.preventDefault();
                  void watchStream();
                }}
                className={`flex h-12 w-full items-center justify-center gap-2 rounded-xl border border-cyan-300/40 bg-cyan-400/15 text-sm font-black text-cyan-100 shadow-[0_0_26px_rgba(6,182,212,0.22)] transition hover:bg-cyan-400 hover:text-black ${
                  busy || !streamReady ? "opacity-50" : ""
                }`}
                title="Watch live. Right-click or Ctrl-click to open in a new tab."
              >
                <FaVideo /> Watch Live
              </a>
            )
          ) : (
            <button
              type="button"
              data-group-live-start
              onClick={() => void startStreaming()}
              disabled={busy || !streamReady}
              className="flex h-12 w-full items-center justify-center gap-2 rounded-xl border border-cyan-300/40 bg-cyan-400/15 text-sm font-black text-cyan-100 shadow-[0_0_26px_rgba(6,182,212,0.22)] transition hover:bg-cyan-400 hover:text-black disabled:opacity-50"
            >
              <FaDesktop /> {busy ? "Starting..." : "Go Live"}
            </button>
          )}
        </div>

        {showLocalVideo || showRemoteVideo ? (
          <div className="mt-4 overflow-hidden rounded-xl border border-white/10 bg-black">
            {showLocalVideo ? (
              <video
                ref={localVideoRef}
                autoPlay
                muted
                playsInline
                controls
                className="aspect-video w-full bg-black object-contain"
              />
            ) : null}
            {showRemoteVideo ? (
              <div className="relative">
                {remoteStream ? (
                  <>
                    <video
                      ref={remoteVideoRef}
                      autoPlay
                      playsInline
                      controls
                      onLoadedData={() => setRemoteVideoReady(true)}
                      onPlaying={() => setRemoteVideoReady(true)}
                      onWaiting={() => setRemoteVideoReady(false)}
                      className="aspect-video w-full bg-black object-contain"
                    />
                    {!remoteVideoReady ? (
                      <StreamVideoFallback
                        title={streamDisplayTitle}
                        hostName={hostName}
                        text="Stream tersambung. Menunggu frame video pertama dari host..."
                      />
                    ) : null}
                  </>
                ) : (
                  <div className="relative flex aspect-video items-center justify-center text-sm text-gray-500">
                    <StreamVideoFallback
                      title={streamDisplayTitle}
                      hostName={hostName}
                      text={
                        streamState?.fallback_text ||
                        "Connecting to live stream..."
                      }
                    />
                  </div>
                )}
              </div>
            ) : null}
          </div>
        ) : null}

        {streamError ? (
          <div className="mt-3 rounded-xl border border-red-400/30 bg-red-400/10 p-3 text-xs text-red-200">
            {streamError}
          </div>
        ) : null}
      </div>
    );
  }

  return (
    <div className="border-b border-white/10 bg-[#050a14] p-4">
      <div className="rounded-2xl border border-cyan-400/20 bg-cyan-400/5 p-4">
        <div className="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
          <div className="min-w-0">
            <div className="flex flex-wrap items-center gap-2 text-xs font-black uppercase tracking-wider text-cyan-300">
              <FaBroadcastTower />
              <span>Server Live</span>
              <span className="rounded-full border border-white/10 px-2 py-1 text-[10px] text-gray-300">
                {onlineCount} online
              </span>
              {live || hosting ? (
                <span className="inline-flex items-center gap-1 rounded-full bg-red-500 px-2 py-1 text-[10px] text-white">
                  <FaCircle className="text-[8px]" /> Live
                </span>
              ) : null}
            </div>
            <h3 className="mt-2 truncate text-lg font-black">
              {live || hosting
                ? streamTitle || room.stream_title || "Live gameplay"
                : "Ready for a live gameplay session"}
            </h3>
            <p className="mt-1 text-sm text-gray-400">
              {hosting
                ? "You are sharing your screen in this server."
                : live
                  ? `${hostName} is streaming in this server.`
                  : "Start a screen share when the server is ready."}
            </p>
          </div>

          <div className="flex flex-wrap items-center gap-2">
            {!live || hostIsMe ? (
              <input
                value={streamTitle}
                onChange={(event) => setStreamTitle(event.target.value)}
                maxLength={80}
                className="h-11 w-full rounded-xl border border-white/10 bg-black px-3 text-sm outline-none placeholder:text-gray-500 focus:border-cyan-400 sm:w-56"
                placeholder="Stream title"
                disabled={busy || (live && !hostIsMe)}
              />
            ) : null}
            {hosting || hostIsMe ? (
              <button
                onClick={() => void stopStreaming()}
                disabled={busy}
                className="inline-flex h-11 items-center gap-2 rounded-xl bg-red-500 px-4 text-sm font-black text-white hover:bg-red-400 disabled:opacity-50"
              >
                <FaStop /> Stop
              </button>
            ) : live ? (
              watching ? (
                <button
                  type="button"
                  data-group-live-stop
                  onClick={stopWatching}
                  className="inline-flex h-11 items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-4 text-sm font-black text-white hover:bg-white/10"
                >
                  <FaStop /> Leave stream
                </button>
              ) : (
                <a
                  data-group-live-watch
                  href={liveHref}
                  target="_blank"
                  rel="noreferrer"
                  aria-disabled={busy || !streamReady}
                  onClick={(event) => {
                    if (busy || !streamReady) {
                      event.preventDefault();
                      return;
                    }
                    if (
                      event.metaKey ||
                      event.ctrlKey ||
                      event.shiftKey ||
                      event.altKey
                    )
                      return;
                    event.preventDefault();
                    void watchStream();
                  }}
                  className={`inline-flex h-11 items-center gap-2 rounded-xl bg-cyan-400 px-4 text-sm font-black text-black hover:bg-cyan-300 ${
                    busy || !streamReady ? "opacity-50" : ""
                  }`}
                  title="Watch live. Right-click or Ctrl-click to open in a new tab."
                >
                  <FaVideo /> Watch
                  <FaExternalLinkAlt className="text-xs" />
                </a>
              )
            ) : (
              <button
                type="button"
                data-group-live-start
                onClick={() => void startStreaming()}
                disabled={busy || !streamReady}
                className="inline-flex h-11 items-center gap-2 rounded-xl bg-cyan-400 px-4 text-sm font-black text-black hover:bg-cyan-300 disabled:opacity-50"
              >
                <FaDesktop /> {busy ? "Starting..." : "Go Live"}
              </button>
            )}
          </div>
        </div>

        {showLocalVideo || showRemoteVideo ? (
          <div
            className={`mt-4 grid gap-3 ${showLocalVideo && showRemoteVideo ? "lg:grid-cols-2" : "grid-cols-1"}`}
          >
            {showLocalVideo ? (
              <div className="overflow-hidden rounded-xl border border-white/10 bg-black">
                <video
                  ref={localVideoRef}
                  autoPlay
                  muted
                  playsInline
                  controls
                  className="aspect-video w-full bg-black object-contain"
                />
              </div>
            ) : null}
            {showRemoteVideo ? (
              <div className="relative overflow-hidden rounded-xl border border-white/10 bg-black">
                {remoteStream ? (
                  <>
                    <video
                      ref={remoteVideoRef}
                      autoPlay
                      playsInline
                      controls
                      onLoadedData={() => setRemoteVideoReady(true)}
                      onPlaying={() => setRemoteVideoReady(true)}
                      onWaiting={() => setRemoteVideoReady(false)}
                      className="aspect-video w-full bg-black object-contain"
                    />
                    {!remoteVideoReady ? (
                      <StreamVideoFallback
                        title={
                          streamTitle || room.stream_title || "Live gameplay"
                        }
                        hostName={hostName}
                        text="Stream tersambung. Menunggu frame video pertama dari host..."
                      />
                    ) : null}
                  </>
                ) : (
                  <div className="relative flex aspect-video items-center justify-center text-sm text-gray-500">
                    <StreamVideoFallback
                      title={
                        streamTitle || room.stream_title || "Live gameplay"
                      }
                      hostName={hostName}
                      text={
                        streamState?.fallback_text ||
                        "Connecting to live stream..."
                      }
                    />
                  </div>
                )}
              </div>
            ) : null}
          </div>
        ) : null}

        {streamError ? (
          <div className="mt-3 rounded-xl border border-red-400/30 bg-red-400/10 p-3 text-sm text-red-200">
            {streamError}
          </div>
        ) : null}
      </div>
    </div>
  );
}

export default function MessagesPage() {
  const router = useRouter();
  const { formatPrice } = useCurrency();
  const [userId, setUserId] = useState("");
  const [profile, setProfile] = useState<Profile | null>(null);
  const [rooms, setRooms] = useState<Room[]>([]);
  const [selectedRoomId, setSelectedRoomId] = useState("");
  const [communityChannelSelection, setCommunityChannelSelection] = useState<{
    roomId: string;
    channel: CommunityChannel;
  } | null>(null);
  const [conversation, setConversation] = useState<ConversationResponse | null>(
    null,
  );
  const [search, setSearch] = useState("");
  const [globalSearch, setGlobalSearch] = useState("");
  const [roomBucket, setRoomBucket] = useState<RoomBucket>("all");
  const [draft, setDraft] = useState("");
  const [replyingTo, setReplyingTo] = useState<Message | null>(null);
  const [editingMessage, setEditingMessage] = useState<Message | null>(null);
  const [typingUsers, setTypingUsers] = useState<
    Record<string, { name: string; at: number }>
  >({});
  const [loading, setLoading] = useState(true);
  const [viewerMode, setViewerMode] = useState<"guest" | "authenticated">(
    "guest",
  );
  const [showAuthModal, setShowAuthModal] = useState(false);
  const [guestServerPreview, setGuestServerPreview] =
    useState<GuestServerPreview | null>(null);
  const [loadingMessages, setLoadingMessages] = useState(false);
  const [sending, setSending] = useState(false);
  const [uploading, setUploading] = useState(false);
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");
  const [showCreateGroup, setShowCreateGroup] = useState(false);
  const [candidateUsers, setCandidateUsers] = useState<Profile[]>([]);
  const [loadingCandidates, setLoadingCandidates] = useState(false);
  const [groupTitle, setGroupTitle] = useState("");
  const [groupDescription, setGroupDescription] = useState("");
  const [selectedMemberIds, setSelectedMemberIds] = useState<string[]>([]);
  const [creatingGroup, setCreatingGroup] = useState(false);
  const [inviteIdentifier, setInviteIdentifier] = useState("");
  const [memberActionBusy, setMemberActionBusy] = useState("");
  const [showSquadFinder, setShowSquadFinder] = useState(false);
  const [matchmakingParties, setMatchmakingParties] = useState<
    MatchmakingParty[]
  >([]);
  const [matchmakingLoading, setMatchmakingLoading] = useState(false);
  const [matchmakingBusy, setMatchmakingBusy] = useState("");
  const [createAsParty, setCreateAsParty] = useState(false);
  const [partyGame, setPartyGame] = useState("");
  const [partyMode, setPartyMode] = useState("Ranked");
  const [partyRank, setPartyRank] = useState("");
  const [partyPlatform, setPartyPlatform] = useState("PC");
  const [partyRegion, setPartyRegion] = useState("SEA");
  const [partySize, setPartySize] = useState(5);
  const [wideMessagesLayout, setWideMessagesLayout] = useState(false);
  const [receivedInvitations, setReceivedInvitations] = useState<
    PartyInvitation[]
  >([]);
  const [sentInvitations, setSentInvitations] = useState<PartyInvitation[]>([]);
  const [invitationsLoading, setInvitationsLoading] = useState(false);
  const [invitationBusy, setInvitationBusy] = useState("");
  const [showNotifications, setShowNotifications] = useState(false);
  const [showPinnedPanel, setShowPinnedPanel] = useState(false);
  const [showMemberPanel, setShowMemberPanel] = useState(true);
  const [rightPanelTab, setRightPanelTab] = useState<RightPanelTab>("members");
  const [serverViewMode, setServerViewMode] = useState<ServerViewMode>("home");
  const [showMoreMenu, setShowMoreMenu] = useState(false);
  const [showInviteComposer, setShowInviteComposer] = useState(false);
  const [profileMenuAnchor, setProfileMenuAnchor] = useState<
    "header" | "sidebar" | null
  >(null);
  const [showPlayMenu, setShowPlayMenu] = useState(false);
  const [arcadeWindowOpen, setArcadeWindowOpen] = useState(false);
  const [arcadeGameId, setArcadeGameId] = useState<ArcadeGameId | null>(null);
  const [arcadeWindowKey, setArcadeWindowKey] = useState(0);
  const [showFriendsMenu, setShowFriendsMenu] = useState(false);
  const [showPrivateMessages, setShowPrivateMessages] = useState(false);
  const [privateUnreadCount, setPrivateUnreadCount] = useState(0);
  const [showCreateMenu, setShowCreateMenu] = useState(false);
  const [showCommunityMenu, setShowCommunityMenu] = useState(false);
  const [showServerInviteModal, setShowServerInviteModal] = useState(false);
  const [serverInviteSearch, setServerInviteSearch] = useState("");
  const [serverInviteExpiry, setServerInviteExpiry] = useState<"30d" | "never">("30d");
  const [serverInviteLinks, setServerInviteLinks] = useState<ServerInviteLink[]>([]);
  const [activeServerInvite, setActiveServerInvite] = useState<ServerInviteLink | null>(null);
  const [serverChannelUrl, setServerChannelUrl] = useState("");
  const [serverInviteBusy, setServerInviteBusy] = useState("");
  const [serverInviteCopied, setServerInviteCopied] = useState<"invite" | "channel" | "">("");
  const [serverInviteSentIds, setServerInviteSentIds] = useState<string[]>([]);
  const [selectedServerBundle, setSelectedServerBundle] =
    useState<CommunityBundle | null>(null);
  const [serverIdentityBusy, setServerIdentityBusy] = useState(false);
  const [serverBioEditing, setServerBioEditing] = useState(false);
  const [serverBioDraft, setServerBioDraft] = useState("");
  const [serverSidebarRevision, setServerSidebarRevision] = useState(0);
  const [communityOverlay, setCommunityOverlay] =
    useState<CommunityOverlay>(null);
  const [announcements, setAnnouncements] = useState<
    CommunityAnnouncement[]
  >([]);
  const [announcementsLoading, setAnnouncementsLoading] = useState(false);
  const [showEmojiPicker, setShowEmojiPicker] = useState(false);
  const [showGiftPicker, setShowGiftPicker] = useState(false);
  const [streamViewerActive, setStreamViewerActive] = useState(false);
  const [streamHostActive, setStreamHostActive] = useState(false);
  const [streamViewerCount, setStreamViewerCount] = useState(0);
  const [voiceShortcutToken, setVoiceShortcutToken] = useState(0);
  const [voiceDockCommand, setVoiceDockCommand] =
    useState<CommunityVoiceCommand | null>(null);
  const [pendingVoiceDockAction, setPendingVoiceDockAction] = useState<
    CommunityVoiceCommand["action"] | null
  >(null);
  const [voiceDockState, setVoiceDockState] = useState(
    EMPTY_VOICE_DOCK_STATE,
  );
  const [showVoicePanel, setShowVoicePanel] = useState(false);
  const [showLiveLobbyPicker, setShowLiveLobbyPicker] = useState(false);
  const [selectedLiveLobbyId, setSelectedLiveLobbyId] = useState("");
  const [autoStartLiveAfterLobbyPick, setAutoStartLiveAfterLobbyPick] =
    useState(false);

  useEffect(() => {
    setStreamViewerCount(0);
  }, [selectedRoomId]);

  const deepLinkServerIdRef = useRef("");
  const deepLinkChannelIdRef = useRef("");
  const initializedQueryRef = useRef(false);
  const fileInputRef = useRef<HTMLInputElement | null>(null);
  const gifInputRef = useRef<HTMLInputElement | null>(null);
  const composerRef = useRef<HTMLTextAreaElement | null>(null);
  const globalSearchRef = useRef<HTMLInputElement | null>(null);
  const inviteInputRef = useRef<HTMLInputElement | null>(null);
  const serverIconInputRef = useRef<HTMLInputElement | null>(null);
  const bottomRef = useRef<HTMLDivElement | null>(null);
  const typingChannelRef = useRef<ReturnType<typeof supabase.channel> | null>(
    null,
  );
  const typingStopTimerRef = useRef<number | null>(null);
  const autoStoppingLiveRoomsRef = useRef<Set<string>>(new Set());

  const selectedRoom = useMemo(
    () =>
      rooms.find((room) => room.id === selectedRoomId) ||
      conversation?.room ||
      null,
    [rooms, selectedRoomId, conversation],
  );
  const selectedIsGroup = isGroupRoom(selectedRoom);
  const selectedCommunityChannel =
    communityChannelSelection?.roomId === selectedRoomId
      ? communityChannelSelection.channel
      : conversation?.room.id === selectedRoomId
        ? conversation.channel || null
        : null;
  const selectedChannelId = selectedIsGroup
    ? String(selectedCommunityChannel?.id || "")
    : "";
  const selectedChannelIsVoice =
    selectedCommunityChannel?.channel_type === "voice";


  useEffect(() => {
    const handleVoiceLobbyLeft = (event: Event) => {
      const detail = (
        event as CustomEvent<{ roomId?: string; channelId?: string }>
      ).detail;
      const roomId = String(detail?.roomId || "");
      if (!roomId) return;
      void forceStopHostedLive(roomId, "Voice Lobby ditinggalkan. Live dihentikan otomatis.");
    };

    window.addEventListener(
      "comeplayers:voice-lobby-left",
      handleVoiceLobbyLeft as EventListener,
    );
    return () => {
      window.removeEventListener(
        "comeplayers:voice-lobby-left",
        handleVoiceLobbyLeft as EventListener,
      );
    };
    // forceStopHostedLive reads the current room/conversation state from this render.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [rooms, conversation, userId]);

  useEffect(() => {
    const room = selectedRoom;
    if (!room || selectedChannelIsVoice || voiceDockState.connected) return;
    const live = String(room.stream_status || "").toLowerCase() === "live";
    const hostIsMe = room.stream_host_id === userId;
    if (!live || !hostIsMe) return;

    const timer = window.setTimeout(() => {
      void forceStopHostedLive(
        room.id,
        "Kamu sudah tidak berada di Voice Lobby. Live dihentikan otomatis.",
      );
    }, 450);
    return () => window.clearTimeout(timer);
    // forceStopHostedLive intentionally reads the latest state through this render.
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [
    selectedRoom?.id,
    selectedRoom?.stream_status,
    selectedRoom?.stream_host_id,
    selectedChannelIsVoice,
    voiceDockState.connected,
    userId,
  ]);
  const serverRooms = useMemo(
    () => rooms.filter((room) => isGroupRoom(room)),
    [rooms],
  );
  const selectedServer = selectedIsGroup
    ? selectedServerBundle?.community || selectedRoom?.server || null
    : null;
  const selectedServerPermissions = new Set(
    selectedServerBundle?.currentUser.permissions || [],
  );
  const canManageServerIdentity = Boolean(
    viewerMode === "authenticated" &&
      selectedServer &&
      (selectedServerBundle?.currentUser.isOwner ||
        selectedServerBundle?.currentUser.isAdmin ||
        selectedServerPermissions.has("*") ||
        selectedServerPermissions.has("manage_channels")),
  );
  const canEditServerBio = Boolean(
    viewerMode === "authenticated" &&
      selectedServer &&
      selectedServerBundle?.currentUser.isOwner,
  );
  const canCreateServerInvite = Boolean(
    viewerMode === "authenticated" &&
      selectedServer &&
      (selectedServerBundle?.currentUser.isOwner ||
        selectedServerBundle?.currentUser.isAdmin ||
        selectedServerPermissions.has("*") ||
        selectedServerPermissions.has("create_invite")),
  );
  useEffect(() => {
    setServerBioEditing(false);
    setServerBioDraft(selectedServer?.description || "");
  }, [selectedRoomId, selectedServer?.description]);

  const {
    onlineUserIds,
    typingUsers: redisTypingUsers,
    redisEnabled,
    signalTyping: signalRedisTyping,
  } = useMessagesRedisRealtime({
    userId,
    roomId: selectedRoomId,
    channelId: selectedChannelId,
  });
  const visibleTypingUsers = useMemo(
    () => ({ ...redisTypingUsers, ...typingUsers }),
    [redisTypingUsers, typingUsers],
  );
  const conversationMembers = useMemo(
    () => conversation?.members || conversation?.room.members || [],
    [conversation],
  );
  const onlineConversationMembers = useMemo(
    () =>
      conversationMembers.filter(
        (member) => redisEnabled && onlineUserIds.has(member.user_id),
      ),
    [conversationMembers, onlineUserIds, redisEnabled],
  );
  const offlineConversationMembers = useMemo(
    () =>
      conversationMembers.filter(
        (member) => !redisEnabled || !onlineUserIds.has(member.user_id),
      ),
    [conversationMembers, onlineUserIds, redisEnabled],
  );
  const memberProfileMap = useMemo(
    () =>
      new Map(
        conversationMembers.map((member) => [
          String(member.user_id),
          member.profile || null,
        ]),
      ),
    [conversationMembers],
  );
  const communityRankings = useMemo(() => {
    const messageCounts = new Map<string, number>();
    for (const message of conversation?.messages || []) {
      const senderId = String(message.sender_id || "");
      if (!senderId) continue;
      messageCounts.set(senderId, (messageCounts.get(senderId) || 0) + 1);
    }
    return conversationMembers
      .map((member) => ({
        member,
        messageCount: messageCounts.get(String(member.user_id)) || 0,
        online: redisEnabled && onlineUserIds.has(member.user_id),
      }))
      .sort((left, right) => {
        if (left.messageCount !== right.messageCount) {
          return right.messageCount - left.messageCount;
        }
        if (left.online !== right.online) return left.online ? -1 : 1;
        return displayName(left.member.profile).localeCompare(
          displayName(right.member.profile),
        );
      });
  }, [conversation?.messages, conversationMembers, onlineUserIds, redisEnabled]);
  const selectedGroupRole = String(
    conversation?.room.role || selectedRoom?.member_role || "",
  ).toLowerCase();
  const canManageSelectedGroupMembers =
    selectedIsGroup && canManageMembers(selectedGroupRole, profile);
  const canAssignSelectedGroupLeaders =
    selectedIsGroup && canAssignGroupLeaders(selectedGroupRole, profile);
  const canInviteToServer = Boolean(
    selectedIsGroup &&
      (canCreateServerInvite || canManageSelectedGroupMembers),
  );
  const activeServerMemberIds = useMemo(
    () => new Set(conversationMembers.map((member) => String(member.user_id))),
    [conversationMembers],
  );
  const filteredServerInviteCandidates = useMemo(() => {
    const query = serverInviteSearch.trim().toLowerCase();
    return candidateUsers
      .filter((candidate) => !activeServerMemberIds.has(String(candidate.id)))
      .filter((candidate) => {
        if (!query) return true;
        return [candidate.username, candidate.full_name]
          .filter(Boolean)
          .some((value) => String(value).toLowerCase().includes(query));
      });
  }, [candidateUsers, activeServerMemberIds, serverInviteSearch]);
  const channelComposerDisabled = Boolean(
    viewerMode === "guest" ||
      (selectedIsGroup &&
        (selectedChannelIsVoice ||
          (selectedCommunityChannel?.is_read_only &&
            !canManageSelectedGroupMembers))),
  );

  useEffect(() => {
    const root = document.documentElement;
    root.classList.add("messages-shell");
    document.body.classList.add("messages-shell");
    return () => {
      root.classList.remove("messages-shell");
      document.body.classList.remove("messages-shell");
    };
  }, []);

  useEffect(() => {
    const media = window.matchMedia("(min-width: 1280px)");
    const syncLayout = () => {
      if (!streamHostActive && !streamViewerActive) {
        setWideMessagesLayout(media.matches);
      }
    };
    syncLayout();
    media.addEventListener("change", syncLayout);
    return () => media.removeEventListener("change", syncLayout);
  }, [streamHostActive, streamViewerActive]);

  useEffect(() => {
    const handlePageShortcut = (event: KeyboardEvent) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        globalSearchRef.current?.focus();
      }
      if (event.key === "Escape") {
        setCommunityOverlay(null);
        setProfileMenuAnchor(null);
        setShowPlayMenu(false);
        setShowFriendsMenu(false);
        setShowPrivateMessages(false);
        setShowCreateMenu(false);
        setShowCommunityMenu(false);
        setShowServerInviteModal(false);
        setShowMoreMenu(false);
        setShowNotifications(false);
        setShowCreateGroup(false);
        setShowPinnedPanel(false);
        setShowEmojiPicker(false);
        setShowGiftPicker(false);
        setShowInviteComposer(false);
        setShowSquadFinder(false);
        setShowVoicePanel(false);
      }
    };
    window.addEventListener("keydown", handlePageShortcut);
    return () => window.removeEventListener("keydown", handlePageShortcut);
  }, []);

  const roomStats = useMemo(() => {
    const unread = rooms.reduce(
      (sum, room) => sum + Number(room.unread_count || 0),
      0,
    );
    const live = rooms.filter(isLiveRoom).length;
    const groups = rooms.filter(isGroupRoom).length;
    const trades = rooms.filter(isTradeRoom).length;
    const direct = rooms.filter(
      (room) => !isGroupRoom(room) && !isTradeRoom(room),
    ).length;
    return { unread, live, groups, trades, direct };
  }, [rooms]);

  const roomBuckets = useMemo(
    () => [
      {
        id: "all" as const,
        label: "Home",
        icon: <FaDesktop />,
        count: rooms.length,
      },
      {
        id: "live" as const,
        label: "Live",
        icon: <FaBroadcastTower />,
        count: roomStats.live,
      },
      {
        id: "group" as const,
        label: "Servers",
        icon: <FaUsers />,
        count: roomStats.groups,
      },
      {
        id: "trade" as const,
        label: "Trade",
        icon: <FaShieldAlt />,
        count: roomStats.trades,
      },
      {
        id: "direct" as const,
        label: "DM",
        icon: <FaLock />,
        count: roomStats.direct,
      },
    ],
    [
      rooms.length,
      roomStats.direct,
      roomStats.groups,
      roomStats.live,
      roomStats.trades,
    ],
  );

  const filteredRooms = useMemo(() => {
    const query = search.trim().toLowerCase();
    return rooms.filter((room) => {
      if (!bucketMatches(room, roomBucket)) return false;
      if (!query) return true;
      return [
        roomTitle(room),
        displayName(room.other),
        room.last_message || "",
        room.product?.title || "",
        room.order?.product_title || "",
        String(room.order_id || ""),
      ].some((value) => value.toLowerCase().includes(query));
    });
  }, [rooms, roomBucket, search]);

  const filteredCandidates = useMemo(() => {
    const query = groupDescription.startsWith("@")
      ? groupDescription.slice(1).trim().toLowerCase()
      : "";
    if (!query) return candidateUsers;
    return candidateUsers.filter((candidate) =>
      displayName(candidate).toLowerCase().includes(query),
    );
  }, [candidateUsers, groupDescription]);

  async function loadRooms(preferredRoomId?: string) {
    const data = await authenticatedFetchJson<{ rooms: Room[] }>(
      "/api/messages/rooms?limit=60",
    );
    setRooms(data.rooms || []);
    const nextId =
      preferredRoomId || selectedRoomId || data.rooms?.[0]?.id || "";
    if (nextId) setSelectedRoomId(nextId);
    return data.rooms || [];
  }

  async function loadConversation(
    roomId: string,
    silent = false,
    channelId = communityChannelSelection?.roomId === roomId
      ? communityChannelSelection.channel.id
      : "",
  ) {
    if (!roomId) return;
    if (!silent) setLoadingMessages(true);
    try {
      const channelQuery = channelId
        ? `&channel=${encodeURIComponent(channelId)}`
        : "";
      const data = await authenticatedFetchJson<ConversationResponse>(
        `/api/messages/rooms/${roomId}?limit=80${channelQuery}`,
      );
      setConversation(data);
      await authenticatedFetchJson(`/api/messages/rooms/${roomId}/read`, {
        method: "POST",
        body: JSON.stringify({
          channelId: data.channel?.id || channelId || undefined,
        }),
      });
      setRooms((current) =>
        current.map((room) =>
          room.id === roomId ? { ...room, unread_count: 0 } : room,
        ),
      );
    } catch (loadError) {
      if (!silent) {
        setError(
          loadError instanceof Error
            ? loadError.message
            : "Failed to load conversation.",
        );
      }
    } finally {
      if (!silent) setLoadingMessages(false);
    }
  }

  function clearLiveStateOptimistically(roomId: string) {
    const clearRoom = (room: Room): Room => ({
      ...room,
      stream_status: "idle",
      stream_host_id: null,
      stream_title: null,
      stream_started_at: null,
      stream_ended_at: new Date().toISOString(),
      stream_updated_at: new Date().toISOString(),
      stream_host: null,
    });

    setRooms((current) =>
      current.map((room) => (room.id === roomId ? clearRoom(room) : room)),
    );
    setConversation((current) =>
      current && current.room.id === roomId
        ? { ...current, room: clearRoom(current.room) }
        : current,
    );
    setStreamHostActive(false);
    setStreamViewerActive(false);
    setStreamViewerCount(0);
  }

  async function forceStopHostedLive(roomId: string, successNotice: string) {
    if (!roomId || autoStoppingLiveRoomsRef.current.has(roomId)) return;

    const room =
      rooms.find((item) => item.id === roomId) ||
      (conversation?.room.id === roomId ? conversation.room : null);
    const live = String(room?.stream_status || "").toLowerCase() === "live";
    const hostIsMe = Boolean(room && room.stream_host_id === userId);

    if (!live || !hostIsMe) {
      if (streamViewerActive) setStreamViewerActive(false);
      return;
    }

    autoStoppingLiveRoomsRef.current.add(roomId);
    clearLiveStateOptimistically(roomId);
    if (typeof window !== "undefined") {
      window.dispatchEvent(
        new CustomEvent("comeplayers:screen-stream", {
          detail: { roomId, stream: null },
        }),
      );
      window.dispatchEvent(
        new CustomEvent("comeplayers:force-stop-live", {
          detail: { roomId },
        }),
      );
    }

    try {
      await authenticatedFetchJson<{ room: Room }>(
        `/api/messages/rooms/${roomId}/stream`,
        {
          method: "POST",
          body: JSON.stringify({ action: "stop" }),
        },
      );
      setNotice(successNotice);
      await refreshSelectedRoom(roomId);
    } catch (stopError) {
      setError(
        stopError instanceof Error
          ? stopError.message
          : "Live tidak dapat dihentikan otomatis.",
      );
      await refreshSelectedRoom(roomId).catch(() => null);
    } finally {
      autoStoppingLiveRoomsRef.current.delete(roomId);
    }
  }

  async function refreshSelectedRoom(roomId: string) {
    const channelId =
      communityChannelSelection?.roomId === roomId
        ? communityChannelSelection.channel.id
        : "";
    await Promise.all([
      loadRooms(roomId),
      loadConversation(roomId, true, channelId),
    ]);
  }

  async function loadGroupCandidates() {
    setLoadingCandidates(true);
    try {
      const data = await authenticatedFetchJson<{ users: Profile[] }>(
        "/api/messages/groups",
      );
      setCandidateUsers(data.users || []);
    } catch (candidateError) {
      setError(
        candidateError instanceof Error
          ? candidateError.message
          : "Could not load users.",
      );
    } finally {
      setLoadingCandidates(false);
    }
  }

  async function loadMatchmaking(silent = false) {
    if (!silent) setMatchmakingLoading(true);
    try {
      const data = await authenticatedFetchJson<{
        parties: MatchmakingParty[];
      }>("/api/messages/matchmaking?limit=12");
      setMatchmakingParties(data.parties || []);
    } catch (matchError) {
      if (!silent) {
        setError(
          matchError instanceof Error
            ? matchError.message
            : "Could not load Squad Finder.",
        );
      }
    } finally {
      if (!silent) setMatchmakingLoading(false);
    }
  }

  async function loadInvitations(silent = false) {
    if (!silent) setInvitationsLoading(true);
    try {
      const data = await authenticatedFetchJson<{
        received: PartyInvitation[];
        sent: PartyInvitation[];
      }>("/api/messages/invitations?limit=60");
      setReceivedInvitations(data.received || []);
      setSentInvitations(data.sent || []);
    } catch (inviteLoadError) {
      if (!silent) {
        setError(
          inviteLoadError instanceof Error
            ? inviteLoadError.message
            : "Could not load invitations.",
        );
      }
    } finally {
      if (!silent) setInvitationsLoading(false);
    }
  }

  async function respondToInvitation(
    invitation: PartyInvitation,
    action: "accept" | "decline",
  ) {
    setInvitationBusy(invitation.id);
    setError("");
    setNotice("");
    try {
      const data = await authenticatedFetchJson<{ roomId: string }>(
        "/api/messages/invitations",
        {
          method: "PATCH",
          body: JSON.stringify({ invitationId: invitation.id, action }),
        },
      );
      setNotice(
        action === "accept"
          ? `Joined ${invitation.room?.title || "the squad"}.`
          : `Declined ${invitation.room?.title || "the invitation"}.`,
      );
      await Promise.all([loadInvitations(true), loadRooms(data.roomId)]);
      if (action === "accept" && data.roomId) {
        setShowNotifications(false);
        setSelectedRoomId(data.roomId);
        await loadConversation(data.roomId);
      }
    } catch (inviteError) {
      setError(
        inviteError instanceof Error
          ? inviteError.message
          : "Could not answer invitation.",
      );
      await loadInvitations(true);
    } finally {
      setInvitationBusy("");
    }
  }

  async function autoInviteRandomPlayers(count: number) {
    if (!selectedRoomId) return;
    setMatchmakingBusy(`auto:${selectedRoomId}`);
    setError("");
    setNotice("");
    try {
      const data = await authenticatedFetchJson<{
        invitations: Array<{ player?: Profile | null }>;
      }>("/api/messages/matchmaking", {
        method: "POST",
        body: JSON.stringify({
          roomId: selectedRoomId,
          action: "auto-invite",
          count,
        }),
      });
      const names = (data.invitations || [])
        .map((invite) => displayName(invite.player))
        .filter(Boolean);
      setNotice(
        names.length
          ? `Pending invitations sent to ${names.join(", ")}.`
          : "Random invitations sent.",
      );
      await loadInvitations(true);
    } catch (matchError) {
      setError(
        matchError instanceof Error
          ? matchError.message
          : "Random matchmaking invite failed.",
      );
    } finally {
      setMatchmakingBusy("");
    }
  }

  async function joinParty(party: MatchmakingParty) {
    if (!party.id) return;
    if (party.joined) {
      setSelectedRoomId(party.id);
      return;
    }
    setMatchmakingBusy(`join:${party.id}`);
    setError("");
    setNotice("");
    try {
      const data = await authenticatedFetchJson<{ roomId: string }>(
        "/api/messages/matchmaking",
        { method: "POST", body: JSON.stringify({ roomId: party.id }) },
      );
      const roomId = String(data.roomId || party.id);
      setNotice(`Joined ${party.title || "the party"}.`);
      await loadRooms(roomId);
      setSelectedRoomId(roomId);
      await loadConversation(roomId);
      await loadMatchmaking(true);
    } catch (joinError) {
      setError(
        joinError instanceof Error
          ? joinError.message
          : "Could not join this party.",
      );
    } finally {
      setMatchmakingBusy("");
    }
  }

  async function updateMemberRole(
    member: RoomMember,
    role: "member" | "moderator",
  ) {
    if (!selectedRoomId || !member.user_id) return;
    const memberName = displayName(member.profile);
    const action =
      role === "moderator" ? "appoint as a leader" : "return to member";
    if (!window.confirm(`${action} ${memberName}?`)) return;

    setMemberActionBusy(`role:${member.user_id}`);
    setError("");
    setNotice("");
    try {
      await authenticatedFetchJson(
        `/api/messages/rooms/${selectedRoomId}/members`,
        {
          method: "PATCH",
          body: JSON.stringify({ userId: member.user_id, role }),
        },
      );
      setNotice(
        role === "moderator"
          ? `${memberName} is now a server leader.`
          : `${memberName} is now a regular member.`,
      );
      await refreshSelectedRoom(selectedRoomId);
    } catch (roleError) {
      setError(
        roleError instanceof Error ? roleError.message : "Role update failed.",
      );
    } finally {
      setMemberActionBusy("");
    }
  }

  async function togglePartyDiscovery(open: boolean) {
    if (!selectedRoomId || !selectedRoom?.party_game) return;
    setMatchmakingBusy(`toggle:${selectedRoomId}`);
    setError("");
    try {
      await authenticatedFetchJson("/api/messages/matchmaking", {
        method: "PATCH",
        body: JSON.stringify({ roomId: selectedRoomId, open }),
      });
      setNotice(
        open
          ? "Party is visible in Squad Finder."
          : "Party removed from Squad Finder.",
      );
      await Promise.all([
        refreshSelectedRoom(selectedRoomId),
        loadMatchmaking(true),
      ]);
    } catch (partyError) {
      setError(
        partyError instanceof Error
          ? partyError.message
          : "Party update failed.",
      );
    } finally {
      setMatchmakingBusy("");
    }
  }

  async function createRoomFromQuery() {
    if (initializedQueryRef.current) return "";
    initializedQueryRef.current = true;
    const params = new URLSearchParams(window.location.search);
    const inviteCode = params.get("invite") || "";
    if (inviteCode) {
      const joined = await authenticatedFetchJson<{ roomId: string }>(
        `/api/messages/invites/${encodeURIComponent(inviteCode)}/join`,
        { method: "POST", body: JSON.stringify({}) },
      );
      window.history.replaceState(
        {},
        "",
        `/messages?room=${encodeURIComponent(joined.roomId)}`,
      );
      setNotice("You joined the server.");
      return joined.roomId;
    }

    const directRoom = params.get("room") || "";
    if (directRoom) return directRoom;

    const sellerId = params.get("seller") || "";
    const productId = Number(params.get("product") || 0);
    const orderId = Number(params.get("order") || 0);
    if (!productId && !orderId) return "";

    const data = await authenticatedFetchJson<{ room: { id: string } }>(
      "/api/messages/rooms",
      {
        method: "POST",
        body: JSON.stringify({
          sellerId: sellerId || undefined,
          productId: productId || undefined,
          orderId: orderId || undefined,
        }),
      },
    );
    return String(data.room?.id || "");
  }

  function toggleMember(userIdToToggle: string) {
    setSelectedMemberIds((current) =>
      current.includes(userIdToToggle)
        ? current.filter((memberId) => memberId !== userIdToToggle)
        : [...current, userIdToToggle],
    );
  }

  async function createGroup() {
    setCreatingGroup(true);
    setError("");
    setNotice("");
    try {
      const data = await authenticatedFetchJson<{
        room: Room;
        invitationCount?: number;
      }>("/api/messages/groups", {
        method: "POST",
        body: JSON.stringify({
          title: groupTitle,
          description: groupDescription.startsWith("@") ? "" : groupDescription,
          memberIds: selectedMemberIds,
          openParty: createAsParty,
          game: createAsParty ? partyGame : undefined,
          mode: createAsParty ? partyMode : undefined,
          rank: createAsParty ? partyRank : undefined,
          platform: createAsParty ? partyPlatform : undefined,
          region: createAsParty ? partyRegion : undefined,
          partySize: createAsParty ? partySize : undefined,
        }),
      });
      const roomId = String(data.room?.id || "");
      setGroupTitle("");
      setGroupDescription("");
      setSelectedMemberIds([]);
      setShowCreateGroup(false);
      setNotice(
        data.invitationCount
          ? `${createAsParty ? "Party" : "Server"} created. ${data.invitationCount} player invitation${data.invitationCount === 1 ? "" : "s"} waiting for acceptance.`
          : createAsParty
            ? "Party published to Squad Finder."
            : "Server created.",
      );
      setCreateAsParty(false);
      setPartyGame("");
      setPartyMode("Ranked");
      setPartyRank("");
      setPartyPlatform("PC");
      setPartyRegion("SEA");
      setPartySize(5);
      void loadMatchmaking();
      if (roomId) {
        await loadRooms(roomId);
        await loadConversation(roomId);
      }
    } catch (groupError) {
      setError(
        groupError instanceof Error
          ? groupError.message
          : "Server could not be created.",
      );
    } finally {
      setCreatingGroup(false);
    }
  }

  async function inviteMember(identifier?: string) {
    const lookup = String(identifier || inviteIdentifier || "").trim();
    if (!selectedRoomId || !lookup) return;

    setMemberActionBusy(`invite:${lookup}`);
    setError("");
    setNotice("");
    try {
      await authenticatedFetchJson(
        `/api/messages/rooms/${selectedRoomId}/members`,
        {
          method: "POST",
          body: JSON.stringify({ identifier: lookup }),
        },
      );
      setInviteIdentifier("");
      setShowInviteComposer(false);
      setNotice("Invitation sent. The player must accept before joining.");
      await loadInvitations(true);
    } catch (inviteError) {
      setError(
        inviteError instanceof Error
          ? inviteError.message
          : "Member invite failed.",
      );
    } finally {
      setMemberActionBusy("");
    }
  }

  async function removeMember(member: RoomMember) {
    if (!selectedRoomId || !member.user_id) return;
    const memberName = displayName(member.profile);
    if (!window.confirm(`Remove ${memberName} from this server?`)) return;

    setMemberActionBusy(`remove:${member.user_id}`);
    setError("");
    setNotice("");
    try {
      await authenticatedFetchJson(
        `/api/messages/rooms/${selectedRoomId}/members`,
        {
          method: "DELETE",
          body: JSON.stringify({ userId: member.user_id }),
        },
      );
      setNotice(`${memberName} was removed from the server.`);
      await refreshSelectedRoom(selectedRoomId);
    } catch (removeError) {
      setError(
        removeError instanceof Error
          ? removeError.message
          : "Member removal failed.",
      );
    } finally {
      setMemberActionBusy("");
    }
  }

  useEffect(() => {
    let active = true;

    async function initialize() {
      try {
        // getSession reads the browser session first. getUser performs a network
        // request and previously kept the whole Messages page blocked forever
        // whenever the auth endpoint was slow or unavailable.
        const { data, error: authError } = await withMessagesTimeout(
          supabase.auth.getSession(),
          MESSAGES_AUTH_BOOT_TIMEOUT_MS,
          "Authentication check took too long.",
        );
        const sessionUser = data.session?.user || null;

        if (authError || !sessionUser) {
          if (!active) return;
          setViewerMode("guest");
          setLoading(false);

          const inviteCode = new URLSearchParams(window.location.search).get(
            "invite",
          );
          if (inviteCode) {
            try {
              const response = await withMessagesTimeout(
                fetch(
                  `/api/messages/invites/${encodeURIComponent(inviteCode)}/join`,
                  { cache: "no-store" },
                ),
                MESSAGES_AUTH_BOOT_TIMEOUT_MS,
                "Server invite preview took too long.",
              );
              const payload = (await response.json().catch(() => ({}))) as {
                server?: GuestServerPreview;
                error?: string;
              };
              if (!response.ok || !payload.server) {
                setError(
                  payload.error || "Server invite could not be previewed.",
                );
              } else if (active) {
                setGuestServerPreview(payload.server);
              }
            } catch (inviteError) {
              if (active) {
                setError(
                  inviteError instanceof Error
                    ? inviteError.message
                    : "Server invite could not be previewed.",
                );
              }
            }
          }
          return;
        }

        if (!active) return;
        setViewerMode("authenticated");
        setUserId(sessionUser.id);

        // Do not block the entire application while profile, room or message
        // APIs are warming up. The shell becomes usable immediately and each
        // request now has its own timeout.
        setLoading(false);

        const { data: profileData } = await withMessagesTimeout(
          supabase
            .from("profiles")
            .select(
              "id,email,username,full_name,avatar_url,role,seller_status",
            )
            .eq("id", sessionUser.id)
            .maybeSingle(),
          MESSAGES_AUTH_BOOT_TIMEOUT_MS,
          "Profile loading took too long.",
        );
        if (!active) return;
        setProfile((profileData || null) as Profile | null);

        const serverRouteMatch = window.location.pathname.match(
          /^\/messages\/servers\/([^/]+)\/channels\/([^/]+)\/?$/i,
        );
        const routeServerId = serverRouteMatch
          ? decodeURIComponent(serverRouteMatch[1] || "")
          : new URLSearchParams(window.location.search).get("server") || "";
        const routeChannelId = serverRouteMatch
          ? decodeURIComponent(serverRouteMatch[2] || "")
          : new URLSearchParams(window.location.search).get("channel") || "";
        deepLinkServerIdRef.current = routeServerId;
        deepLinkChannelIdRef.current = routeChannelId;

        const queryRoomId = await createRoomFromQuery();
        const roomList = await loadRooms(queryRoomId);
        const deepLinkedRoom = routeServerId
          ? roomList.find(
              (room) => String(room.server?.id || "") === routeServerId,
            )
          : null;
        const initialRoomId =
          queryRoomId ||
          deepLinkedRoom?.id ||
          roomList.find((room) => isGroupRoom(room))?.id ||
          roomList[0]?.id ||
          "";
        if (initialRoomId) {
          const initialRoom =
            roomList.find((room) => room.id === initialRoomId) || null;
          setServerViewMode(
            initialRoom && isGroupRoom(initialRoom) && !routeChannelId
              ? "home"
              : "chat",
          );
          setSelectedRoomId(initialRoomId);
          await loadConversation(initialRoomId);
        }
      } catch (initError) {
        if (!active) return;
        setError(
          initError instanceof Error
            ? initError.message
            : "Failed to initialize messages.",
        );
      } finally {
        if (active) setLoading(false);
      }
    }

    void initialize();
    return () => {
      active = false;
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  useEffect(() => {
    const { data } = supabase.auth.onAuthStateChange((event) => {
      // Never hard-reload on SIGNED_IN. Supabase can emit auth events more than
      // once, and reloading from this listener caused a loading/refresh loop.
      if (event === "SIGNED_OUT") {
        setUserId("");
        setProfile(null);
        setRooms([]);
        setConversation(null);
        setViewerMode("guest");
        setLoading(false);
      }
    });
    return () => data.subscription.unsubscribe();
  }, []);

  useEffect(() => {
    if (!profile?.id) return;
    void loadGroupCandidates();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [profile?.id]);

  useEffect(() => {
    if (!profile?.id) return;
    void loadMatchmaking();
    const timer = window.setInterval(() => void loadMatchmaking(true), 30000);
    return () => window.clearInterval(timer);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [profile?.id]);

  useEffect(() => {
    if (!profile?.id) return;
    void loadCommunityAnnouncements();
    // Published announcements are refreshed when the panel is opened again.
  }, [profile?.id]);

  useEffect(() => {
    if (!profile?.id) return;
    void loadInvitations();
    const timer = window.setInterval(() => void loadInvitations(true), 20000);
    return () => window.clearInterval(timer);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [profile?.id]);

  useEffect(() => {
    if (!selectedRoomId || loading) return;
    const channelId =
      communityChannelSelection?.roomId === selectedRoomId
        ? communityChannelSelection.channel.id
        : "";
    // eslint-disable-next-line react-hooks/set-state-in-effect
    void loadConversation(selectedRoomId, false, channelId);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [selectedRoomId, communityChannelSelection?.channel.id]);

  useEffect(() => {
    if (!userId) return;
    const timer = window.setInterval(async () => {
      try {
        await loadRooms(selectedRoomId);
        if (selectedRoomId) {
          const channelId =
            communityChannelSelection?.roomId === selectedRoomId
              ? communityChannelSelection.channel.id
              : "";
          await loadConversation(selectedRoomId, true, channelId);
        }
      } catch {
        // Polling is a quiet fallback for cross-tab updates.
      }
    }, 15000);
    return () => window.clearInterval(timer);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [userId, selectedRoomId, communityChannelSelection?.channel.id]);

  useEffect(() => {
    if (!selectedRoomId || !userId) return;
    const resetTypingTimer = window.setTimeout(() => setTypingUsers({}), 0);
    const activeChannelId =
      communityChannelSelection?.roomId === selectedRoomId
        ? communityChannelSelection.channel.id
        : "";
    const refresh = () => {
      void loadConversation(selectedRoomId, true, activeChannelId);
      void loadRooms(selectedRoomId);
    };
    const channel = supabase
      .channel(`chat-room:${selectedRoomId}`, {
        config: { private: true, broadcast: { self: false } },
      })
      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "chat_messages",
          filter: `room_id=eq.${selectedRoomId}`,
        },
        refresh,
      )
      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "chat_message_reactions",
          filter: `room_id=eq.${selectedRoomId}`,
        },
        () => void loadConversation(selectedRoomId, true),
      )
      .on("broadcast", { event: "typing" }, (event) => {
        const payload = event.payload as {
          userId?: string;
          name?: string;
          active?: boolean;
          channelId?: string;
        };
        if (!payload.userId || payload.userId === userId) return;
        if (String(payload.channelId || "") !== activeChannelId) return;
        setTypingUsers((current) => {
          const next = { ...current };
          if (payload.active) {
            next[payload.userId as string] = {
              name: String(payload.name || "Someone"),
              at: Date.now(),
            };
          } else {
            delete next[payload.userId as string];
          }
          return next;
        });
      })
      .subscribe();
    typingChannelRef.current = channel;

    const staleTimer = window.setInterval(() => {
      setTypingUsers((current) =>
        Object.fromEntries(
          Object.entries(current).filter(
            ([, entry]) => Date.now() - entry.at < 4000,
          ),
        ),
      );
    }, 1200);

    return () => {
      window.clearTimeout(resetTypingTimer);
      window.clearInterval(staleTimer);
      if (typingStopTimerRef.current)
        window.clearTimeout(typingStopTimerRef.current);
      typingChannelRef.current = null;
      void supabase.removeChannel(channel);
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [selectedRoomId, userId, communityChannelSelection?.channel.id]);

  useEffect(() => {
    bottomRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [conversation?.messages.length]);

  function signalTyping(active: boolean) {
    void signalRedisTyping(active);
    const channel = typingChannelRef.current;
    if (!channel || !userId) return;
    void channel.send({
      type: "broadcast",
      event: "typing",
      payload: {
        userId,
        name: displayName(profile),
        active,
        channelId: selectedChannelId,
      },
    });
  }

  function updateDraft(value: string) {
    setDraft(value);
    setError("");
    signalTyping(Boolean(value.trim()));
    if (typingStopTimerRef.current)
      window.clearTimeout(typingStopTimerRef.current);
    typingStopTimerRef.current = window.setTimeout(
      () => signalTyping(false),
      1400,
    );
  }

  async function loadCommunityAnnouncements() {
    setAnnouncementsLoading(true);
    try {
      const now = new Date().toISOString();
      const { data, error: announcementError } = await supabase
        .from("announcements")
        .select(
          "id,title,slug,summary,type,priority,image_url,publish_at,expire_at,created_at",
        )
        .eq("status", "published")
        .or(`publish_at.is.null,publish_at.lte.${now}`)
        .or(`expire_at.is.null,expire_at.gte.${now}`)
        .order("publish_at", { ascending: false, nullsFirst: false })
        .limit(12);
      if (announcementError) throw new Error(announcementError.message);
      setAnnouncements((data || []) as CommunityAnnouncement[]);
    } catch (announcementError) {
      setError(
        announcementError instanceof Error
          ? announcementError.message
          : "Server events could not be loaded.",
      );
    } finally {
      setAnnouncementsLoading(false);
    }
  }

  function submitGlobalSearch() {
    const query = globalSearch.trim();
    if (!query) {
      globalSearchRef.current?.focus();
      return;
    }
    router.push(`/search?q=${encodeURIComponent(query)}`);
  }

  async function handleSellWithUs() {
    const { data, error: profileError } = await supabase
      .from("profiles")
      .select("seller_status")
      .eq("id", userId)
      .maybeSingle();
    if (profileError) {
      setError(profileError.message);
      return;
    }
    if (data?.seller_status === "approved") {
      router.push("/seller");
      return;
    }
    if (data?.seller_status === "pending") {
      setNotice("Your seller application is still under review.");
      return;
    }
    router.push("/seller/apply");
  }

  async function openCommunityOverlay(view: Exclude<CommunityOverlay, null>) {
    setCommunityOverlay(view);
    setShowPlayMenu(false);
    setShowCreateMenu(false);
    setShowCommunityMenu(false);
    setProfileMenuAnchor(null);
    if (view === "discover") {
      await loadMatchmaking();
    }
    if (view === "events" && announcements.length === 0) {
      await loadCommunityAnnouncements();
    }
  }

  async function handleSignOut() {
    await supabase.auth.signOut();
    window.location.reload();
  }

  function requireLogin(message = "Sign in to use this server feature.") {
    if (viewerMode === "authenticated") return true;
    setNotice(message);
    setShowAuthModal(true);
    return false;
  }

  function serverChannelPath(roomId: string, channelId: string) {
    const room = rooms.find((item) => item.id === roomId);
    const serverId = String(room?.server?.id || "");
    if (!serverId || !channelId) return "";
    return `/messages/servers/${encodeURIComponent(serverId)}/channels/${encodeURIComponent(channelId)}`;
  }

  function replaceServerChannelAddress(roomId: string, channelId: string) {
    const path = serverChannelPath(roomId, channelId);
    if (!path || typeof window === "undefined") return;
    if (window.location.pathname !== path) {
      window.history.replaceState({}, "", path);
    }
  }

  function selectServer(roomId: string) {
    setSelectedServerBundle(null);
    setCommunityChannelSelection(null);
    setServerViewMode("home");
    setSelectedRoomId(roomId);
    setShowCommunityMenu(false);
    setCommunityOverlay(null);
    setShowSquadFinder(false);
    deepLinkChannelIdRef.current = "";
  }

  async function copyText(value: string, target: "invite" | "channel") {
    if (!value) return;
    try {
      await navigator.clipboard.writeText(value);
      setServerInviteCopied(target);
      window.setTimeout(() => {
        setServerInviteCopied((current) => (current === target ? "" : current));
      }, 1800);
    } catch {
      window.prompt("Copy this link", value);
    }
  }

  async function ensureServerInvite(
    expiry: "30d" | "never" = serverInviteExpiry,
    forceNew = false,
  ) {
    if (!selectedServer?.id) {
      setError("Server identity is still loading.");
      return null;
    }

    setServerInviteBusy(forceNew ? "regenerate" : "load");
    setError("");
    try {
      const response = await authenticatedFetchJson<ServerInviteResponse>(
        `/api/messages/communities/${selectedServer.id}/invites`,
      );
      const currentChannelPath = serverChannelPath(
        selectedRoomId,
        selectedChannelId || response.server.channelId || "",
      );
      setServerChannelUrl(
        currentChannelPath && typeof window !== "undefined"
          ? `${window.location.origin}${currentChannelPath}`
          : response.server.channelUrl || "",
      );
      let invites = response.invites || [];
      setServerInviteLinks(invites);

      const permanent = expiry === "never";
      let invite = forceNew
        ? null
        : invites.find(
            (item) => item.isActive && item.isPermanent === permanent,
          ) || null;

      if (!invite) {
        const created = await authenticatedFetchJson<{
          invite: ServerInviteLink;
        }>(`/api/messages/communities/${selectedServer.id}/invites`, {
          method: "POST",
          body: JSON.stringify(
            permanent
              ? { permanent: true }
              : { permanent: false, expiresInDays: 30 },
          ),
        });
        invite = created.invite;
        invites = [invite, ...invites];
        setServerInviteLinks(invites);
      }

      setActiveServerInvite(invite);
      return invite;
    } catch (inviteError) {
      setError(
        inviteError instanceof Error
          ? inviteError.message
          : "Server invite could not be created.",
      );
      return null;
    } finally {
      setServerInviteBusy("");
    }
  }

  async function openServerInviteModal() {
    if (!requireLogin("Sign in to invite people to this server.")) return;
    if (!canInviteToServer) {
      setError("Only the Server Creator or a Leader can create invite links.");
      return;
    }
    setShowCommunityMenu(false);
    setServerInviteSearch("");
    setServerInviteSentIds([]);
    setShowServerInviteModal(true);
    if (!candidateUsers.length) void loadGroupCandidates();
    await ensureServerInvite(serverInviteExpiry, false);
  }

  async function changeServerInviteExpiry(value: "30d" | "never") {
    setServerInviteExpiry(value);
    await ensureServerInvite(value, false);
  }

  async function regenerateServerInvite() {
    const invite = await ensureServerInvite(serverInviteExpiry, true);
    if (invite) setNotice("A new random server invite link was created.");
  }

  async function sendServerInvite(candidate: Profile) {
    if (!selectedRoomId || !candidate.id || !canInviteToServer) return;
    setServerInviteBusy(`user:${candidate.id}`);
    setError("");
    try {
      await authenticatedFetchJson(
        `/api/messages/rooms/${selectedRoomId}/members`,
        {
          method: "POST",
          body: JSON.stringify({ userId: candidate.id }),
        },
      );
      setServerInviteSentIds((current) =>
        current.includes(candidate.id) ? current : [...current, candidate.id],
      );
      setNotice(`Invitation sent to ${displayName(candidate)}.`);
    } catch (inviteError) {
      setError(
        inviteError instanceof Error
          ? inviteError.message
          : "Player invitation failed.",
      );
    } finally {
      setServerInviteBusy("");
    }
  }

  async function updateServerIdentity(input: {
    name?: string;
    description?: string | null;
    iconUrl?: string | null;
  }) {
    if (!selectedRoomId || !canManageServerIdentity) return false;
    setServerIdentityBusy(true);
    setError("");
    try {
      const data = await authenticatedFetchJson<{
        community: CommunityBundle["community"];
      }>(`/api/messages/communities/by-room/${selectedRoomId}`, {
        method: "PATCH",
        body: JSON.stringify(input),
      });
      setSelectedServerBundle((current) =>
        current ? { ...current, community: data.community } : current,
      );
      setRooms((current) =>
        current.map((room) =>
          room.id === selectedRoomId
            ? {
                ...room,
                title: data.community.name,
                description: data.community.description || null,
                server: data.community,
              }
            : room,
        ),
      );
      setServerSidebarRevision((current) => current + 1);
      setNotice("Server profile updated.");
      return true;
    } catch (identityError) {
      setError(
        identityError instanceof Error
          ? identityError.message
          : "Server profile could not be updated.",
      );
      return false;
    } finally {
      setServerIdentityBusy(false);
    }
  }

  async function saveServerBio() {
    if (!canEditServerBio) {
      setError("Only the server owner can edit the server bio.");
      return;
    }
    const bio = serverBioDraft.trim();
    if (bio.length > 500) {
      setError("Server bio must be 500 characters or fewer.");
      return;
    }
    const saved = await updateServerIdentity({ description: bio || null });
    if (saved) {
      setServerBioDraft(bio);
      setServerBioEditing(false);
      setNotice(bio ? "Server bio saved." : "Server bio cleared.");
    }
  }

  async function handleServerIconChange(event: ChangeEvent<HTMLInputElement>) {
    const file = event.target.files?.[0];
    event.target.value = "";
    if (!file || !canManageServerIdentity) return;
    try {
      const iconUrl = await fileToServerIcon(file);
      await updateServerIdentity({ iconUrl });
    } catch (iconError) {
      setError(
        iconError instanceof Error
          ? iconError.message
          : "Server icon could not be processed.",
      );
    }
  }

  async function editServerDetails() {
    if (!canManageServerIdentity || !selectedServer) return;
    const name = window.prompt("Server name", selectedServer.name)?.trim();
    if (!name) return;
    await updateServerIdentity({ name });
    setShowCommunityMenu(false);
  }

  function openSquadCreator() {
    setCreateAsParty(true);
    setShowCreateGroup(false);
    setShowSquadFinder(true);
    setNotice(
      "Squad Finder is ready. Create a new squad or choose an available party.",
    );
  }

  function openCommandSquadFinder() {
    setServerViewMode("chat");
    setRightPanelTab("squad");
    setShowMemberPanel(true);
    setShowSquadFinder(true);
  }

  function prepareCommunityPost() {
    setReplyingTo(null);
    setEditingMessage(null);
    setNotice("Composer ready for a new server message.");
    window.requestAnimationFrame(() => composerRef.current?.focus());
  }

  function issueVoiceDockCommand(
    action: CommunityVoiceCommand["action"],
  ) {
    if (
      action !== "leave" &&
      !voiceDockState.connected &&
      !selectedChannelIsVoice
    ) {
      setPendingVoiceDockAction(action);
      setVoiceShortcutToken((current) => current + 1);
      return;
    }
    setVoiceDockCommand((current) => ({
      id: (current?.id || 0) + 1,
      roomId: selectedRoomId,
      action,
    }));
  }

  function openVoiceControls() {
    setShowVoicePanel(true);
    if (!selectedChannelIsVoice && !voiceDockState.connected) {
      setVoiceShortcutToken((current) => current + 1);
    }
  }

  function triggerDockGoLive() {
    const streamIsLive =
      String(selectedRoom?.stream_status || "").toLowerCase() === "live";
    const selector = streamIsLive
      ? selectedRoom?.stream_host_id === userId
        ? "[data-group-live-stop]"
        : streamViewerActive
          ? "[data-group-live-stop]"
          : "[data-group-live-watch]"
      : "[data-group-live-start]";
    const liveAction = document.querySelector<HTMLElement>(selector);
    if (liveAction && !(liveAction as HTMLButtonElement).disabled) {
      liveAction.click();
      return;
    }
    setNotice("The Server Live panel is not ready yet. Wait a moment and try again.");
  }

  function openLiveLobbyPicker() {
    if (!selectedIsGroup || !selectedRoomId) {
      setError("Choose a server before starting a live session.");
      return;
    }
    if (!serverVoiceChannels.length) {
      setError("This server does not have a Voice Lobby yet.");
      return;
    }

    setSelectedLiveLobbyId(
      selectedChannelIsVoice && selectedCommunityChannel
        ? selectedCommunityChannel.id
        : "",
    );
    setShowLiveLobbyPicker(true);
    setShowMoreMenu(false);
  }

  function selectLiveLobbyForStreaming(channel: CommunityChannel) {
    setSelectedLiveLobbyId(channel.id);
    setCommunityChannelSelection({
      roomId: selectedRoomId,
      channel,
    });
    setServerViewMode("chat");
    setShowVoicePanel(true);
    setRightPanelTab("members");
    setShowMemberPanel(true);
    replaceServerChannelAddress(selectedRoomId, channel.id);
    setVoiceDockCommand((current) => ({
      id: (current?.id || 0) + 1,
      roomId: selectedRoomId,
      action: "join",
    }));
    setReplyingTo(null);
    setEditingMessage(null);
    setDraft("");
    setShowLiveLobbyPicker(false);
    setAutoStartLiveAfterLobbyPick(true);
    setNotice(`Preparing live in ${channel.name}...`);
  }

  function handleDockLiveAction() {
    const streamIsLive =
      String(selectedRoom?.stream_status || "").toLowerCase() === "live";
    if (streamIsLive) {
      triggerDockGoLive();
      return;
    }
    openLiveLobbyPicker();
  }

  function beginAutoStartLiveFlow() {
    let attempts = 0;
    const maxAttempts = 12;
    const attemptStart = () => {
      attempts += 1;
      const liveAction = document.querySelector<HTMLElement>(
        "[data-group-live-start]",
      );
      if (liveAction && !(liveAction as HTMLButtonElement).disabled) {
        setAutoStartLiveAfterLobbyPick(false);
        liveAction.click();
        return;
      }
      if (attempts >= maxAttempts) {
        setAutoStartLiveAfterLobbyPick(false);
        setNotice(
          "Voice Lobby is selected. Press Go Live again if the stream has not started.",
        );
        return;
      }
      window.setTimeout(attemptStart, 220);
    };
    window.setTimeout(attemptStart, 220);
  }

  useEffect(() => {
    if (!autoStartLiveAfterLobbyPick || !selectedIsGroup || !selectedChannelIsVoice)
      return;
    beginAutoStartLiveFlow();
  }, [
    autoStartLiveAfterLobbyPick,
    selectedIsGroup,
    selectedChannelIsVoice,
    selectedChannelId,
  ]);

  function beginReply(message: Message) {
    setReplyingTo(message);
    setEditingMessage(null);
  }

  function beginEdit(message: Message) {
    if (message.sender_id !== userId || message.deleted_at) return;
    setEditingMessage(message);
    setReplyingTo(null);
    setDraft(String(message.message || ""));
  }

  function cancelComposerMode() {
    setReplyingTo(null);
    setEditingMessage(null);
    setDraft("");
    signalTyping(false);
  }

  async function deleteMessage(message: Message) {
    if (!selectedRoomId || !window.confirm("Delete this message?")) return;
    setError("");
    try {
      await authenticatedFetchJson(
        `/api/messages/rooms/${selectedRoomId}/messages/${message.id}`,
        { method: "DELETE" },
      );
      if (editingMessage?.id === message.id) cancelComposerMode();
      await Promise.all([
        loadConversation(selectedRoomId, true),
        loadRooms(selectedRoomId),
      ]);
    } catch (deleteError) {
      setError(
        deleteError instanceof Error
          ? deleteError.message
          : "Message could not be deleted.",
      );
    }
  }

  async function toggleReaction(message: Message, emoji: string) {
    if (!selectedRoomId) return;
    try {
      await authenticatedFetchJson(
        `/api/messages/rooms/${selectedRoomId}/messages/${message.id}/reactions`,
        { method: "POST", body: JSON.stringify({ emoji }) },
      );
      await loadConversation(selectedRoomId, true);
    } catch (reactionError) {
      setError(
        reactionError instanceof Error
          ? reactionError.message
          : "Reaction failed.",
      );
    }
  }

  async function sendMessage(attachmentId?: number) {
    if (channelComposerDisabled) return;
    if (!selectedRoomId || (!draft.trim() && !attachmentId)) return;
    setSending(true);
    setError("");
    setNotice("");
    try {
      if (editingMessage) {
        await authenticatedFetchJson(
          `/api/messages/rooms/${selectedRoomId}/messages/${editingMessage.id}`,
          { method: "PATCH", body: JSON.stringify({ message: draft.trim() }) },
        );
        setNotice("Message edited.");
      } else {
        await authenticatedFetchJson(
          `/api/messages/rooms/${selectedRoomId}/messages`,
          {
            method: "POST",
            body: JSON.stringify({
              message: draft.trim(),
              attachmentId,
              replyToId: replyingTo?.id || undefined,
              channelId: selectedChannelId || undefined,
            }),
          },
        );
      }
      setDraft("");
      setReplyingTo(null);
      setEditingMessage(null);
      signalTyping(false);
      await Promise.all([
        loadConversation(selectedRoomId, true),
        loadRooms(selectedRoomId),
      ]);
    } catch (sendError) {
      setError(
        sendError instanceof Error
          ? sendError.message
          : "Message could not be sent.",
      );
    } finally {
      setSending(false);
    }
  }

  async function uploadAttachment(file: File) {
    if (!selectedRoomId) return;
    setUploading(true);
    setError("");
    try {
      const formData = new FormData();
      formData.set("roomId", selectedRoomId);
      formData.set("file", file);
      const uploaded = await authenticatedFetchJson<{
        attachment: { id: number; moderation_status: string };
      }>("/api/messages/attachments", {
        method: "POST",
        body: formData,
      });
      const attachmentId = Number(uploaded.attachment?.id);
      if (
        !attachmentId ||
        uploaded.attachment?.moderation_status !== "approved"
      ) {
        throw new Error("Attachment verification did not finish.");
      }
      await sendMessage(attachmentId);
    } catch (uploadError) {
      setError(
        uploadError instanceof Error
          ? uploadError.message
          : "Attachment upload failed.",
      );
    } finally {
      setUploading(false);
      if (fileInputRef.current) fileInputRef.current.value = "";
      if (gifInputRef.current) gifInputRef.current.value = "";
    }
  }

  async function reportMessage(message: Message) {
    const reason = window.prompt(
      "Report reason: scam, off_platform_payment, external_contact, harassment, spam, suspicious_attachment, or other",
      "scam",
    );
    if (!reason) return;
    const details =
      window.prompt("Optional details for the moderator", "") || "";
    try {
      await authenticatedFetchJson("/api/messages/reports", {
        method: "POST",
        body: JSON.stringify({ messageId: message.id, reason, details }),
      });
      setNotice("Message reported to ComePlayers moderation.");
      await loadConversation(selectedRoomId, true);
    } catch (reportError) {
      setError(
        reportError instanceof Error ? reportError.message : "Report failed.",
      );
    }
  }

  if (loading) {
    return <MessagesChatLoaderV16 />;
  }

  if (String(viewerMode) === "guest") {
    return (
      <ChatMessagesLoginGate
        invitedServerName={guestServerPreview?.name || null}
      />
    );
  }

  const roomLocked =
    String(selectedRoom?.status || "active").toLowerCase() !== "active";
  const streamIsActive = Boolean(
    streamHostActive ||
      streamViewerActive ||
      String(selectedRoom?.stream_status || "").toLowerCase() === "live",
  );
  const serverVoiceChannels = (selectedServerBundle?.channels || []).filter(
    (channel) => channel.channel_type === "voice",
  );
  const todayStart = new Date();
  todayStart.setHours(0, 0, 0, 0);
  const messagesToday = (conversation?.messages || []).filter(
    (message) => new Date(message.created_at).getTime() >= todayStart.getTime(),
  ).length;
  const visibleSquadInviteSlots = Math.min(
    2,
    Math.max(
      0,
      selectedRoom?.party_size
        ? Number(selectedRoom.party_size) - conversationMembers.length
        : 2,
    ),
  );

  return (
    <main
      data-messages-page="true"
      className={`${styles.page} ${styles.messageTypography} relative overflow-hidden bg-[#02060d] text-white`}
    >
      <style>{`
        body.messages-shell > nav:first-of-type,
        body.messages-shell > header:first-of-type,
        body.messages-shell > footer {
          display: none !important;
        }
      `}</style>
      <div className="pointer-events-none fixed inset-0 bg-[#02060d]" />
      <div className="pointer-events-none fixed inset-0 bg-[url('/hero-bg.webp')] bg-cover bg-center opacity-45" />
      <div className="pointer-events-none fixed inset-0 bg-[radial-gradient(circle_at_58%_28%,rgba(6,182,212,0.22),transparent_30%),radial-gradient(circle_at_18%_80%,rgba(250,204,21,0.08),transparent_28%),linear-gradient(180deg,rgba(1,7,18,0.88)_0%,rgba(1,10,24,0.66)_42%,rgba(1,7,14,0.92)_100%)]" />

      <ArcadeWindow
        key={arcadeWindowKey}
        open={arcadeWindowOpen}
        initialGameId={arcadeGameId}
        onClose={() => setArcadeWindowOpen(false)}
      />

      <header
        className={`${styles.topHeader} relative z-20 flex h-[92px] items-center gap-5 px-6 text-white lg:px-10`}
      >
        <div
          className={`${styles.headerBrandLink} flex shrink-0 cursor-default items-center`}
          title="ComePlayers"
          aria-label="ComePlayers"
        >
          <span className={styles.headerLogoCrop}>
            <Image
              src="/logo.png"
              alt="ComePlayers"
              width={320}
              height={110}
              priority
              className={styles.headerLogoImage}
            />
          </span>
        </div>
        <nav className="hidden items-center gap-8 text-base font-bold text-gray-200 xl:flex">
          <div className="relative">
            <button
              type="button"
              onClick={() => {
                setShowPlayMenu((current) => !current);
                setShowFriendsMenu(false);
                setShowPrivateMessages(false);
                setShowCreateMenu(false);
                setShowNotifications(false);
                setProfileMenuAnchor(null);
              }}
              className="inline-flex items-center gap-2 transition hover:text-cyan-300"
              aria-expanded={showPlayMenu}
            >
              Games
              <FaChevronDown
                className={`text-[10px] text-cyan-300 transition ${showPlayMenu ? "rotate-180" : ""}`}
              />
            </button>
            {showPlayMenu ? (
              <div className="absolute left-0 top-9 z-[75] w-[560px] max-w-[calc(100vw-2rem)] rounded-2xl border border-cyan-400/25 bg-[#061421]/98 p-3 text-sm shadow-[0_22px_65px_rgba(0,0,0,0.65)] backdrop-blur-xl">
                <div className="mb-2 flex items-center justify-between border-b border-white/10 px-2 pb-3">
                  <div>
                    <p className="text-[11px] font-black uppercase tracking-[0.18em] text-cyan-300">
                      ComePlayers Arcade
                    </p>
                    <p className="mt-1 text-xs text-slate-500">
                      Play instantly without downloading
                    </p>
                  </div>
                  <button
                    type="button"
                    onClick={() => {
                      setArcadeGameId(null);
                      setArcadeWindowKey((current) => current + 1);
                      setArcadeWindowOpen(true);
                      setShowPlayMenu(false);
                    }}
                    className="inline-flex items-center gap-2 rounded-xl border border-yellow-400/25 bg-yellow-400/10 px-3 py-2 text-xs font-black text-yellow-200 transition hover:bg-yellow-400/20"
                  >
                    View All <FaArrowRight className="text-[9px]" />
                  </button>
                </div>

                <div className="grid max-h-[60vh] grid-cols-1 gap-1 overflow-y-auto pr-1 sm:grid-cols-2">
                  {ARCADE_WINDOW_GAMES.map((game) => (
                    <button
                      key={game.id}
                      type="button"
                      onClick={() => {
                        setArcadeGameId(game.id);
                        setArcadeWindowKey((current) => current + 1);
                        setArcadeWindowOpen(true);
                        setShowPlayMenu(false);
                      }}
                      className="group flex items-center justify-between rounded-xl px-3.5 py-3 text-left text-gray-300 transition hover:bg-cyan-400/10 hover:text-cyan-100"
                    >
                      <span className="min-w-0">
                        <span className="block truncate font-bold">{game.title}</span>
                        <span className="mt-0.5 block truncate text-[10px] font-bold uppercase tracking-wider text-slate-600 transition group-hover:text-cyan-500">
                          {game.category}
                        </span>
                      </span>
                      <FaArrowRight className="ml-3 shrink-0 text-[9px] text-slate-600 transition group-hover:translate-x-0.5 group-hover:text-cyan-300" />
                    </button>
                  ))}
                </div>
              </div>
            ) : null}
          </div>
          <div className="relative">
            <button
              type="button"
              onClick={() => {
                if (!requireLogin("Sign in to use Friends.")) return;
                setShowFriendsMenu((current) => !current);
                setShowPrivateMessages(false);
                setShowPlayMenu(false);
                setShowCreateMenu(false);
                setShowNotifications(false);
                setProfileMenuAnchor(null);
              }}
              className="inline-flex items-center gap-2 transition hover:text-cyan-300"
              aria-expanded={showFriendsMenu}
            >
              Friends
              <FaChevronDown
                className={`text-[10px] text-cyan-300 transition ${showFriendsMenu ? "rotate-180" : ""}`}
              />
            </button>
          </div>
          <button
            type="button"
            onClick={() => {
              if (!requireLogin("Sign in to view server tournaments.")) return;
              void openCommunityOverlay("events");
            }}
            className="transition hover:text-cyan-300"
          >
            Tournaments
          </button>
          <button
            type="button"
            onClick={() => {
              if (!requireLogin("Sign in to view server leaderboards.")) return;
              void openCommunityOverlay("rankings");
            }}
            className="transition hover:text-cyan-300"
          >
            Leaderboards
          </button>
        </nav>
        <form
          onSubmit={(event) => {
            event.preventDefault();
            submitGlobalSearch();
          }}
          className={`${styles.headerSearch} mx-auto hidden h-12 max-w-[520px] flex-1 items-center gap-3 rounded-full border border-cyan-400/30 bg-[#07131f]/82 px-5 text-sm text-gray-400 shadow-[inset_0_0_22px_rgba(6,182,212,0.08),0_0_28px_rgba(6,182,212,0.08)] backdrop-blur-xl md:flex`}
        >
          <FaSearch className="text-cyan-200/80" />
          <input
            ref={globalSearchRef}
            value={globalSearch}
            onChange={(event) => setGlobalSearch(event.target.value)}
            aria-label="Search servers, games, and players"
            placeholder="Search servers, games, players..."
            className="min-w-0 flex-1 bg-transparent outline-none placeholder:text-gray-500"
          />
          <button
            type="submit"
            className="ml-auto rounded-lg border border-white/10 bg-white/5 px-2 py-1 text-[10px] font-black text-gray-400 hover:border-cyan-400/30 hover:text-cyan-200"
            title="Search"
          >
            {"\u2318K"}
          </button>
        </form>
        <div className="relative hidden sm:block">
          <button
            type="button"
            onClick={() => {
              if (!requireLogin("Sign in to create a server or squad.")) return;
              setShowCreateMenu((current) => !current);
              setShowPlayMenu(false);
              setShowFriendsMenu(false);
              setShowPrivateMessages(false);
              setShowNotifications(false);
              setProfileMenuAnchor(null);
            }}
            className="inline-flex h-11 items-center gap-2 rounded-full border border-cyan-400/15 bg-[#07131f]/82 px-5 text-sm font-black shadow-[inset_0_0_18px_rgba(255,255,255,0.03)] transition hover:border-yellow-400/60 hover:text-yellow-300"
            aria-expanded={showCreateMenu}
          >
            <FaPlus className="text-yellow-400" /> Create
          </button>
          {showCreateMenu ? (
            <div className="absolute right-0 top-14 z-[75] w-56 rounded-xl border border-cyan-400/25 bg-[#061421]/98 p-2 text-xs font-bold shadow-[0_22px_65px_rgba(0,0,0,0.65)] backdrop-blur-xl">
              <button
                type="button"
                onClick={() => {
                  setCreateAsParty(false);
                  setShowCreateGroup(true);
                  setShowCreateMenu(false);
                }}
                className="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-gray-300 hover:bg-cyan-400/10 hover:text-cyan-200"
              >
                <FaServer /> Create Server
              </button>
              <button
                type="button"
                onClick={() => {
                  setCreateAsParty(true);
                  setShowCreateGroup(true);
                  setShowCreateMenu(false);
                }}
                className="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-gray-300 hover:bg-yellow-400/10 hover:text-yellow-200"
              >
                <FaCrosshairs /> Publish Squad
              </button>
              <button
                type="button"
                onClick={() => {
                  prepareCommunityPost();
                  setShowCreateMenu(false);
                }}
                disabled={!selectedRoom || selectedChannelIsVoice}
                className="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-gray-300 hover:bg-cyan-400/10 hover:text-cyan-200 disabled:cursor-not-allowed disabled:opacity-40"
              >
                <FaEdit /> New Message
              </button>
              <button
                type="button"
                onClick={() => {
                  setShowCreateMenu(false);
                  void handleSellWithUs();
                }}
                className="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-gray-300 hover:bg-cyan-400/10 hover:text-cyan-200"
              >
                <FaGamepad /> Seller Center
              </button>
            </div>
          ) : null}
        </div>
        <button
          type="button"
          onClick={() => {
            if (!requireLogin("Sign in to view private messages.")) return;
            setShowPrivateMessages((current) => !current);
            setShowFriendsMenu(false);
            setShowNotifications(false);
            setProfileMenuAnchor(null);
            setShowPlayMenu(false);
            setShowCreateMenu(false);
          }}
          className={`relative flex h-11 w-11 items-center justify-center rounded-full border bg-[#07131f]/72 text-cyan-200 shadow-[inset_0_0_16px_rgba(255,255,255,0.03)] ${showPrivateMessages ? "border-cyan-300" : "border-cyan-400/35"}`}
          title="Private message notifications"
          aria-label="Private message notifications"
        >
          <FaComments />
          {privateUnreadCount > 0 ? (
            <span className="absolute -right-1 -top-1 min-w-5 rounded-full bg-red-500 px-1 text-center text-[10px] font-black text-white">
              {privateUnreadCount > 9 ? "9+" : privateUnreadCount}
            </span>
          ) : null}
        </button>
        <button
          type="button"
          onClick={() => {
            if (!requireLogin("Sign in to view notifications.")) return;
            setShowNotifications((current) => !current);
            setShowFriendsMenu(false);
            setShowPrivateMessages(false);
            setProfileMenuAnchor(null);
            setShowPlayMenu(false);
            setShowCreateMenu(false);
          }}
          className={`relative flex h-11 w-11 items-center justify-center rounded-full border bg-[#07131f]/72 text-gray-200 shadow-[inset_0_0_16px_rgba(255,255,255,0.03)] ${showNotifications ? "border-cyan-300 text-cyan-200" : "border-white/10"}`}
          title="Notifications"
        >
          <FaBell />
          {receivedInvitations.length > 0 ? (
            <span className="absolute -right-1 -top-1 min-w-5 rounded-full bg-red-500 px-1 text-center text-[10px] font-black text-white">
              {receivedInvitations.length > 9 ? "9+" : receivedInvitations.length}
            </span>
          ) : null}
        </button>
        {viewerMode === "guest" ? (
          <button
            type="button"
            onClick={() => setShowAuthModal(true)}
            className="h-10 rounded-full border border-cyan-400/35 px-4 text-xs font-black text-cyan-200 hover:bg-cyan-400 hover:text-black"
          >
            Sign In
          </button>
        ) : null}
        <Link
          href="/"
          className={styles.shopButton}
          title="Open ComePlayers Shop"
          aria-label="Open ComePlayers Shop"
        >
          <FaShoppingCart />
          <span>SHOP</span>
        </Link>
      </header>

      <FriendsWorkspace
        userId={userId}
        active={viewerMode === "authenticated"}
        friendMenuOpen={showFriendsMenu}
        privateMessagesOpen={showPrivateMessages}
        onCloseFriendMenu={() => setShowFriendsMenu(false)}
        onClosePrivateMessages={() => setShowPrivateMessages(false)}
        onUnreadChange={setPrivateUnreadCount}
      />

      {showNotifications ? (
        <section
          className={`${styles.notificationPanel} fixed right-6 top-[82px] z-50 w-[min(420px,calc(100vw-32px))] overflow-hidden rounded-2xl border border-cyan-400/35 bg-[#061421]/95 shadow-[0_28px_80px_rgba(0,0,0,0.6),0_0_35px_rgba(6,182,212,0.16)] backdrop-blur-xl`}
        >
          <div className="flex items-center justify-between border-b border-white/10 px-4 py-3">
            <div>
              <p className="text-sm font-black">Notifications & Invitations</p>
              <p className="text-[10px] text-gray-500">
                Players only join after pressing Accept.
              </p>
            </div>
            <button
              type="button"
              onClick={() => setShowNotifications(false)}
              className="rounded-lg p-2 text-gray-400 hover:bg-white/10 hover:text-white"
            >
              <FaTimes />
            </button>
          </div>
          <div className="max-h-[65vh] space-y-3 overflow-y-auto p-4">
            {invitationsLoading ? (
              <p className="rounded-xl border border-white/10 p-4 text-xs text-gray-400">
                Loading invitations...
              </p>
            ) : null}
            {!invitationsLoading && receivedInvitations.length === 0 ? (
              <p className="rounded-xl border border-dashed border-white/10 p-4 text-center text-xs text-gray-500">
                No pending invitations.
              </p>
            ) : null}
            {receivedInvitations.map((invite) => (
              <article
                key={invite.id}
                className="rounded-xl border border-cyan-400/20 bg-cyan-400/[0.05] p-3"
              >
                <div className="flex items-start gap-3">
                  <ProfileAvatar
                    profile={invite.inviter}
                    size="md"
                    fallback={<FaUsers />}
                  />
                  <div className="min-w-0 flex-1">
                    <p className="truncate text-sm font-black">
                      {invite.room?.title || "Squad invitation"}
                    </p>
                    <p className="mt-1 text-xs text-gray-400">
                      <strong className="text-cyan-200">
                        {displayName(invite.inviter)}
                      </strong>{" "}
                      invited you
                      {invite.room?.party_game
                        ? ` to play ${invite.room.party_game}`
                        : ""}
                      .
                    </p>
                    <p className="mt-1 text-[10px] text-gray-600">
                      Expires {formatDate(invite.expires_at)}
                    </p>
                  </div>
                </div>
                <div className="mt-3 grid grid-cols-2 gap-2">
                  <button
                    type="button"
                    onClick={() => void respondToInvitation(invite, "decline")}
                    disabled={invitationBusy === invite.id}
                    className="rounded-lg border border-red-400/25 px-3 py-2 text-xs font-black text-red-300 hover:bg-red-500 hover:text-white disabled:opacity-50"
                  >
                    Decline
                  </button>
                  <button
                    type="button"
                    onClick={() => void respondToInvitation(invite, "accept")}
                    disabled={invitationBusy === invite.id}
                    className="rounded-lg bg-cyan-400 px-3 py-2 text-xs font-black text-black hover:bg-cyan-300 disabled:opacity-50"
                  >
                    {invitationBusy === invite.id ? "Working..." : "Accept"}
                  </button>
                </div>
              </article>
            ))}
            {sentInvitations.length ? (
              <div className="border-t border-white/10 pt-3">
                <p className="mb-2 text-[10px] font-black uppercase tracking-wider text-gray-500">
                  Waiting for acceptance
                </p>
                {sentInvitations.slice(0, 8).map((invite) => (
                  <div
                    key={invite.id}
                    className="mb-2 flex items-center gap-3 rounded-lg bg-black/25 p-2"
                  >
                    <ProfileAvatar profile={invite.invitee} size="sm" />
                    <div className="min-w-0 flex-1">
                      <p className="truncate text-xs font-black">
                        {displayName(invite.invitee)}
                      </p>
                      <p className="truncate text-[10px] text-gray-500">
                        {invite.room?.title || "Squad"} Â· Pending
                      </p>
                    </div>
                    <span className="rounded-full border border-yellow-400/20 px-2 py-1 text-[9px] font-black text-yellow-300">
                      PENDING
                    </span>
                  </div>
                ))}
              </div>
            ) : null}
            <Link
              href="/notifications"
              className="flex items-center justify-center gap-2 rounded-xl border border-cyan-400/25 px-3 py-2.5 text-xs font-black text-cyan-200 hover:bg-cyan-400/10"
            >
              View all notifications <FaArrowRight />
            </Link>
          </div>
        </section>
      ) : null}

      {profileMenuAnchor ? (
        <section
          data-profile-anchor={profileMenuAnchor}
          className={`${styles.profileMenu} fixed z-[70] w-64 overflow-hidden rounded-2xl border border-cyan-400/30 bg-[#061421]/98 p-2 shadow-[0_24px_70px_rgba(0,0,0,0.62)] backdrop-blur-xl ${profileMenuAnchor === "header" ? "right-6 top-[82px]" : "bottom-28 left-7"}`}
          aria-label="Profile menu"
        >
          <div className="flex items-center gap-3 border-b border-white/10 p-3">
            <ProfileAvatar profile={profile} size="md" />
            <div className="min-w-0">
              <p className="truncate text-sm font-black">
                {displayName(profile)}
              </p>
              <p className="truncate text-[10px] text-emerald-300">Online</p>
            </div>
          </div>
          {[
            ["/account", "Account"],
            ["/account/security", "Security"],
            ["/account/connects", "Connects"],
            ["/my-orders", "My Orders"],
          ].map(([href, label]) => (
            <Link
              key={href}
              href={href}
              className="flex items-center justify-between rounded-lg px-3 py-2.5 text-xs font-bold text-gray-300 hover:bg-cyan-400/10 hover:text-cyan-200"
            >
              {label} <FaArrowRight className="text-[9px]" />
            </Link>
          ))}
          <button
            type="button"
            onClick={() => void handleSignOut()}
            className="mt-1 flex w-full items-center gap-3 rounded-lg border-t border-white/10 px-3 py-2.5 text-left text-xs font-black text-red-300 hover:bg-red-400/10"
          >
            <FaSignOutAlt /> Sign Out
          </button>
        </section>
      ) : null}

      {communityOverlay ? (
        <div
          className="fixed inset-0 z-[80] flex items-center justify-center bg-[#01050d]/78 p-5 backdrop-blur-md"
          role="dialog"
          aria-modal="true"
          aria-label={`${communityOverlay} panel`}
          onMouseDown={(event) => {
            if (event.currentTarget === event.target) setCommunityOverlay(null);
          }}
        >
          <section className="flex max-h-[76vh] w-[min(780px,calc(100vw-32px))] flex-col overflow-hidden rounded-2xl border border-cyan-400/35 bg-[#061421]/98 shadow-[0_30px_100px_rgba(0,0,0,0.7),0_0_48px_rgba(6,182,212,0.14)]">
            <div className="flex items-center justify-between border-b border-white/10 px-5 py-4">
              <div>
                <p className="text-lg font-black">
                  {communityOverlay === "discover"
                    ? "Discover Players & Squads"
                    : communityOverlay === "members"
                      ? "Server Members"
                      : communityOverlay === "rankings"
                        ? "Server Rankings"
                        : "Tournaments & Events"}
                </p>
                <p className="text-xs text-gray-500">
                  {communityOverlay === "discover"
                    ? "Live parties from ComePlayers matchmaking."
                    : communityOverlay === "members"
                      ? `${conversationMembers.length} members in this server.`
                      : communityOverlay === "rankings"
                        ? "Ranked by recent channel participation using live room data."
                        : "Published ComePlayers announcements and activities."}
                </p>
              </div>
              <button
                type="button"
                onClick={() => setCommunityOverlay(null)}
                className="flex h-9 w-9 items-center justify-center rounded-xl border border-white/10 text-gray-400 hover:border-cyan-400/30 hover:text-white"
                title="Close"
              >
                <FaTimes />
              </button>
            </div>
            <div className="min-h-0 flex-1 overflow-y-auto p-5">
              {communityOverlay === "discover" ? (
                <div className="grid gap-3 sm:grid-cols-2">
                  {matchmakingLoading ? (
                    <p className="col-span-full rounded-xl border border-white/10 p-5 text-center text-sm text-gray-400">
                      Finding open squads...
                    </p>
                  ) : matchmakingParties.length ? (
                    matchmakingParties.map((party) => {
                      const full =
                        party.member_count >= Number(party.party_size || 5);
                      const busy = matchmakingBusy === `join:${party.id}`;
                      return (
                        <article
                          key={party.id}
                          className="rounded-xl border border-white/10 bg-white/[0.035] p-4"
                        >
                          <div className="flex items-start gap-3">
                            <ProfileAvatar
                              profile={party.leader}
                              size="md"
                              fallback={<FaGamepad />}
                            />
                            <div className="min-w-0 flex-1">
                              <p className="truncate text-sm font-black">
                                {party.title || `${party.party_game} Squad`}
                              </p>
                              <p className="mt-1 text-xs text-gray-500">
                                {party.party_game || "Game not specified"}
                                {party.party_mode ? ` Â· ${party.party_mode}` : ""}
                              </p>
                            </div>
                            <span className="text-xs font-black text-cyan-300">
                              {party.member_count}/{party.party_size || 5}
                            </span>
                          </div>
                          <button
                            type="button"
                            onClick={() => void joinParty(party)}
                            disabled={(full && !party.joined) || busy}
                            className="mt-4 w-full rounded-lg bg-cyan-400 px-3 py-2 text-xs font-black text-black hover:bg-cyan-300 disabled:opacity-40"
                          >
                            {busy
                              ? "Opening..."
                              : party.joined
                                ? "Open Squad"
                                : full
                                  ? "Squad Full"
                                  : "Join Squad"}
                          </button>
                        </article>
                      );
                    })
                  ) : (
                    <p className="col-span-full rounded-xl border border-dashed border-white/10 p-6 text-center text-sm text-gray-500">
                      No open squads are available right now.
                    </p>
                  )}
                </div>
              ) : communityOverlay === "members" ? (
                <div className="grid gap-2 sm:grid-cols-2">
                  {conversationMembers.map((member) => {
                    const role = String(
                      member.member_role || "member",
                    ).toLowerCase();
                    const targetIsOwner =
                      role === "owner" || role === "group_owner";
                    const targetIsModerator =
                      role === "moderator" || role === "group_moderator";
                    const actorIsModerator =
                      selectedGroupRole === "moderator" ||
                      selectedGroupRole === "group_moderator";
                    const canChangeLeader =
                      canAssignSelectedGroupLeaders &&
                      member.user_id !== userId &&
                      !targetIsOwner;
                    const canRemove =
                      canManageSelectedGroupMembers &&
                      member.user_id !== userId &&
                      !targetIsOwner &&
                      !(
                        actorIsModerator &&
                        targetIsModerator &&
                        !isAdminProfile(profile)
                      );
                    const memberBusy = Boolean(memberActionBusy);
                    return (
                      <article
                        key={member.user_id}
                        className="flex items-center gap-3 rounded-xl border border-white/10 bg-white/[0.035] p-3"
                      >
                        <ProfileAvatar profile={member.profile} size="md" />
                        <div className="min-w-0 flex-1">
                          <p className="truncate text-sm font-bold">
                            {displayName(member.profile)}
                          </p>
                          <p className="text-[10px] font-bold text-gray-500">
                            {memberRoleLabel(member.member_role)} Â·{" "}
                            {redisEnabled
                              ? onlineUserIds.has(member.user_id)
                                ? "Online"
                                : "Offline"
                              : "Presence unavailable"}
                          </p>
                        </div>
                        <div className="flex shrink-0 gap-1">
                          {member.profile?.username ? (
                            <button
                              type="button"
                              onClick={() => {
                                setDraft((current) =>
                                  `${current}${current ? " " : ""}@${member.profile?.username} `,
                                );
                                setCommunityOverlay(null);
                                window.requestAnimationFrame(() =>
                                  composerRef.current?.focus(),
                                );
                              }}
                              className="flex h-8 w-8 items-center justify-center rounded-lg border border-cyan-400/25 text-cyan-300 hover:bg-cyan-400 hover:text-black"
                              title={`Mention ${displayName(member.profile)}`}
                            >
                              <FaComments />
                            </button>
                          ) : null}
                          {canChangeLeader ? (
                            <button
                              type="button"
                              onClick={() =>
                                void updateMemberRole(
                                  member,
                                  targetIsModerator ? "member" : "moderator",
                                )
                              }
                              disabled={memberBusy}
                              className="flex h-8 w-8 items-center justify-center rounded-lg border border-yellow-400/25 text-yellow-300 hover:bg-yellow-400 hover:text-black disabled:cursor-wait disabled:opacity-40"
                              title={
                                targetIsModerator
                                  ? "Remove Leader role"
                                  : "Appoint Leader"
                              }
                            >
                              <FaCrown />
                            </button>
                          ) : null}
                          {canRemove ? (
                            <button
                              type="button"
                              onClick={() => void removeMember(member)}
                              disabled={memberBusy}
                              className="flex h-8 w-8 items-center justify-center rounded-lg border border-red-400/25 text-red-300 hover:bg-red-500 hover:text-white disabled:cursor-wait disabled:opacity-40"
                              title={`Remove ${displayName(member.profile)}`}
                            >
                              <FaUserMinus />
                            </button>
                          ) : null}
                        </div>
                      </article>
                    );
                  })}
                </div>
              ) : communityOverlay === "rankings" ? (
                <div className="space-y-2">
                  {communityRankings.length ? (
                    communityRankings.map((entry, index) => (
                      <article
                        key={entry.member.user_id}
                        className="flex items-center gap-4 rounded-xl border border-white/10 bg-white/[0.035] p-3"
                      >
                        <span
                          className={`flex h-10 w-10 shrink-0 items-center justify-center rounded-xl text-sm font-black ${index === 0 ? "bg-yellow-400 text-black" : index === 1 ? "bg-slate-300 text-slate-950" : index === 2 ? "bg-amber-700 text-white" : "bg-white/5 text-gray-400"}`}
                        >
                          {index + 1}
                        </span>
                        <ProfileAvatar
                          profile={entry.member.profile}
                          size="md"
                        />
                        <div className="min-w-0 flex-1">
                          <p className="truncate text-sm font-bold text-white">
                            {displayName(entry.member.profile)}
                          </p>
                          <p className="mt-0.5 text-[10px] text-gray-500">
                            {memberRoleLabel(entry.member.member_role)} Â·{" "}
                            {entry.online
                              ? "Online"
                              : redisEnabled
                                ? "Offline"
                                : "Presence unavailable"}
                          </p>
                        </div>
                        <div className="text-right">
                          <p className="text-lg font-black text-cyan-300">
                            {entry.messageCount}
                          </p>
                          <p className="text-[9px] font-bold uppercase tracking-wide text-gray-500">
                            Recent messages
                          </p>
                        </div>
                      </article>
                    ))
                  ) : (
                    <p className="rounded-xl border border-dashed border-white/10 p-6 text-center text-sm text-gray-500">
                      No server ranking data is available yet.
                    </p>
                  )}
                </div>
              ) : announcementsLoading ? (
                <p className="rounded-xl border border-white/10 p-6 text-center text-sm text-gray-400">
                  Loading published events...
                </p>
              ) : announcements.length ? (
                <div className="grid gap-3 sm:grid-cols-2">
                  {announcements.map((announcement) => (
                    <Link
                      key={announcement.id}
                      href={`/announcements/${announcement.slug}`}
                      className="group flex gap-3 rounded-xl border border-white/10 bg-white/[0.035] p-3 hover:border-cyan-400/35 hover:bg-cyan-400/[0.05]"
                    >
                      {announcement.image_url ? (
                        // eslint-disable-next-line @next/next/no-img-element
                        <img
                          src={announcement.image_url}
                          alt=""
                          className="h-16 w-16 shrink-0 rounded-lg object-cover"
                        />
                      ) : (
                        <span className="flex h-16 w-16 shrink-0 items-center justify-center rounded-lg bg-cyan-400/10 text-cyan-300">
                          <FaCalendarAlt />
                        </span>
                      )}
                      <span className="min-w-0 flex-1">
                        <span className="block truncate text-sm font-black">
                          {announcement.title}
                        </span>
                        <span className="mt-1 line-clamp-2 text-xs text-gray-500">
                          {announcement.summary || "Open announcement details."}
                        </span>
                        <span className="mt-2 block text-[10px] font-black uppercase text-cyan-300">
                          View details
                        </span>
                      </span>
                    </Link>
                  ))}
                </div>
              ) : (
                <p className="rounded-xl border border-dashed border-white/10 p-6 text-center text-sm text-gray-500">
                  There are no published server events right now.
                </p>
              )}
            </div>
            {communityOverlay === "events" ? (
              <div className="border-t border-white/10 p-4 text-right">
                <Link
                  href="/announcements"
                  className="inline-flex items-center gap-2 rounded-xl border border-cyan-400/30 px-4 py-2 text-xs font-black text-cyan-200 hover:bg-cyan-400/10"
                >
                  View all announcements <FaArrowRight />
                </Link>
              </div>
            ) : null}
          </section>
        </div>
      ) : null}

      <section className="relative z-10 min-w-0">
        <section
          className={`${styles.workspace} ${selectedIsGroup && (showMemberPanel || serverViewMode === "home") ? styles.workspaceWithPanel : styles.workspaceNoPanel} box-border grid h-[calc(100vh-92px)] grid-cols-1 gap-4 overflow-hidden px-4 pb-28 lg:grid-cols-[330px_minmax(0,1fr)] lg:px-6`}
        >
          <aside className={`${styles.leftRail} min-h-0`}>
            <nav className={styles.serverRail} aria-label="ComePlayers servers">
              <button
                type="button"
                onClick={() => {
                  setRoomBucket("all");
                  setCommunityOverlay(null);
                  if (selectedIsGroup) setServerViewMode("home");
                }}
                data-active={selectedIsGroup && serverViewMode === "home"}
                className={styles.serverRailButton}
                title="Gaming Command Center"
              >
                <FaHome />
              </button>
              <span className={styles.serverRailDivider} />
              {serverRooms.map((room) => (
                <button
                  key={room.id}
                  type="button"
                  onClick={() => selectServer(room.id)}
                  data-active={room.id === selectedRoomId}
                  className={styles.serverRailButton}
                  title={roomTitle(room)}
                >
                  <ServerAvatar
                    name={roomTitle(room)}
                    iconUrl={room.server?.icon_url}
                    className={styles.serverRailAvatar}
                  />
                  {room.unread_count > 0 ? (
                    <span className={styles.serverRailBadge}>
                      {room.unread_count > 9 ? "9+" : room.unread_count}
                    </span>
                  ) : null}
                </button>
              ))}
              {viewerMode === "guest" && guestServerPreview ? (
                <button
                  type="button"
                  onClick={() => setShowAuthModal(true)}
                  data-active="true"
                  className={styles.serverRailButton}
                  title={guestServerPreview.name}
                >
                  <ServerAvatar
                    name={guestServerPreview.name}
                    iconUrl={guestServerPreview.iconUrl}
                    className={styles.serverRailAvatar}
                  />
                </button>
              ) : null}
              <button
                type="button"
                onClick={() => {
                  if (!requireLogin("Sign in to create a server.")) return;
                  setCreateAsParty(false);
                  setShowCreateGroup(true);
                }}
                className={`${styles.serverRailButton} ${styles.serverRailAdd}`}
                title="Create Server"
              >
                <FaPlus />
              </button>
            </nav>
            <div
              className={`${styles.leftCommunityPanel} flex min-h-0 flex-col overflow-hidden rounded-2xl border border-cyan-400/30 bg-[#061421]/78 shadow-[0_24px_80px_rgba(0,0,0,0.42),inset_0_0_42px_rgba(6,182,212,0.04)] backdrop-blur-xl`}
            >
            <div className="relative border-b border-cyan-400/12 p-4">
              <button
                type="button"
                onClick={() => {
                  if (!requireLogin("Sign in to open server controls.")) return;
                  setShowCommunityMenu((current) => !current);
                }}
                className={`${styles.communityCard} w-full rounded-2xl border border-cyan-400/25 bg-[#082033]/72 p-3 text-left shadow-[inset_0_0_32px_rgba(6,182,212,0.08),0_0_26px_rgba(6,182,212,0.08)]`}
                aria-expanded={showCommunityMenu}
              >
                <div className="flex items-center gap-3">
                  <ServerAvatar
                    name={
                      selectedServer?.name ||
                      guestServerPreview?.name ||
                      "ComePlayers Servers"
                    }
                    iconUrl={
                      selectedServer?.icon_url || guestServerPreview?.iconUrl
                    }
                    className="h-12 w-12 rounded-xl border border-cyan-400/25 shadow-[0_0_22px_rgba(6,182,212,0.12)]"
                  />
                  <div className="min-w-0 flex-1">
                    <div className="flex items-center gap-2">
                      <p className="truncate text-sm font-bold">
                        {selectedIsGroup
                          ? selectedServer?.name || roomTitle(selectedRoom)
                          : guestServerPreview?.name || "ComePlayers Servers"}
                      </p>
                      <FaChevronDown
                        className={`text-[10px] text-cyan-300 transition ${showCommunityMenu ? "rotate-180" : ""}`}
                      />
                    </div>
                    <div className="mt-1 flex items-center justify-between text-[11px] font-bold text-gray-400">
                      <span>
                        {viewerMode === "guest"
                          ? guestServerPreview?.memberCount || 0
                          : conversationMembers.length} members
                      </span>
                      <span>
                        {viewerMode === "guest"
                          ? "Preview"
                          : redisEnabled
                          ? `${onlineUserIds.size} online`
                          : "Presence unavailable"}
                      </span>
                    </div>
                    <div className="mt-2 h-1.5 overflow-hidden rounded-full bg-white/10">
                      <div
                        className="h-full rounded-full bg-yellow-400 transition-[width]"
                        style={{
                          width: `${viewerMode === "guest" ? 28 : conversationMembers.length ? Math.min(100, Math.round((onlineUserIds.size / conversationMembers.length) * 100)) : 0}%`,
                        }}
                      />
                    </div>
                  </div>
                </div>
              </button>

              <input
                ref={serverIconInputRef}
                type="file"
                accept="image/jpeg,image/png,image/webp"
                onChange={(event) => void handleServerIconChange(event)}
                className="sr-only"
              />
              {selectedIsGroup ? (
                <button
                  type="button"
                  onClick={() => void openServerInviteModal()}
                  disabled={!canInviteToServer}
                  className={styles.sidebarInviteButton}
                  title={
                    canInviteToServer
                      ? "Invite people to this server"
                      : "Only the Creator or a Leader can invite people"
                  }
                >
                  <FaUserPlus />
                  <span>Invite People</span>
                </button>
              ) : null}

              {showCommunityMenu ? (
                <div
                  className={`${styles.communityMenu} absolute left-4 right-4 top-[102px] z-40 rounded-xl border border-cyan-400/30 bg-[#061421]/98 p-2 shadow-2xl backdrop-blur-xl`}
                >
                  <button
                    type="button"
                    onClick={() => {
                      setShowCommunityMenu(false);
                      setCreateAsParty(false);
                      setShowCreateGroup(true);
                    }}
                    className="flex w-full items-center gap-3 rounded-lg px-3 py-2 text-xs font-bold text-gray-300 hover:bg-cyan-400/10 hover:text-cyan-200"
                  >
                    <FaPlus /> Create Server
                  </button>
                  {canManageServerIdentity ? (
                    <>
                      <button
                        type="button"
                        onClick={() => void editServerDetails()}
                        disabled={serverIdentityBusy}
                        className="flex w-full items-center gap-3 rounded-lg px-3 py-2 text-xs font-bold text-gray-300 hover:bg-cyan-400/10 hover:text-cyan-200 disabled:opacity-40"
                      >
                        <FaCog /> Rename Server
                      </button>
                      <button
                        type="button"
                        onClick={() => serverIconInputRef.current?.click()}
                        disabled={serverIdentityBusy}
                        className="flex w-full items-center gap-3 rounded-lg px-3 py-2 text-xs font-bold text-gray-300 hover:bg-cyan-400/10 hover:text-cyan-200 disabled:opacity-40"
                      >
                        <FaCamera /> Change Server Icon
                      </button>
                    </>
                  ) : null}
                  {canInviteToServer ? (
                    <button
                      type="button"
                      onClick={() => void openServerInviteModal()}
                      className="flex w-full items-center gap-3 rounded-lg px-3 py-2 text-xs font-bold text-gray-300 hover:bg-cyan-400/10 hover:text-cyan-200"
                    >
                      <FaExternalLinkAlt /> Invite People
                    </button>
                  ) : null}
                  <button
                    type="button"
                    onClick={() => void openCommunityOverlay("members")}
                    className="flex w-full items-center gap-3 rounded-lg px-3 py-2 text-xs font-bold text-gray-300 hover:bg-cyan-400/10 hover:text-cyan-200"
                  >
                    <FaUsers /> Server Members
                  </button>
                  <Link
                    href="/announcements"
                    className="flex items-center gap-3 rounded-lg px-3 py-2 text-xs font-bold text-gray-300 hover:bg-cyan-400/10 hover:text-cyan-200"
                  >
                    <FaCalendarAlt /> Server Announcements
                  </Link>
                </div>
              ) : null}

              <div
                className={`${styles.communityNav} mt-4 space-y-1 text-sm font-bold`}
              >
                <button
                  type="button"
                  onClick={() => {
                    setServerViewMode("home");
                    setRoomBucket("all");
                    setSearch("");
                    setShowNotifications(false);
                    setCommunityOverlay(null);
                    setShowSquadFinder(false);
                  }}
                  className={`flex w-full items-center gap-3 rounded-lg border px-3 py-2.5 transition ${serverViewMode === "home" && communityOverlay === null ? "border-cyan-400/70 bg-cyan-400/15 text-cyan-200 shadow-[0_0_22px_rgba(6,182,212,0.2),inset_0_0_18px_rgba(6,182,212,0.08)]" : "border-transparent text-gray-400 hover:bg-white/5 hover:text-white"}`}
                >
                  <FaHome /> Server Home
                </button>
                <button
                  type="button"
                  onClick={() => {
                    setServerViewMode("chat");
                    setRoomBucket("all");
                    setSearch("");
                    setShowNotifications(false);
                    setCommunityOverlay(null);
                    setShowSquadFinder(false);
                  }}
                  className={`flex w-full items-center gap-3 rounded-lg border px-3 py-2.5 transition ${serverViewMode === "chat" && communityOverlay === null ? "border-cyan-400/70 bg-cyan-400/15 text-cyan-200 shadow-[0_0_22px_rgba(6,182,212,0.2),inset_0_0_18px_rgba(6,182,212,0.08)]" : "border-transparent text-gray-400 hover:bg-white/5 hover:text-white"}`}
                >
                  <FaComments /> Messages
                </button>
              </div>

              <div className={`${styles.leftSearch} mt-4 flex gap-2`}>
                <div className="flex min-w-0 flex-1 items-center gap-2 rounded-xl border border-white/10 bg-black/30 px-3 focus-within:border-cyan-400/50">
                  <FaSearch className="text-xs text-gray-500" />
                  <input
                    value={search}
                    onChange={(event) => setSearch(event.target.value)}
                    placeholder="Search chats or servers"
                    className="h-10 min-w-0 flex-1 bg-transparent text-sm outline-none placeholder:text-gray-600"
                  />
                </div>
                <button
                  onClick={() => setShowCreateGroup((current) => !current)}
                  className="flex h-10 w-10 items-center justify-center rounded-xl border border-cyan-400/35 text-cyan-300 transition hover:bg-cyan-400 hover:text-black"
                  title="Create server or squad"
                >
                  {showCreateGroup ? <FaTimes /> : <FaPlus />}
                </button>
              </div>
            </div>

            {showCreateGroup ? (
              <div
                className={`${styles.createOverlay} max-h-[62vh] overflow-y-auto border-b border-cyan-400/10 bg-black/20 p-4`}
              >
                <div className="mb-3 flex items-center justify-between">
                  <div>
                    <p className="text-sm font-bold text-white">
                      {createAsParty ? "Publish Squad" : "Create Server"}
                    </p>
                    <p className="text-[10px] text-gray-500">
                      Invitations require player acceptance.
                    </p>
                  </div>
                  <button
                    type="button"
                    onClick={() => setShowCreateGroup(false)}
                    className="flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 text-gray-400 hover:border-cyan-400/30 hover:text-white"
                    title="Close creator"
                  >
                    <FaTimes />
                  </button>
                </div>
                <div className="grid grid-cols-2 gap-2 rounded-xl border border-white/10 bg-[#030914] p-1">
                  <button
                    type="button"
                    onClick={() => setCreateAsParty(false)}
                    className={`rounded-lg px-3 py-2 text-xs font-black ${!createAsParty ? "bg-cyan-400 text-black" : "text-gray-400"}`}
                  >
                    <FaLayerGroup className="mr-2 inline" />
                    Server
                  </button>
                  <button
                    type="button"
                    onClick={() => setCreateAsParty(true)}
                    className={`rounded-lg px-3 py-2 text-xs font-black ${createAsParty ? "bg-yellow-400 text-black" : "text-gray-400"}`}
                  >
                    <FaCrosshairs className="mr-2 inline" />
                    Squad Finder
                  </button>
                </div>
                <p className="mt-3 text-xs text-gray-400">
                  All users can create a server. The server creator becomes the
                  Creator and can appoint Leaders.
                </p>
                <input
                  value={groupTitle}
                  onChange={(event) => setGroupTitle(event.target.value)}
                  maxLength={80}
                  placeholder={createAsParty ? "Squad name" : "Server name"}
                  className="mt-3 w-full rounded-xl border border-white/10 bg-black/40 px-3 py-3 text-sm outline-none placeholder:text-gray-600 focus:border-cyan-400"
                />
                <textarea
                  value={groupDescription}
                  onChange={(event) => setGroupDescription(event.target.value)}
                  maxLength={240}
                  rows={2}
                  placeholder="Short description"
                  className="mt-2 w-full resize-none rounded-xl border border-white/10 bg-black/40 px-3 py-3 text-sm outline-none placeholder:text-gray-600 focus:border-cyan-400"
                />
                {createAsParty ? (
                  <div className="mt-3 grid grid-cols-2 gap-2">
                    <input
                      value={partyGame}
                      onChange={(event) => setPartyGame(event.target.value)}
                      placeholder="Game (required)"
                      className="col-span-2 rounded-xl border border-white/10 bg-black/40 px-3 py-2.5 text-sm outline-none placeholder:text-gray-600 focus:border-yellow-400"
                    />
                    <input
                      value={partyMode}
                      onChange={(event) => setPartyMode(event.target.value)}
                      placeholder="Mode"
                      className="rounded-xl border border-white/10 bg-black/40 px-3 py-2.5 text-sm outline-none placeholder:text-gray-600 focus:border-yellow-400"
                    />
                    <input
                      value={partyRank}
                      onChange={(event) => setPartyRank(event.target.value)}
                      placeholder="Rank / tier"
                      className="rounded-xl border border-white/10 bg-black/40 px-3 py-2.5 text-sm outline-none placeholder:text-gray-600 focus:border-yellow-400"
                    />
                    <select
                      value={partyPlatform}
                      onChange={(event) => setPartyPlatform(event.target.value)}
                      className="rounded-xl border border-white/10 bg-[#030914] px-3 py-2.5 text-sm outline-none focus:border-yellow-400"
                    >
                      {[
                        "PC",
                        "PlayStation",
                        "Xbox",
                        "Mobile",
                        "Cross-platform",
                      ].map((value) => (
                        <option key={value}>{value}</option>
                      ))}
                    </select>
                    <select
                      value={partyRegion}
                      onChange={(event) => setPartyRegion(event.target.value)}
                      className="rounded-xl border border-white/10 bg-[#030914] px-3 py-2.5 text-sm outline-none focus:border-yellow-400"
                    >
                      {[
                        "SEA",
                        "Asia",
                        "Oceania",
                        "Europe",
                        "North America",
                        "South America",
                      ].map((value) => (
                        <option key={value}>{value}</option>
                      ))}
                    </select>
                    <label className="col-span-2 flex items-center justify-between rounded-xl border border-white/10 bg-black/40 px-3 py-2 text-xs font-bold text-gray-400">
                      Party size
                      <select
                        value={partySize}
                        onChange={(event) =>
                          setPartySize(Number(event.target.value))
                        }
                        className="rounded-lg border border-white/10 bg-[#030914] px-2 py-1.5 text-white"
                      >
                        {[2, 3, 4, 5, 6, 8, 10].map((value) => (
                          <option key={value} value={value}>
                            {value}
                          </option>
                        ))}
                      </select>
                    </label>
                  </div>
                ) : null}
                <div className="mt-3 max-h-40 overflow-y-auto rounded-xl border border-white/10 bg-[#030914]">
                  {loadingCandidates ? (
                    <div className="p-4 text-sm text-gray-400">
                      Loading users...
                    </div>
                  ) : filteredCandidates.length ? (
                    filteredCandidates.map((candidate) => {
                      const checked = selectedMemberIds.includes(candidate.id);
                      const limitReached =
                        createAsParty &&
                        !checked &&
                        selectedMemberIds.length >= Math.max(1, partySize - 1);
                      return (
                        <button
                          key={candidate.id}
                          type="button"
                          disabled={limitReached}
                          onClick={() => toggleMember(candidate.id)}
                          className={`flex w-full items-center gap-3 border-b border-white/5 p-3 text-left last:border-b-0 hover:bg-white/5 disabled:cursor-not-allowed disabled:opacity-35 ${checked ? "bg-cyan-400/10" : ""}`}
                        >
                          <ProfileAvatar profile={candidate} size="sm" />
                          <span className="min-w-0 flex-1">
                            <span className="block truncate text-sm font-black">
                              {displayName(candidate)}
                            </span>
                            <span className="block truncate text-xs text-gray-500">
                              {candidate.username
                                ? `@${candidate.username}`
                                : "ComePlayers member"}
                            </span>
                          </span>
                          <span
                            className={`h-4 w-4 rounded border ${checked ? "border-cyan-400 bg-cyan-400" : "border-white/30"}`}
                          />
                        </button>
                      );
                    })
                  ) : (
                    <div className="p-4 text-sm text-gray-400">
                      No users available.
                    </div>
                  )}
                </div>
                <button
                  onClick={() => void createGroup()}
                  disabled={
                    creatingGroup ||
                    groupTitle.trim().length < 3 ||
                    (createAsParty && partyGame.trim().length < 2)
                  }
                  className={`mt-3 w-full rounded-xl px-4 py-3 text-sm font-black text-black disabled:opacity-50 ${createAsParty ? "bg-yellow-400 hover:bg-yellow-300" : "bg-cyan-400 hover:bg-cyan-300"}`}
                >
                  {creatingGroup
                    ? "Creating..."
                    : createAsParty
                      ? `Publish Squad (${selectedMemberIds.length + 1}/${partySize})`
                      : `Create Server (${selectedMemberIds.length + 1})`}
                </button>
              </div>
            ) : null}

            <div
              className={`${styles.leftSectionSummary} flex items-center justify-between border-b border-white/10 px-4 py-3`}
            >
              <p className="text-[11px] font-black uppercase tracking-[0.16em] text-gray-500">
                {selectedIsGroup
                  ? "Text Channels"
                  : roomBuckets.find((bucket) => bucket.id === roomBucket)
                      ?.label || "Channels"}
              </p>
              <span className="rounded-full bg-white/10 px-2 py-0.5 text-[10px] font-black text-gray-300">
                {selectedIsGroup
                  ? conversationMembers.length
                  : filteredRooms.length}
              </span>
            </div>
            <div className="min-h-0 flex-1 overflow-y-auto p-2">
              {selectedIsGroup ? (
                <div className="h-full min-h-0">
                  <CommunityChannelSidebar
                    key={`sidebar:${selectedRoomId}`}
                    roomId={selectedRoomId}
                    selectedChannelId={selectedChannelId}
                    preferredChannelId={
                      deepLinkServerIdRef.current &&
                      deepLinkServerIdRef.current === selectedRoom?.server?.id
                        ? deepLinkChannelIdRef.current
                        : ""
                    }
                    activeVoice={{
                      channelId: voiceDockState.channelId,
                      participantCount: voiceDockState.participantCount,
                      connected: voiceDockState.connected,
                    }}
                    onBundleChange={(bundle) => {
                      setSelectedServerBundle(bundle);
                      setRooms((current) =>
                        current.map((room) =>
                          room.id === selectedRoomId
                            ? { ...room, server: bundle.community }
                            : room,
                        ),
                      );
                    }}
                    onSelectChannel={(channel, source) => {
                      setCommunityChannelSelection({
                        roomId: selectedRoomId,
                        channel,
                      });
                      if (source !== "auto") setServerViewMode("chat");
                      replaceServerChannelAddress(selectedRoomId, channel.id);
                      deepLinkServerIdRef.current = "";
                      deepLinkChannelIdRef.current = "";
                      setShowVoicePanel(channel.channel_type === "voice");
                      if (channel.channel_type === "voice") {
                        setRightPanelTab("members");
                        setShowMemberPanel(true);
                      }
                      if (
                        channel.channel_type === "voice" &&
                        pendingVoiceDockAction
                      ) {
                        setVoiceDockCommand((current) => ({
                          id: (current?.id || 0) + 1,
                          roomId: selectedRoomId,
                          action: pendingVoiceDockAction,
                        }));
                        setPendingVoiceDockAction(null);
                      }
                      setReplyingTo(null);
                      setEditingMessage(null);
                      setDraft("");
                    }}
                    onNotice={setNotice}
                    onError={setError}
                    voiceShortcutToken={voiceShortcutToken}
                  />
                  <div
                    className={`${styles.otherChats} border-t border-white/10 pt-3`}
                  >
                    <div className="mb-2 flex items-center justify-between px-1">
                      <p className="text-[10px] font-black uppercase text-gray-500">
                        Other Chats
                      </p>
                      <button
                        type="button"
                        onClick={() => setRoomBucket("all")}
                        className="text-[10px] font-black text-cyan-300 hover:text-cyan-200"
                      >
                        View
                      </button>
                    </div>
                    {filteredRooms
                      .filter((room) => room.id !== selectedRoomId)
                      .slice(0, 4)
                      .map((room) => {
                        const group = isGroupRoom(room);
                        const live =
                          String(room.stream_status || "").toLowerCase() ===
                          "live";
                        return (
                          <button
                            key={room.id}
                            onClick={() => {
                              setCommunityChannelSelection(null);
                              setSelectedRoomId(room.id);
                            }}
                            className="mb-1 flex w-full gap-3 rounded-xl border border-transparent p-2 text-left transition hover:border-white/10 hover:bg-white/5"
                          >
                            <ProfileAvatar
                              profile={group ? null : room.other}
                              size="sm"
                              fallback={group ? <FaUsers /> : roomInitial(room)}
                              className={
                                group
                                  ? "bg-cyan-400/15 text-cyan-200"
                                  : "bg-white/10 text-cyan-300"
                              }
                            />
                            <div className="min-w-0 flex-1">
                              <div className="flex items-center gap-2">
                                <p className="truncate text-xs font-black">
                                  {roomTitle(room)}
                                </p>
                                {room.party_open ? (
                                  <FaCrosshairs className="shrink-0 text-[10px] text-yellow-400" />
                                ) : null}
                              </div>
                              <div className="mt-1 flex items-center gap-2 text-[10px] font-bold text-gray-500">
                                {live ? (
                                  <span className="rounded-full bg-red-500 px-2 py-0.5 text-white">
                                    LIVE
                                  </span>
                                ) : (
                                  <span>
                                    {group
                                      ? `${room.member_count || 0} members`
                                      : "Direct"}
                                  </span>
                                )}
                                {room.unread_count > 0 ? (
                                  <span className="ml-auto rounded-full bg-cyan-400 px-2 py-0.5 text-black">
                                    {room.unread_count}
                                  </span>
                                ) : null}
                              </div>
                            </div>
                          </button>
                        );
                      })}
                  </div>
                </div>
              ) : filteredRooms.length === 0 ? (
                <div className="p-8 text-center text-sm text-gray-400">
                  Create a server, publish a squad, or open a product chat.
                </div>
              ) : (
                filteredRooms.map((room) => {
                  const group = isGroupRoom(room);
                  const live =
                    String(room.stream_status || "").toLowerCase() === "live";
                  return (
                    <button
                      key={room.id}
                      onClick={() => {
                        setCommunityChannelSelection(null);
                        setSelectedRoomId(room.id);
                      }}
                      className={`mb-1 flex w-full gap-3 rounded-xl border p-3 text-left transition ${selectedRoomId === room.id ? "border-cyan-400/45 bg-cyan-400/10" : "border-transparent hover:border-white/10 hover:bg-white/5"}`}
                    >
                      <ProfileAvatar
                        profile={group ? null : room.other}
                        size="md"
                        fallback={group ? <FaUsers /> : roomInitial(room)}
                        className={
                          group
                            ? "bg-cyan-400/15 text-cyan-200"
                            : "bg-white/10 text-cyan-300"
                        }
                      />
                      <div className="min-w-0 flex-1">
                        <div className="flex items-center gap-2">
                          <p className="truncate text-sm font-black">
                            {roomTitle(room)}
                          </p>
                          {room.party_open ? (
                            <FaCrosshairs className="shrink-0 text-xs text-yellow-400" />
                          ) : null}
                          <span className="ml-auto shrink-0 text-[10px] text-gray-600">
                            {formatDate(
                              room.last_message_at || room.created_at,
                            )}
                          </span>
                        </div>
                        <p className="mt-1 truncate text-xs text-gray-500">
                          {room.last_message ||
                            room.description ||
                            "Conversation created"}
                        </p>
                        <div className="mt-2 flex items-center gap-2 text-[10px] font-bold text-gray-400">
                          {group ? (
                            <span>{room.member_count || 0} members</span>
                          ) : null}
                          {live ? (
                            <span className="rounded-full bg-red-500 px-2 py-0.5 text-white">
                              LIVE
                            </span>
                          ) : null}
                          {room.unread_count > 0 ? (
                            <span className="ml-auto rounded-full bg-cyan-400 px-2 py-0.5 text-black">
                              {room.unread_count}
                            </span>
                          ) : null}
                        </div>
                      </div>
                    </button>
                  );
                })
              )}
            </div>
            </div>
            <div
              className={`${styles.leftProfileCard} border-t border-white/10 p-3`}
            >
              <button
                type="button"
                onClick={() =>
                  setProfileMenuAnchor((current) =>
                    current === "sidebar" ? null : "sidebar",
                  )
                }
                className="flex w-full items-center gap-3 rounded-xl bg-black/20 p-2 text-left hover:bg-white/[0.06]"
                title="Open account menu"
              >
                <ProfileAvatar profile={profile} size="sm" />
                <div className="min-w-0 flex-1">
                  <p className="truncate text-xs font-black">
                    {displayName(profile)}
                  </p>
                  <p className="text-[10px] text-emerald-300">â— Online</p>
                </div>
                <FaCog className="text-gray-500" />
              </button>
            </div>
          </aside>

          <section
            className={`${styles.contentGrid} flex min-h-0 flex-col overflow-hidden rounded-2xl border border-cyan-400/30 bg-[#061421]/76 shadow-[0_24px_80px_rgba(0,0,0,0.42),inset_0_0_42px_rgba(6,182,212,0.04)] backdrop-blur-xl`}
          >
            {!selectedRoom ? (
              <div className="flex flex-1 items-center justify-center p-10 text-center">
                <div>
                  <FaLock className="mx-auto text-4xl text-cyan-300" />
                  <h2 className="mt-4 text-3xl font-black">
                    Select a conversation
                  </h2>
                </div>
              </div>
            ) : selectedIsGroup && serverViewMode === "home" ? (
              <div className={styles.commandCenter}>
                <section className={styles.commandHero}>
                  <div className={styles.commandHeroBackdrop} />
                  <div className={styles.commandHeroContent}>
                    <div className="flex min-w-0 items-center gap-4">
                      <ServerAvatar
                        name={selectedServer?.name || roomTitle(selectedRoom)}
                        iconUrl={selectedServer?.icon_url}
                        className={styles.commandServerAvatar}
                      />
                      <div className="min-w-0">
                        <p className={styles.commandEyebrow}>Gaming Command Center</p>
                        <h1 className="truncate text-2xl font-black text-white lg:text-3xl">
                          Welcome to {selectedServer?.name || roomTitle(selectedRoom)}
                        </h1>
                        <p className="mt-1 line-clamp-2 max-w-2xl text-sm text-slate-300">
                          {selectedServer?.description || selectedRoom.description ||
                            "Plan sessions, find a squad, join voice, watch live gameplay, and keep up with your server."}
                        </p>
                      </div>
                    </div>
                    <div className="flex shrink-0 flex-wrap gap-2">
                      <button
                        type="button"
                        onClick={() => setServerViewMode("chat")}
                        className={styles.commandPrimaryButton}
                      >
                        <FaComments /> Open Messages
                      </button>
                      <button
                        type="button"
                        onClick={() => void openServerInviteModal()}
                        disabled={!canInviteToServer}
                        className={styles.commandSecondaryButton}
                      >
                        <FaUserPlus /> Invite People
                      </button>
                    </div>
                  </div>
                  <div className={styles.commandStats}>
                    <div><strong>{conversationMembers.length}</strong><span>Members</span></div>
                    <div><strong>{redisEnabled ? onlineConversationMembers.length : 0}</strong><span>Online</span></div>
                    <div><strong>{serverVoiceChannels.length}</strong><span>Voice Rooms</span></div>
                    <div><strong>{messagesToday}</strong><span>Messages Today</span></div>
                  </div>
                </section>

                <div className={styles.commandGrid}>
                  <section className={`${styles.commandCard} ${styles.commandBioCard}`}>
                    <div className={styles.commandCardHeader}>
                      <div><p>Server Bio</p><span>Owner notes for this server</span></div>
                      <div className={styles.commandBioActions}>
                        {canEditServerBio ? (
                          serverBioEditing ? (
                            <>
                              <button
                                type="button"
                                onClick={() => void saveServerBio()}
                                disabled={serverIdentityBusy}
                                className={styles.commandBioSaveButton}
                              >
                                <FaCheck /> Save
                              </button>
                              <button
                                type="button"
                                onClick={() => {
                                  setServerBioDraft(selectedServer?.description || "");
                                  setServerBioEditing(false);
                                }}
                                disabled={serverIdentityBusy}
                                className={styles.commandBioCancelButton}
                              >
                                <FaTimes /> Cancel
                              </button>
                            </>
                          ) : (
                            <button
                              type="button"
                              onClick={() => {
                                setServerBioDraft(selectedServer?.description || "");
                                setServerBioEditing(true);
                              }}
                              className={styles.commandBioEditButton}
                            >
                              <FaEdit /> Edit Bio
                            </button>
                          )
                        ) : (
                          <span className={styles.commandBioOwnerOnly}>
                            <FaLock /> Owner only
                          </span>
                        )}
                      </div>
                    </div>
                    <div className={styles.commandBioBody}>
                      {serverBioEditing && canEditServerBio ? (
                        <>
                          <textarea
                            value={serverBioDraft}
                            onChange={(event) => setServerBioDraft(event.target.value)}
                            maxLength={500}
                            rows={5}
                            autoFocus
                            placeholder="Write a note or description for this server..."
                            className={styles.commandBioEditor}
                          />
                          <div className={styles.commandBioCounter}>
                            <span>Visible to all server members</span>
                            <strong>{serverBioDraft.length}/500</strong>
                          </div>
                        </>
                      ) : (
                        <p className={styles.commandBioText}>
                          {selectedServer?.description || selectedRoom.description ||
                            "The server owner has not written a bio yet."}
                        </p>
                      )}
                    </div>
                  </section>

                  <section className={`${styles.commandCard} ${styles.commandCardWide}`}>
                    <div className={styles.commandCardHeader}>
                      <div><p>Upcoming Events</p><span>What is happening in the community</span></div>
                      <button type="button" onClick={() => void openCommunityOverlay("events")}>View all</button>
                    </div>
                    <div className={styles.commandEventGrid}>
                      {announcements.slice(0, 3).map((announcement) => (
                        <Link key={announcement.id} href={`/announcements/${announcement.slug}`} className={styles.commandEvent}>
                          {announcement.image_url ? (
                            // eslint-disable-next-line @next/next/no-img-element
                            <img src={announcement.image_url} alt="" />
                          ) : <span><FaCalendarAlt /></span>}
                          <div className="min-w-0">
                            <strong className="block truncate">{announcement.title}</strong>
                            <small className="line-clamp-2">{announcement.summary || "Open event details."}</small>
                          </div>
                        </Link>
                      ))}
                      {!announcements.length ? <p className={styles.commandEmpty}>No published server events right now.</p> : null}
                    </div>
                  </section>

                </div>

                <section className={`${styles.commandCard} ${styles.commandSquadCard} ${styles.commandSquadSidebar}`}>
                  <div className={styles.commandSquadHero}>
                    <div className={styles.commandSquadHeading}>
                      <span className={styles.commandSquadEyebrow}>
                        <FaCrosshairs /> Squad Discovery
                      </span>
                      <h2>Find <span>Squad</span></h2>
                      <p>Team up. Queue faster. Play together.</p>
                    </div>
                  </div>
                  <div className={styles.commandSquadActions}>
                    <button
                      type="button"
                      onClick={openCommandSquadFinder}
                      className={styles.commandMatchmakingButton}
                    >
                      <span className={styles.commandSquadActionIcon}><FaCrosshairs /></span>
                      <span className={styles.commandSquadActionCopy}>
                        <strong>Matchmaking</strong>
                        <small>Instant team matching</small>
                      </span>
                      <FaArrowRight className={styles.commandSquadActionArrow} />
                    </button>
                    <button
                      type="button"
                      onClick={openCommandSquadFinder}
                      className={styles.commandMatchmakingButton}
                    >
                      <span className={styles.commandSquadActionIcon}><FaSearch /></span>
                      <span className={styles.commandSquadActionCopy}>
                        <strong>Find Squad</strong>
                        <small>Browse open teams</small>
                      </span>
                      <FaArrowRight className={styles.commandSquadActionArrow} />
                    </button>
                  </div>

                  <div className={styles.commandSquadListHeading}>
                    <div>
                      <span>Available now</span>
                      <p>Open Squads</p>
                    </div>
                    <span className={styles.commandSquadListCount}>{matchmakingParties.length}</span>
                  </div>
                  <div className={styles.commandSquadList}>
                    {matchmakingLoading ? (
                      <p className={styles.commandEmpty}>Finding open squads...</p>
                    ) : matchmakingParties.length ? (
                      matchmakingParties.slice(0, 5).map((party) => {
                        const full =
                          party.member_count >= Number(party.party_size || 5);
                        const busy = matchmakingBusy === `join:${party.id}`;
                        return (
                          <div key={party.id} className={styles.commandSquadRow}>
                            <ProfileAvatar
                              profile={party.leader || null}
                              size="sm"
                              fallback={<FaGamepad />}
                            />
                            <div className="min-w-0 flex-1">
                              <strong className="block truncate">
                                {party.title || `${party.party_game || "Game"} Squad`}
                              </strong>
                              <small className="block truncate">
                                {party.member_count}/{party.party_size || 5} players
                                {party.party_mode ? ` Â· ${party.party_mode}` : ""}
                              </small>
                            </div>
                            <button
                              type="button"
                              onClick={() => void joinParty(party)}
                              disabled={(full && !party.joined) || busy}
                              className={styles.commandSquadJoinButton}
                            >
                              {busy
                                ? "..."
                                : party.joined
                                  ? "Open"
                                  : full
                                    ? "Full"
                                    : "Join"}
                            </button>
                          </div>
                        );
                      })
                    ) : (
                      <p className={styles.commandEmpty}>No open squads are available.</p>
                    )}
                  </div>
                </section>
              </div>
            ) : (
              <>
                <div
                  className={`${styles.channelHeader} border-b border-cyan-400/15 bg-[#0a1d31]/76 px-5 py-4 shadow-[inset_0_0_26px_rgba(6,182,212,0.04)]`}
                >
                  <div className="flex flex-col justify-between gap-4 md:flex-row md:items-center">
                    <div className="flex min-w-0 items-center gap-3">
                      <span className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[0.06] text-xl font-black text-gray-300">
                        {selectedIsGroup ? (
                          "#"
                        ) : (
                          <ProfileAvatar
                            profile={selectedRoom.other}
                            size="sm"
                          />
                        )}
                      </span>
                      <div className="min-w-0">
                        <h2 className="truncate text-lg font-black">
                          {selectedIsGroup && selectedCommunityChannel
                            ? selectedCommunityChannel.name
                            : roomTitle(selectedRoom)}
                        </h2>
                        <p className="truncate text-xs text-gray-400">
                          {selectedIsGroup
                            ? selectedCommunityChannel?.topic ||
                              selectedRoom.description ||
                              "General discussion for all server members."
                            : selectedRoom.order_id
                              ? `Protected order chat Â· Order #${selectedRoom.order_id}`
                              : "Protected pre-sale product chat"}
                        </p>
                      </div>
                    </div>
                    <div
                      className={`${styles.channelHeaderMeta} flex flex-wrap items-center gap-2`}
                    >
                      {selectedIsGroup ? (
                        <span className="inline-flex items-center gap-2 border-r border-white/10 px-1 pr-5 text-xs font-medium text-gray-300">
                          <FaCircle className="text-[8px] text-emerald-400" />
                          {redisEnabled
                            ? `${onlineUserIds.size} members online`
                            : `${conversationMembers.length} members`}
                        </span>
                      ) : null}
                      {selectedRoom.party_game ? (
                        <span className="rounded-full border border-yellow-400/20 bg-yellow-400/5 px-3 py-2 text-xs font-black text-yellow-300">
                          <FaGamepad className="mr-2 inline" />
                          {selectedRoom.party_game}
                        </span>
                      ) : null}
                      {String(
                        selectedRoom.stream_status || "",
                      ).toLowerCase() === "live" ? (
                        <span className="inline-flex items-center gap-2 rounded-full bg-red-500 px-3 py-2 text-xs font-black text-white">
                          <FaCircle className="text-[7px]" />
                          LIVE
                        </span>
                      ) : null}
                      {selectedRoom.order_id ? (
                        <Link
                          href={`/orders/${selectedRoom.order_id}`}
                          className="rounded-full border border-yellow-400/40 px-3 py-2 text-xs font-black text-yellow-300 hover:bg-yellow-400 hover:text-black"
                        >
                          Open Order
                        </Link>
                      ) : null}
                      {selectedRoom.product_id ? (
                        <Link
                          href={`/product/${selectedRoom.product_id}`}
                          className="rounded-full border border-cyan-400/40 px-3 py-2 text-xs font-black text-cyan-300 hover:bg-cyan-400 hover:text-black"
                        >
                          View Product
                        </Link>
                      ) : null}
                      <button
                        type="button"
                        onClick={() =>
                          setShowPinnedPanel((current) => !current)
                        }
                        className={`flex h-9 w-9 items-center justify-center rounded-lg transition ${showPinnedPanel ? "bg-cyan-400/10 text-cyan-200" : "text-gray-400 hover:bg-white/5 hover:text-cyan-300"}`}
                        title="Channel brief"
                      >
                        <FaThumbtack />
                      </button>
                      <button
                        type="button"
                        onClick={() => {
                          setRightPanelTab("members");
                          setShowMemberPanel((current) => !current);
                        }}
                        className={`flex h-9 w-9 items-center justify-center rounded-lg transition ${showMemberPanel ? "bg-cyan-400/10 text-cyan-200" : "text-gray-400 hover:bg-white/5 hover:text-cyan-300"}`}
                        title={showMemberPanel ? "Hide member panel" : "Show member panel"}
                      >
                        <FaUsers />
                      </button>
                      <div className="relative">
                        <button
                          type="button"
                          onClick={() => setShowMoreMenu((current) => !current)}
                          className={`flex h-9 w-9 items-center justify-center rounded-lg transition ${showMoreMenu ? "bg-cyan-400/10 text-cyan-200" : "text-gray-400 hover:bg-white/5 hover:text-cyan-300"}`}
                          title="More"
                        >
                          <FaEllipsisH />
                        </button>
                        {showMoreMenu ? (
                          <div className="absolute right-0 top-11 z-40 w-56 overflow-hidden rounded-xl border border-cyan-400/25 bg-[#061421]/98 p-2 text-xs font-bold shadow-[0_22px_60px_rgba(0,0,0,0.55)]">
                            {selectedIsGroup &&
                            canManageSelectedGroupMembers ? (
                              <button
                                type="button"
                                onClick={() => {
                                  setShowMemberPanel(true);
                                  setShowInviteComposer(true);
                                  setShowMoreMenu(false);
                                  window.setTimeout(
                                    () => inviteInputRef.current?.focus(),
                                    0,
                                  );
                                }}
                                className="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-gray-300 hover:bg-cyan-400/10 hover:text-cyan-200"
                              >
                                <FaUserPlus /> Invite player
                              </button>
                            ) : null}
                            {selectedRoom.party_game &&
                            canManageSelectedGroupMembers ? (
                              <button
                                type="button"
                                onClick={() => {
                                  setShowMoreMenu(false);
                                  void togglePartyDiscovery(
                                    !selectedRoom.party_open,
                                  );
                                }}
                                className="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-gray-300 hover:bg-cyan-400/10 hover:text-cyan-200"
                              >
                                <FaGlobe />{" "}
                                {selectedRoom.party_open
                                  ? "Make party private"
                                  : "Publish to Squad Finder"}
                              </button>
                            ) : null}
                            <button
                              type="button"
                              onClick={() => {
                                setShowMoreMenu(false);
                                void refreshSelectedRoom(selectedRoom.id);
                              }}
                              className="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-gray-300 hover:bg-cyan-400/10 hover:text-cyan-200"
                            >
                              <FaArrowRight /> Refresh room
                            </button>
                            <button
                              type="button"
                              onClick={() => {
                                setShowMoreMenu(false);
                                void navigator.clipboard
                                  .writeText(
                                    `${window.location.origin}/messages?room=${selectedRoom.id}`,
                                  )
                                  .then(
                                    () => setNotice("Room link copied."),
                                    () =>
                                      setError("Could not copy the room link."),
                                  );
                              }}
                              className="flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-gray-300 hover:bg-cyan-400/10 hover:text-cyan-200"
                            >
                              <FaPaperclip /> Copy room link
                            </button>
                          </div>
                        ) : null}
                      </div>
                    </div>
                  </div>
                  {selectedIsGroup && selectedRoom.party_game ? (
                    <div
                      className={`${styles.channelTagRow} mt-3 flex flex-wrap gap-2 text-[10px] font-bold text-gray-400`}
                    >
                      {selectedRoom.party_mode ? (
                        <span className="rounded-full border border-white/10 px-2.5 py-1">
                          {selectedRoom.party_mode}
                        </span>
                      ) : null}
                      {selectedRoom.party_rank ? (
                        <span className="rounded-full border border-white/10 px-2.5 py-1">
                          {selectedRoom.party_rank}
                        </span>
                      ) : null}
                      {selectedRoom.party_platform ? (
                        <span className="rounded-full border border-white/10 px-2.5 py-1">
                          {selectedRoom.party_platform}
                        </span>
                      ) : null}
                      {selectedRoom.party_region ? (
                        <span className="rounded-full border border-white/10 px-2.5 py-1">
                          {selectedRoom.party_region}
                        </span>
                      ) : null}
                      <span
                        className={`rounded-full border px-2.5 py-1 ${selectedRoom.party_open ? "border-emerald-400/25 text-emerald-300" : "border-white/10"}`}
                      >
                        {selectedRoom.party_open
                          ? "Open in Squad Finder"
                          : "Private party"}
                      </span>
                    </div>
                  ) : null}
                  {showPinnedPanel ? (
                    <div
                      className={`${styles.channelBrief} mt-3 flex items-start gap-3 rounded-xl border border-yellow-400/20 bg-yellow-400/[0.06] p-3 text-xs text-gray-300`}
                    >
                      <FaThumbtack className="mt-0.5 shrink-0 text-yellow-300" />
                      <div>
                        <p className="font-black text-yellow-200">
                          Channel brief
                        </p>
                        <p className="mt-1 text-gray-400">
                          {selectedCommunityChannel?.topic ||
                            selectedRoom.description ||
                            "No channel topic has been published yet."}
                        </p>
                      </div>
                    </div>
                  ) : null}
                </div>

                <div
                  className={`${styles.conversationGrid} min-h-0 flex-1 ${selectedIsGroup && showMemberPanel ? "grid xl:grid-cols-[minmax(0,1fr)_320px]" : "flex flex-col"}`}
                >
                  <div
                    className={`${styles.chatColumn} ${streamIsActive ? styles.chatColumnLive : styles.chatColumnFocus} flex min-h-0 flex-col`}
                  >
                    {selectedRoom.product ? (
                      <div className="border-b border-white/10 bg-cyan-400/5 p-4">
                        <div className="flex items-center justify-between gap-4 rounded-2xl border border-cyan-400/20 bg-black/30 p-4">
                          <div className="min-w-0">
                            <p className="text-xs font-black uppercase tracking-wider text-cyan-300">
                              Product Context
                            </p>
                            <p className="truncate font-black">
                              {selectedRoom.product.title || "Product"}
                            </p>
                          </div>
                          <p className="shrink-0 font-black text-green-300">
                            {formatPrice(selectedRoom.product.price || 0)}
                          </p>
                        </div>
                      </div>
                    ) : null}

                    {!selectedIsGroup ? (
                      <div className="border-b border-yellow-400/20 bg-yellow-400/10 px-5 py-3 text-sm text-yellow-100">
                        <strong>Safety:</strong> Never move payment outside
                        ComePlayers. Sellers must send account credentials
                        through the encrypted delivery form on the order page,
                        not chat.
                      </div>
                    ) : null}

                    {selectedIsGroup && selectedCommunityChannel ? (
                      <div
                        className={`${styles.desktopHeaderMeta} border-b border-white/10 bg-black/20 px-5 py-3 text-sm text-gray-300`}
                      >
                        <strong className="text-cyan-300">
                          {selectedCommunityChannel.channel_type === "voice"
                            ? `ðŸ”Š ${selectedCommunityChannel.name}`
                            : `#${selectedCommunityChannel.name}`}
                        </strong>
                        {selectedCommunityChannel.topic
                          ? ` â€” ${selectedCommunityChannel.topic}`
                          : ""}
                        {selectedChannelIsVoice ? (
                          <span className="ml-2 text-emerald-300">
                            Secure LiveKit voice, video, and screen sharing are
                            available in this channel.
                          </span>
                        ) : null}
                      </div>
                    ) : null}

                    {selectedIsGroup ? (
                      <div
                        className={`${styles.voicePanelHost} ${showVoicePanel ? styles.voicePanelOpen : ""}`}
                      >
                        {showVoicePanel ? (
                          <button
                            type="button"
                            onClick={() => setShowVoicePanel(false)}
                            className="absolute right-3 top-3 z-50 flex h-8 w-8 items-center justify-center rounded-lg border border-white/10 bg-[#061421]/90 text-gray-400 hover:border-cyan-400/30 hover:text-white"
                            title="Close voice controls"
                          >
                            <FaTimes />
                          </button>
                        ) : null}
                        {selectedChannelIsVoice ? (
                          <div className={styles.liveBridgeHost} aria-hidden="true">
                            <GroupLiveStreamPanel
                              key={`voice-live-bridge:${selectedRoom.id}:${selectedChannelId}`}
                              room={conversation?.room || selectedRoom}
                              userId={userId}
                              profile={profile}
                              onRoomRefresh={refreshSelectedRoom}
                              onWatchingChange={setStreamViewerActive}
                              onHostingChange={setStreamHostActive}
                              onViewerCountChange={setStreamViewerCount}
                              stageOnly
                            />
                          </div>
                        ) : null}
                        <CommunityVoicePanel
                          key={`community-voice:${selectedRoom.id}`}
                          roomId={selectedRoom.id}
                          selectedChannel={selectedCommunityChannel}
                          dockCommand={voiceDockCommand}
                          onDockStateChange={setVoiceDockState}
                          onNotice={setNotice}
                          onError={setError}
                        />
                      </div>
                    ) : null}

                    <div
                      className={`${styles.messageViewport} relative flex-1 overflow-hidden bg-[url('/hero-bg.webp')] bg-cover bg-center`}
                    >
                      <div className="pointer-events-none absolute inset-0 bg-[#02101c]/78" />
                      <div className="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_62%_42%,rgba(6,182,212,0.22),transparent_30%),linear-gradient(90deg,rgba(2,8,18,0.86),rgba(4,18,33,0.62)_50%,rgba(2,8,18,0.8))]" />
                      <div className="pointer-events-none absolute inset-0 bg-[url('/brand/comeplayers-cp-v6.png')] bg-[length:132px_auto] bg-center bg-no-repeat opacity-[0.055]" />
                      <div
                        className={`${styles.messageScroller} relative z-10 h-full overflow-y-auto p-5 lg:p-6 ${selectedIsGroup && selectedChannelIsVoice && wideMessagesLayout ? "xl:pr-[356px]" : ""}`}
                      >
                        {selectedChannelIsVoice ? (
                          <div className="flex h-full min-h-52 items-center justify-center text-center text-sm text-gray-500">
                            <div>
                              <FaHeadphones className="mx-auto mb-3 text-3xl text-emerald-300" />
                              <p className="font-black text-gray-300">
                                Voice channel selected
                              </p>
                              <p className="mt-1">
                                Use the LiveKit controls above to talk, enable
                                video, share your screen, or leave.
                              </p>
                            </div>
                          </div>
                        ) : loadingMessages ? (
                          <div className="flex h-full items-center justify-center text-gray-400">
                            Loading chat...
                          </div>
                        ) : conversation?.messages?.length ? (
                          <div
                            className={`${styles.groupMessageList} space-y-5`}
                          >
                            {conversation.messages.map((message) => {
                              const mine = message.sender_id === userId;
                              const sender =
                                message.sender ||
                                memberProfileMap.get(
                                  String(message.sender_id),
                                ) ||
                                null;
                              const imageAttachment = isImageAttachment(
                                message.attachment,
                              );
                              const showMessageText = Boolean(
                                message.message &&
                                !(
                                  imageAttachment &&
                                  isGenericAttachmentMessage(message.message)
                                ),
                              );
                              const imageOnly =
                                imageAttachment && !showMessageText;
                              if (selectedIsGroup) {
                                return (
                                  <div
                                    key={message.id}
                                    className={`${styles.groupMessageRow} group flex gap-3 rounded-2xl px-2 py-1 transition hover:bg-cyan-400/[0.04] ${
                                      message.deleted_at ? "opacity-60" : ""
                                    }`}
                                  >
                                    <ProfileAvatar
                                      profile={sender}
                                      size="message"
                                      className={mine ? "ring-cyan-400/40" : ""}
                                    />
                                    <div className="min-w-0 flex-1">
                                      <div className="flex flex-wrap items-baseline gap-2">
                                        <p className="truncate text-sm font-black text-white">
                                          {displayName(sender)}
                                        </p>
                                        <span className="text-[11px] text-gray-500">
                                          {formatMessageTime(message.created_at)}
                                        </span>
                                        {message.moderation_status ===
                                        "reported" ? (
                                          <span className="text-[11px] text-red-300">
                                            Reported
                                          </span>
                                        ) : null}
                                      </div>
                                      <MessageReplyPreview
                                        reply={message.reply_to}
                                      />
                                      {showMessageText || message.attachment ? (
                                        <div
                                          className={`${styles.groupMessageBubble} mt-1 max-w-[880px] ${
                                            imageOnly
                                              ? ""
                                              : "rounded-2xl border border-cyan-400/10 bg-[#081b2b]/72 px-4 py-3 text-white shadow-[inset_0_0_24px_rgba(6,182,212,0.03)] backdrop-blur-sm"
                                          }`}
                                        >
                                          {showMessageText ? (
                                            <p className="whitespace-pre-wrap text-sm leading-6">
                                              {message.message}
                                            </p>
                                          ) : null}
                                          {message.attachment ? (
                                            <div
                                              className={
                                                showMessageText ? "mt-3" : ""
                                              }
                                            >
                                              <AttachmentViewer
                                                attachment={message.attachment}
                                              />
                                            </div>
                                          ) : null}
                                        </div>
                                      ) : null}
                                      <MessageInteractions
                                        message={message}
                                        mine={mine}
                                        onReply={() => beginReply(message)}
                                        onEdit={() => beginEdit(message)}
                                        onDelete={() =>
                                          void deleteMessage(message)
                                        }
                                        onReact={(emoji) =>
                                          void toggleReaction(message, emoji)
                                        }
                                        onReport={() =>
                                          void reportMessage(message)
                                        }
                                      />
                                    </div>
                                  </div>
                                );
                              }

                              return (
                                <div
                                  key={message.id}
                                  className={`flex items-end gap-3 ${mine ? "justify-end" : "justify-start"}`}
                                >
                                  {!mine ? (
                                    <ProfileAvatar
                                      profile={sender}
                                      size="message"
                                    />
                                  ) : null}
                                  <div
                                    className={`group max-w-[82%] ${mine ? "text-right" : "text-left"}`}
                                  >
                                    <MessageReplyPreview
                                      reply={message.reply_to}
                                    />
                                    <div
                                      className={`${
                                        imageOnly
                                          ? "rounded-2xl p-0 shadow-none"
                                          : `rounded-3xl border px-5 py-4 shadow-xl backdrop-blur-sm ${
                                              mine
                                                ? "border-cyan-200/40 bg-cyan-400 text-black shadow-cyan-400/20"
                                                : "border-cyan-400/10 bg-[#081b2b]/78 text-white"
                                            }`
                                      } ${message.deleted_at ? "opacity-60" : ""}`}
                                    >
                                      {showMessageText ? (
                                        <p className="whitespace-pre-wrap text-sm leading-6">
                                          {message.message}
                                        </p>
                                      ) : null}
                                      {message.attachment ? (
                                        <div
                                          className={
                                            showMessageText ? "mt-3" : ""
                                          }
                                        >
                                          <AttachmentViewer
                                            attachment={message.attachment}
                                          />
                                        </div>
                                      ) : null}
                                      <div
                                        className={`mt-2 flex items-center gap-2 text-[11px] ${
                                          mine
                                            ? imageOnly
                                              ? "justify-end text-gray-500"
                                              : "justify-end text-black/60"
                                            : "text-gray-500"
                                        }`}
                                      >
                                        <span>
                                          {formatMessageTime(message.created_at)}
                                        </span>
                                        {message.edited_at ? (
                                          <span>Edited</span>
                                        ) : null}
                                        {mine && !selectedIsGroup ? (
                                          <span>
                                            {message.is_read ? "Read" : "Sent"}
                                          </span>
                                        ) : null}
                                        {message.moderation_status ===
                                        "reported" ? (
                                          <span>Reported</span>
                                        ) : null}
                                      </div>
                                    </div>
                                    <MessageInteractions
                                      message={message}
                                      mine={mine}
                                      onReply={() => beginReply(message)}
                                      onEdit={() => beginEdit(message)}
                                      onDelete={() =>
                                        void deleteMessage(message)
                                      }
                                      onReact={(emoji) =>
                                        void toggleReaction(message, emoji)
                                      }
                                      onReport={() =>
                                        void reportMessage(message)
                                      }
                                    />
                                  </div>
                                  {mine ? (
                                    <ProfileAvatar
                                      profile={sender || profile}
                                      size="message"
                                      className="ring-cyan-400/40"
                                    />
                                  ) : null}
                                </div>
                              );
                            })}
                            <div ref={bottomRef} />
                          </div>
                        ) : (
                          <div className="flex h-full items-center justify-center text-center">
                            <div>
                              {selectedIsGroup ? (
                                <FaUsers className="mx-auto text-4xl text-cyan-300" />
                              ) : (
                                <FaShieldAlt className="mx-auto text-4xl text-cyan-300" />
                              )}
                              <h2 className="mt-4 text-2xl font-black">
                                {selectedIsGroup
                                  ? "Start the server conversation"
                                  : "Start a protected conversation"}
                              </h2>
                              <p className="mt-2 text-gray-400">
                                {selectedIsGroup
                                  ? "Share updates with the server or start a live gameplay session."
                                  : "Ask about the product without sharing external contact details."}
                              </p>
                            </div>
                          </div>
                        )}
                      </div>
                    </div>

                    {!selectedChannelIsVoice &&
                    Object.values(visibleTypingUsers).length ? (
                      <div className="px-5 pb-2 text-xs font-bold text-cyan-300">
                        {Object.values(visibleTypingUsers)
                          .map((entry) => entry.name)
                          .slice(0, 3)
                          .join(", ")}{" "}
                        typingâ€¦
                      </div>
                    ) : null}

                    <div
                      className={`${styles.composerDock} border-t border-cyan-400/15 bg-[#061421]/86 p-4 backdrop-blur-xl`}
                    >
                      {notice ? (
                        <div className="mb-3 rounded-xl border border-emerald-400/30 bg-emerald-400/10 p-3 text-sm text-emerald-200">
                          {notice}
                        </div>
                      ) : null}
                      {error ? (
                        <div className="mb-3 flex items-start gap-2 rounded-xl border border-red-400/30 bg-red-400/10 p-3 text-sm text-red-200">
                          <FaExclamationTriangle className="mt-0.5 shrink-0" />{" "}
                          {error}
                        </div>
                      ) : null}

                      {selectedChannelIsVoice ? (
                        <div className="rounded-2xl border border-emerald-400/20 bg-emerald-400/10 p-4 text-center text-sm text-emerald-100">
                          Voice channels use the LiveKit controls above and do
                          not accept text messages.
                        </div>
                      ) : roomLocked ? (
                        <div className="rounded-2xl border border-red-400/30 bg-red-400/10 p-4 text-center font-black text-red-200">
                          This conversation is locked by moderation.
                        </div>
                      ) : (
                        <>
                          {replyingTo || editingMessage ? (
                            <div className="mb-3 flex items-center justify-between gap-3 rounded-xl border border-cyan-400/30 bg-cyan-400/10 px-4 py-3 text-sm">
                              <div className="min-w-0">
                                <p className="font-black text-cyan-200">
                                  {editingMessage
                                    ? "Editing your message"
                                    : `Replying to ${displayName(replyingTo?.sender)}`}
                                </p>
                                <p className="mt-1 truncate text-xs text-gray-400">
                                  {(
                                    editingMessage?.message ||
                                    replyingTo?.message ||
                                    "Attachment"
                                  ).slice(0, 140)}
                                </p>
                              </div>
                              <button
                                type="button"
                                onClick={cancelComposerMode}
                                className="rounded-lg p-2 text-gray-300 hover:bg-white/10"
                                title="Cancel"
                              >
                                <FaTimes />
                              </button>
                            </div>
                          ) : null}
                          {!selectedIsGroup ? (
                            <div className="mb-3 flex flex-wrap gap-2">
                              {[
                                "Is this product still available?",
                                "What is the delivery estimate?",
                                "I have completed payment through ComePlayers.",
                              ].map((text) => (
                                <button
                                  key={text}
                                  onClick={() => setDraft(text)}
                                  className="rounded-full border border-white/10 px-3 py-2 text-xs font-bold text-gray-300 hover:bg-white hover:text-black"
                                >
                                  {text}
                                </button>
                              ))}
                            </div>
                          ) : null}
                          <input
                            ref={fileInputRef}
                            type="file"
                            accept="image/jpeg,image/png,image/webp,image/gif,application/pdf"
                            className="hidden"
                            onChange={(event) => {
                              const file = event.target.files?.[0];
                              if (file) void uploadAttachment(file);
                            }}
                          />
                          <input
                            ref={gifInputRef}
                            type="file"
                            accept="image/gif"
                            className="hidden"
                            onChange={(event) => {
                              const file = event.target.files?.[0];
                              if (file) void uploadAttachment(file);
                            }}
                          />
                          <div
                            className={`${styles.composerBar} relative flex items-end gap-2 rounded-2xl border border-cyan-400/40 bg-[#061522]/88 p-2 shadow-[inset_0_0_28px_rgba(6,182,212,0.08),0_0_26px_rgba(6,182,212,0.16)] backdrop-blur-xl focus-within:border-cyan-300/70`}
                          >
                            <button
                              type="button"
                              onClick={() => fileInputRef.current?.click()}
                              disabled={
                                sending ||
                                uploading ||
                                Boolean(editingMessage) ||
                                channelComposerDisabled
                              }
                              className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[0.06] text-gray-200 transition hover:border-cyan-400/50 hover:bg-cyan-400/10 hover:text-cyan-200 disabled:opacity-40"
                              title="Upload private image or PDF"
                            >
                              <FaPlus />
                            </button>
                            <button
                              type="button"
                              onClick={() => {
                                setShowGiftPicker((current) => !current);
                                setShowEmojiPicker(false);
                              }}
                              className="hidden h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/[0.06] text-gray-200 transition hover:border-yellow-400/40 hover:text-yellow-300 sm:flex"
                              title="Insert gift message"
                            >
                              <FaGift />
                            </button>
                            {showGiftPicker ? (
                              <div
                                className={`${styles.composerPicker} absolute bottom-[58px] left-12 z-30 grid w-48 grid-cols-2 gap-2 rounded-xl border border-yellow-400/25 bg-[#061421]/98 p-3 shadow-2xl`}
                              >
                                {[
                                  "ðŸŽ GG Pack",
                                  "ðŸ† MVP Badge",
                                  "âš¡ Boost",
                                  "ðŸ’Ž Gem Drop",
                                ].map((gift) => (
                                  <button
                                    key={gift}
                                    type="button"
                                    onClick={() => {
                                      setDraft(
                                        (current) =>
                                          `${current}${current ? " " : ""}${gift}`,
                                      );
                                      setShowGiftPicker(false);
                                      composerRef.current?.focus();
                                    }}
                                    className="rounded-lg border border-white/10 p-2 text-left text-[10px] font-bold hover:border-yellow-400/30 hover:bg-yellow-400/10"
                                  >
                                    {gift}
                                  </button>
                                ))}
                              </div>
                            ) : null}
                            <textarea
                              ref={composerRef}
                              value={draft}
                              onChange={(event) =>
                                updateDraft(event.target.value)
                              }
                              onKeyDown={(event) => {
                                if (event.key === "Enter" && !event.shiftKey) {
                                  event.preventDefault();
                                  void sendMessage();
                                }
                              }}
                              rows={2}
                              maxLength={2000}
                              disabled={channelComposerDisabled}
                              placeholder={
                                selectedIsGroup
                                  ? selectedChannelIsVoice
                                    ? "Voice channels do not accept text messages."
                                    : `Message #${selectedCommunityChannel?.name || "general"}`
                                  : "Type a protected message..."
                              }
                              className="min-h-[46px] flex-1 resize-none bg-transparent px-2 py-2 text-sm leading-6 outline-none placeholder:text-gray-600"
                            />
                            <button
                              type="button"
                              onClick={() => gifInputRef.current?.click()}
                              disabled={
                                sending ||
                                uploading ||
                                Boolean(editingMessage) ||
                                channelComposerDisabled
                              }
                              className="flex h-8 shrink-0 items-center justify-center self-center rounded-md border border-white/20 px-1.5 text-[9px] font-black text-gray-300 transition hover:border-cyan-400/45 hover:text-cyan-200 disabled:opacity-40"
                              title="Upload GIF"
                            >
                              GIF
                            </button>
                            <button
                              type="button"
                              onClick={() => {
                                setShowEmojiPicker((current) => !current);
                                setShowGiftPicker(false);
                              }}
                              className="hidden h-10 w-10 shrink-0 items-center justify-center rounded-xl text-gray-300 transition hover:bg-white/5 hover:text-yellow-300 sm:flex"
                              title="Emoji"
                            >
                              <FaSmile />
                            </button>
                            {showEmojiPicker ? (
                              <div
                                className={`${styles.composerPicker} absolute bottom-[58px] right-12 z-30 flex flex-wrap gap-2 rounded-xl border border-cyan-400/25 bg-[#061421]/98 p-3 shadow-2xl`}
                              >
                                {[
                                  "ðŸ˜€",
                                  "ðŸ”¥",
                                  "ðŸŽ®",
                                  "ðŸ‘",
                                  "â¤ï¸",
                                  "ðŸ˜‚",
                                  "âœ…",
                                  "ðŸ†",
                                ].map((emoji) => (
                                  <button
                                    key={emoji}
                                    type="button"
                                    onClick={() => {
                                      setDraft(
                                        (current) => `${current}${emoji}`,
                                      );
                                      setShowEmojiPicker(false);
                                      composerRef.current?.focus();
                                    }}
                                    className="flex h-9 w-9 items-center justify-center rounded-lg text-lg hover:bg-white/10"
                                  >
                                    {emoji}
                                  </button>
                                ))}
                              </div>
                            ) : null}
                            <button
                              type="button"
                              onClick={() => void sendMessage()}
                              disabled={
                                sending ||
                                uploading ||
                                !draft.trim() ||
                                channelComposerDisabled
                              }
                              className="flex h-10 w-11 shrink-0 items-center justify-center rounded-xl bg-transparent text-lg text-cyan-300 transition hover:bg-cyan-400/10 hover:text-cyan-100 disabled:opacity-40"
                              title={
                                editingMessage ? "Save message" : "Send message"
                              }
                            >
                              {sending || uploading ? "â€¦" : <FaPaperPlane />}
                            </button>
                          </div>
                          <p
                            className={`${styles.composerHint} mt-2 flex items-center justify-between text-[10px] text-gray-600`}
                          >
                            <span>
                              Enter to send Â· Shift+Enter for a new line
                            </span>
                            <span>{draft.length}/2000</span>
                          </p>
                        </>
                      )}
                    </div>
                  </div>

                  {selectedIsGroup && showMemberPanel && wideMessagesLayout ? (
                    <aside
                      className={`${styles.rightRail} ${styles.rightPanelTabbed} hidden min-h-0 xl:grid`}
                      aria-label="Server members, squad, and events"
                    >
                      <div className={styles.rightPanelTabs}>
                        {(["members", "squad", "events"] as RightPanelTab[]).map(
                          (tab) => (
                            <button
                              key={tab}
                              type="button"
                              onClick={() => setRightPanelTab(tab)}
                              data-active={rightPanelTab === tab}
                              className={styles.rightPanelTab}
                            >
                              {tab === "members"
                                ? "Members"
                                : tab === "squad"
                                  ? "Squad"
                                  : "Events"}
                            </button>
                          ),
                        )}
                      </div>

                      <section className={styles.rightPanelBody}>
                        {rightPanelTab === "members" ? (
                          <>
                            <div className={styles.rightPanelHeading}>
                              <div>
                                <p>Server Members</p>
                                <span>{conversationMembers.length} total</span>
                              </div>
                              <button
