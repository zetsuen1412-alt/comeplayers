                              </button>
                            </div>

                            <div className={styles.memberStatusSection}>
                              <p>Online â€” {onlineConversationMembers.length}</p>
                              {onlineConversationMembers.length ? (
                                onlineConversationMembers.slice(0, 7).map((member) => (
                                  <button
                                    key={`online:${member.user_id}`}
                                    type="button"
                                    onClick={() => void openCommunityOverlay("members")}
                                    className={styles.rightMemberRow}
                                  >
                                    <span className="relative shrink-0">
                                      <ProfileAvatar profile={member.profile} size="sm" />
                                      <span className="absolute -bottom-0.5 -right-0.5 h-3 w-3 rounded-full border-2 border-[#071827] bg-emerald-400" />
