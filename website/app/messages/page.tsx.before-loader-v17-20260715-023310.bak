                              </button>
                            </div>

                            <div className={styles.squadMemberList}>
                              {conversationMembers.slice(0, 5).map((member) => {
                                const memberOnline =
                                  redisEnabled && onlineUserIds.has(member.user_id);
                                return (
                                  <button
                                    key={`squad:${member.user_id}`}
                                    type="button"
                                    onClick={() => void openCommunityOverlay("members")}
                                    className={styles.squadMemberRow}
                                  >
                                    <span className="relative shrink-0">
                                      <ProfileAvatar
                                        profile={member.profile}
                                        size="md"
                                        live={selectedRoom.stream_host_id === member.user_id}
                                      />
                                      <span
                                        className={`absolute -bottom-0.5 -right-0.5 h-3 w-3 rounded-full border-2 border-[#071827] ${memberOnline ? "bg-emerald-400" : "bg-gray-600"}`}
                                      />
                                    </span>
                                    <span className="min-w-0 flex-1">
                                      <span className="block truncate text-sm font-bold text-white">
                                        {displayName(member.profile)}
                                      </span>
                                      <span
                                        className={`mt-0.5 block truncate text-[10px] ${memberOnline ? "text-emerald-300" : "text-gray-500"}`}
                                      >
                                        {memberOnline
                                          ? memberRoleLabel(member.member_role)
                                          : "Offline"}
                                      </span>
                                    </span>
                                  </button>
                                );
                              })}

                              {Array.from({ length: visibleSquadInviteSlots }).map(
                                (_, index) => (
                                  <button
                                    key={`invite-slot:${index}`}
                                    type="button"
                                    onClick={() => void openServerInviteModal()}
                                    aria-disabled={!canInviteToServer}
                                    className={`${styles.squadInviteRow} ${canInviteToServer ? "" : "opacity-45"}`}
                                  >
                                    <span className={styles.squadInviteIcon}>
                                      <FaPlus />
                                    </span>
                                    <span className="text-sm font-medium">Invite Player</span>
                                  </button>
                                ),
                              )}
                            </div>

                            <button
                              type="button"
                              onClick={openSquadCreator}
                              className={styles.findPlayersButton}
                            >
                              <FaCrosshairs /> Find Players
                            </button>
                            <div className="mt-2 grid gap-2">
                              <button
                                type="button"
                                onClick={prepareCommunityPost}
                                className="flex min-h-11 w-full items-center justify-center gap-2 rounded-xl border border-cyan-400/25 bg-cyan-400/[0.07] px-3 text-xs font-black text-cyan-200 transition hover:border-cyan-300/60 hover:bg-cyan-400/15 hover:text-white"
                              >
                                <FaEdit /> Create Post
                              </button>
                              <button
                                type="button"
                                onClick={() => void openServerInviteModal()}
                                disabled={!canInviteToServer}
                                className="flex min-h-11 w-full items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/[0.045] px-3 text-xs font-black text-slate-200 transition hover:border-cyan-400/35 hover:bg-white/[0.08] disabled:cursor-not-allowed disabled:opacity-40"
                                title={
                                  canInviteToServer
                                    ? "Invite a friend to this server"
                                    : "Only the Creator or a Leader can invite players"
                                }
                              >
                                <FaUserPlus /> Invite Friend
                              </button>
                            </div>
                          </>
                        ) : null}

                        {rightPanelTab === "events" ? (
                          <>
                            <div className={styles.rightPanelHeading}>
                              <div>
                                <p>Upcoming Events</p>
                                <span>Server activities and tournaments</span>
                              </div>
                              <button
                                type="button"
                                onClick={() => void openCommunityOverlay("events")}
                              >
                                View All
                              </button>
                            </div>
                            <div className={styles.eventList}>
                              {announcementsLoading ? (
                                <p className={styles.rightPanelEmpty}>Loading events...</p>
                              ) : announcements.length ? (
                                announcements.slice(0, 4).map((announcement) => (
                                  <Link
                                    key={announcement.id}
                                    href={`/announcements/${announcement.slug}`}
                                    className={styles.eventRow}
                                  >
                                    {announcement.image_url ? (
                                      // eslint-disable-next-line @next/next/no-img-element
                                      <img
                                        src={announcement.image_url}
                                        alt=""
                                        className={styles.eventThumb}
                                      />
                                    ) : (
                                      <span
                                        className={`${styles.eventThumb} flex shrink-0 items-center justify-center bg-cyan-400/10 text-cyan-300`}
                                      >
                                        <FaCalendarAlt />
                                      </span>
                                    )}
                                    <span className="min-w-0 flex-1">
                                      <span className="block truncate text-xs font-bold text-white">
                                        {announcement.title}
                                      </span>
                                      <span className="mt-1 block truncate text-[10px] text-gray-500">
                                        {formatDate(
                                          announcement.publish_at || announcement.created_at,
                                        )}
                                      </span>
                                    </span>
                                  </Link>
                                ))
                              ) : (
                                <Link
                                  href="/announcements"
                                  className={styles.rightPanelEmpty}
                                >
                                  No published events. Browse announcements â†’
                                </Link>
                              )}
                            </div>
                          </>
                        ) : null}
                      </section>

                      {showSquadFinder ? (
                        <section
                          className={`${styles.finderOverlay} border border-cyan-400/30 bg-[#061421]/98 p-4 shadow-2xl`}
                        >
                          <div className="mb-3 flex items-center justify-between">
                            <div>
                              <p className="text-sm font-bold text-white">
                                Squad Finder
                              </p>
                              <p className="text-[10px] text-gray-500">
                                Real parties currently looking for players.
                              </p>
                            </div>
                            <button
                              type="button"
                              onClick={() => setShowSquadFinder(false)}
                              className="rounded-lg p-2 text-gray-400 hover:bg-white/10 hover:text-white"
                              title="Close Squad Finder"
                            >
                              <FaTimes />
                            </button>
                          </div>
                          <div className={`${styles.finderPanel} space-y-2`}>
                            {matchmakingLoading ? (
                              <p className="rounded-xl border border-white/10 p-4 text-xs text-gray-500">
                                Finding squads...
                              </p>
                            ) : matchmakingParties.length ? (
                              matchmakingParties.slice(0, 5).map((party) => (
                                <div
                                  key={party.id}
                                  className="flex items-center gap-3 rounded-xl border border-white/10 bg-black/20 p-3"
                                >
                                  <ProfileAvatar
                                    profile={party.leader}
                                    size="sm"
                                    fallback={<FaGamepad />}
                                  />
                                  <div className="min-w-0 flex-1">
                                    <p className="truncate text-xs font-bold">
                                      {party.title ||
                                        `${party.party_game || "Game"} Squad`}
                                    </p>
                                    <p className="truncate text-[10px] text-gray-500">
                                      {party.member_count}/{party.party_size || 5}
                                      {party.party_mode
                                        ? ` Â· ${party.party_mode}`
                                        : ""}
                                    </p>
                                  </div>
                                  <button
                                    type="button"
                                    onClick={() => void joinParty(party)}
                                    disabled={
                                      matchmakingBusy === `join:${party.id}` ||
                                      (party.member_count >=
                                        Number(party.party_size || 5) &&
                                        !party.joined)
                                    }
                                    className="rounded-lg bg-cyan-400 px-3 py-2 text-[10px] font-black text-black disabled:opacity-40"
                                  >
                                    {party.joined ? "Open" : "Join"}
                                  </button>
                                </div>
                              ))
                            ) : (
                              <p className="rounded-xl border border-dashed border-white/10 p-5 text-center text-xs text-gray-500">
                                No open squads are available.
                              </p>
                            )}
                          </div>
                        </section>
                      ) : null}
                    </aside>
                  ) : null}

                  {selectedIsGroup && showMemberPanel && !wideMessagesLayout ? (
                    <aside
                      className={`${styles.rightRail} hidden min-h-0 gap-4 overflow-y-auto border-l border-cyan-400/10 bg-[#061421]/62 p-4 backdrop-blur-xl xl:flex xl:flex-col`}
                    >
                      <div className="shrink-0 rounded-2xl border border-cyan-400/20 bg-[#071827]/76 p-4 shadow-[inset_0_0_30px_rgba(6,182,212,0.05)]">
                        <div className="flex items-center justify-between gap-3">
                          <div>
                            <p className="text-[11px] font-black uppercase tracking-[0.16em] text-gray-300">
                              Squad{" "}
                              <span className="ml-2 text-cyan-300">
                                {conversationMembers.length}/
                                {selectedRoom.party_size ||
                                  Math.max(conversationMembers.length, 5)}
                              </span>
                            </p>
                            <p className="mt-1 text-xs text-gray-500">
                              Creator and Leaders manage the party.
                            </p>
                          </div>
                          <FaUsers className="text-cyan-300" />
                        </div>
                      </div>

                      {canManageSelectedGroupMembers ? (
                        <form
                          className="shrink-0 rounded-2xl border border-cyan-400/15 bg-[#071827]/68 p-3 shadow-[inset_0_0_24px_rgba(255,255,255,0.02)]"
                          onSubmit={(event) => {
                            event.preventDefault();
                            void inviteMember();
                          }}
                        >
                          <label className="text-[10px] font-black uppercase tracking-[0.14em] text-gray-500">
                            Invite player Â· acceptance required
                          </label>
                          <div className="mt-2 flex gap-2">
                            <input
                              ref={inviteInputRef}
                              value={inviteIdentifier}
                              onChange={(event) =>
                                setInviteIdentifier(event.target.value)
                              }
                              placeholder="Email or @username"
                              className="min-w-0 flex-1 rounded-xl border border-white/10 bg-black/30 px-3 py-2 text-xs outline-none placeholder:text-gray-600 focus:border-cyan-400"
                            />
                            <button
                              type="submit"
                              disabled={
                                !inviteIdentifier.trim() ||
                                memberActionBusy.startsWith("invite:")
                              }
                              className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-cyan-400/40 bg-cyan-400/10 text-cyan-200 transition hover:bg-cyan-400 hover:text-black disabled:opacity-40"
                              title="Invite player"
                            >
                              <FaUserPlus />
                            </button>
                          </div>
                        </form>
                      ) : null}

                      {canManageSelectedGroupMembers &&
                      selectedRoom.party_game ? (
                        <div className="shrink-0 rounded-2xl border border-yellow-400/20 bg-yellow-400/[0.05] p-3 shadow-[inset_0_0_24px_rgba(250,204,21,0.03)]">
                          <div className="flex items-start gap-3">
                            <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-yellow-400/25 bg-yellow-400/10 text-yellow-300">
                              <FaCrosshairs />
                            </span>
                            <div className="min-w-0 flex-1">
                              <p className="text-xs font-black text-yellow-200">
                                Random Matchmaking Invite
                              </p>
                              <p className="mt-1 text-[10px] leading-4 text-gray-500">
                                Random players receive a pending invitation.
                                They only enter after pressing Accept.
                              </p>
                            </div>
                          </div>
                          <div className="mt-3 grid grid-cols-2 gap-2">
                            <button
                              type="button"
                              onClick={() => void autoInviteRandomPlayers(1)}
                              disabled={matchmakingBusy.startsWith("auto:")}
                              className="rounded-lg border border-yellow-400/25 px-2 py-2 text-[10px] font-black text-yellow-300 transition hover:bg-yellow-400 hover:text-black disabled:opacity-40"
                            >
                              Invite 1 Random
                            </button>
                            <button
                              type="button"
                              onClick={() =>
                                void autoInviteRandomPlayers(
                                  Math.max(
                                    1,
                                    Number(selectedRoom.party_size || 5) -
                                      conversationMembers.length,
                                  ),
                                )
                              }
                              disabled={matchmakingBusy.startsWith("auto:")}
                              className="rounded-lg bg-yellow-400 px-2 py-2 text-[10px] font-black text-black transition hover:bg-yellow-300 disabled:opacity-40"
                            >
                              {matchmakingBusy.startsWith("auto:")
                                ? "Inviting..."
                                : "Fill Open Slots"}
                            </button>
                          </div>
                          <p className="mt-2 text-[9px] font-bold text-gray-600">
                            {
                              sentInvitations.filter(
                                (invite) => invite.room_id === selectedRoom.id,
                              ).length
                            }{" "}
                            invitation(s) currently pending.
                          </p>
                        </div>
                      ) : null}

                      <div className="max-h-[250px] shrink-0 overflow-y-auto rounded-2xl border border-cyan-400/15 bg-[#071827]/68 p-3">
                        {conversationMembers.map((member) => {
                          const memberProfile = member.profile;
                          const liveHost =
                            selectedRoom.stream_host_id === member.user_id;
                          const role = String(
                            member.member_role || "member",
                          ).toLowerCase();
                          const actorIsModerator =
                            selectedGroupRole === "moderator" ||
                            selectedGroupRole === "group_moderator";
                          const targetIsModerator =
                            role === "moderator" || role === "group_moderator";
                          const targetIsOwner =
                            role === "owner" || role === "group_owner";
                          const canRemoveMember =
                            canManageSelectedGroupMembers &&
                            member.user_id !== userId &&
                            !targetIsOwner &&
                            !(
                              actorIsModerator &&
                              targetIsModerator &&
                              !isAdminProfile(profile)
                            );
                          const canChangeLeader =
                            canAssignSelectedGroupLeaders &&
                            member.user_id !== userId &&
                            !targetIsOwner;
                          const removing =
                            memberActionBusy === `remove:${member.user_id}`;
                          const changingRole =
                            memberActionBusy === `role:${member.user_id}`;
                          return (
                            <div
                              key={member.user_id}
                              className="group mb-1 flex items-center gap-3 rounded-xl border border-transparent p-2 transition hover:border-cyan-400/20 hover:bg-cyan-400/[0.05]"
                            >
                              <div className="relative shrink-0">
                                <ProfileAvatar
                                  profile={memberProfile}
                                  size="md"
                                  live={liveHost}
                                />
                                <span
                                  className={`absolute -bottom-0.5 -right-0.5 h-3.5 w-3.5 rounded-full border-2 border-[#07111d] ${!redisEnabled || onlineUserIds.has(member.user_id) ? "bg-emerald-400" : "bg-gray-600"}`}
                                />
                              </div>
                              <div className="min-w-0 flex-1">
                                <p className="flex items-center gap-1 truncate text-sm font-black">
                                  {targetIsOwner ? (
                                    <FaCrown
                                      className="shrink-0 text-yellow-400"
                                      title="Creator"
                                    />
                                  ) : targetIsModerator ? (
                                    <FaShieldAlt
                                      className="shrink-0 text-cyan-300"
                                      title="Leader"
                                    />
                                  ) : null}
                                  <span className="truncate">
                                    {displayName(memberProfile)}
                                  </span>
                                </p>
                                <p
                                  className={`text-[10px] font-bold ${targetIsOwner ? "text-yellow-400" : targetIsModerator ? "text-cyan-300" : "text-gray-500"}`}
                                >
                                  {memberRoleLabel(member.member_role)}
                                  {liveHost ? " Â· Live host" : ""}
                                </p>
                              </div>
                              <div className="flex shrink-0 gap-1 opacity-0 transition group-hover:opacity-100">
                                {canChangeLeader ? (
                                  <button
                                    type="button"
                                    onClick={() =>
                                      void updateMemberRole(
                                        member,
                                        targetIsModerator
                                          ? "member"
                                          : "moderator",
                                      )
                                    }
                                    disabled={changingRole}
                                    className="flex h-8 w-8 items-center justify-center rounded-lg border border-yellow-400/25 text-yellow-300 transition hover:bg-yellow-400 hover:text-black disabled:opacity-40"
                                    title={
                                      targetIsModerator
                                        ? "Remove Leader role"
                                        : "Appoint Leader"
                                    }
                                  >
                                    {targetIsModerator ? (
                                      <FaUserShield />
                                    ) : (
                                      <FaCrown />
                                    )}
                                  </button>
                                ) : null}
                                {canRemoveMember ? (
                                  <button
                                    type="button"
                                    onClick={() => void removeMember(member)}
                                    disabled={removing}
                                    className="flex h-8 w-8 items-center justify-center rounded-lg border border-red-400/25 text-red-300 transition hover:bg-red-500 hover:text-white disabled:opacity-40"
                                    title={`Kick ${displayName(memberProfile)}`}
                                  >
                                    <FaUserMinus />
                                  </button>
                                ) : null}
                              </div>
                            </div>
                          );
                        })}
                      </div>

                      <div className="shrink-0 rounded-2xl border border-cyan-400/20 bg-[#071827]/76 p-4 shadow-[inset_0_0_30px_rgba(6,182,212,0.05)]">
                        <div className="mb-3 flex items-center justify-between">
                          <p className="text-[11px] font-black uppercase tracking-[0.14em] text-gray-300">
                            Upcoming Events
                          </p>
                          <Link
                            href="/announcements"
                            className="text-[10px] font-black text-cyan-300 hover:text-cyan-200"
                          >
                            View All
                          </Link>
                        </div>
                        <div className="space-y-3">
                          {announcements.slice(0, 3).map((announcement) => (
                            <Link
                              key={announcement.id}
                              href={`/announcements/${announcement.slug}`}
                              className="flex items-center gap-3 rounded-xl border border-white/10 bg-black/20 p-2 hover:border-cyan-400/30"
                            >
                              {announcement.image_url ? (
                                // eslint-disable-next-line @next/next/no-img-element
                                <img
                                  src={announcement.image_url}
                                  alt=""
                                  className="h-14 w-14 shrink-0 rounded-lg object-cover"
                                />
                              ) : (
                                <span className="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-cyan-400/10 text-cyan-300">
                                  <FaCalendarAlt />
                                </span>
                              )}
                              <span className="min-w-0 flex-1">
                                <span className="block truncate text-sm font-bold text-white">
                                  {announcement.title}
                                </span>
                                <span className="block truncate text-[10px] text-gray-400">
                                  {announcement.summary ||
                                    "ComePlayers server update"}
                                </span>
                                <span className="mt-1 block truncate text-[10px] text-gray-500">
                                  {formatDate(
                                    announcement.publish_at ||
                                      announcement.created_at,
                                  )}
                                </span>
                              </span>
                              <span className="rounded-md border border-cyan-400/30 px-2 py-1 text-[9px] font-bold text-cyan-300">
                                Open
                              </span>
                            </Link>
                          ))}
                        </div>
                      </div>

                      <div className="shrink-0 rounded-2xl border border-cyan-400/20 bg-[#071827]/76 p-4 shadow-[inset_0_0_30px_rgba(6,182,212,0.05)]">
                        <div className="flex items-center justify-between gap-2 px-1">
                          <div>
                            <p className="text-[11px] font-black uppercase tracking-[0.14em] text-gray-400">
                              Squad Finder
                            </p>
                            <p className="text-[10px] text-gray-600">
                              Open parties looking for teammates
                            </p>
                          </div>
                          <button
                            type="button"
                            onClick={() =>
                              setShowSquadFinder((current) => !current)
                            }
                            className="text-[10px] font-black text-cyan-300 hover:text-cyan-200"
                          >
                            {showSquadFinder ? "Hide" : "View"}
                          </button>
                        </div>
                        {showSquadFinder ? (
                          <div className="mt-3 space-y-2">
                            {matchmakingLoading ? (
                              <div className="rounded-xl border border-white/10 p-3 text-xs text-gray-500">
                                Finding squads...
                              </div>
                            ) : matchmakingParties.length ? (
                              matchmakingParties.slice(0, 5).map((party) => {
                                const full =
                                  party.member_count >=
                                  Number(party.party_size || 5);
                                const busy =
                                  matchmakingBusy === `join:${party.id}`;
                                return (
                                  <div
                                    key={party.id}
                                    className="rounded-xl border border-white/10 bg-black/20 p-3 transition hover:border-cyan-400/30"
                                  >
                                    <div className="flex items-start gap-3">
                                      <ProfileAvatar
                                        profile={party.leader}
                                        size="sm"
                                        fallback={<FaGamepad />}
                                        className="bg-yellow-400/10 text-yellow-300"
                                      />
                                      <div className="min-w-0 flex-1">
                                        <p className="truncate text-xs font-black text-white">
                                          {party.title ||
                                            `${party.party_game || "Game"} Squad`}
                                        </p>
                                        <p className="mt-1 truncate text-[10px] text-gray-500">
                                          {party.party_game || "Any game"} Â·{" "}
                                          {party.party_mode || "Any mode"} Â·{" "}
                                          {party.party_region || "Any region"}
                                        </p>
                                        <div className="mt-2 flex items-center gap-2 text-[10px] font-bold text-gray-400">
                                          <span>
                                            {party.member_count}/
                                            {party.party_size || 5}
                                          </span>
                                          <span>
                                            {party.party_platform ||
                                              "Cross-platform"}
                                          </span>
                                          {party.party_rank ? (
                                            <span className="truncate text-yellow-300">
                                              {party.party_rank}
                                            </span>
                                          ) : null}
                                        </div>
                                      </div>
                                      <button
                                        type="button"
                                        onClick={() => void joinParty(party)}
                                        disabled={(full && !party.joined) || busy}
                                        className={`shrink-0 rounded-lg px-2.5 py-2 text-[10px] font-black transition disabled:opacity-40 ${party.joined ? "border border-cyan-400/30 text-cyan-300" : "bg-cyan-400 text-black hover:bg-cyan-300"}`}
                                      >
                                        {busy
                                          ? "..."
                                          : party.joined
                                            ? "Open"
                                            : full
                                              ? "Full"
                                              : "Join"}
                                      </button>
                                    </div>
                                  </div>
                                );
                              })
                            ) : (
                              <div className="rounded-xl border border-dashed border-white/10 p-4 text-center text-xs text-gray-500">
                                No open squads yet. Be the first to publish one.
                              </div>
                            )}
                          </div>
                        ) : null}
                      </div>
                    </aside>
                  ) : null}
                </div>
              </>
            )}
          </section>
        </section>
      </section>
      {showServerInviteModal && selectedServer ? (
        <div
          className="fixed inset-0 z-[120] flex items-center justify-center bg-black/75 px-4 py-8 backdrop-blur-sm"
          role="dialog"
          aria-modal="true"
          aria-label={`Invite people to ${selectedServer.name}`}
          onMouseDown={(event) => {
            if (event.target === event.currentTarget) {
              setShowServerInviteModal(false);
            }
          }}
        >
          <div className="flex max-h-[88vh] w-full max-w-[560px] flex-col overflow-hidden rounded-2xl border border-cyan-400/30 bg-[#11131a] shadow-[0_28px_100px_rgba(0,0,0,0.72),0_0_40px_rgba(6,182,212,0.12)]">
            <div className="flex items-start justify-between gap-4 px-6 pb-4 pt-6">
              <div className="min-w-0">
                <h2 className="truncate text-xl font-black text-white">
                  Invite friends to {selectedServer.name}
                </h2>
                <p className="mt-1 text-sm text-gray-400">
                  Recipients will enter through #{selectedCommunityChannel?.name || "general"}.
                </p>
              </div>
              <button
                type="button"
                onClick={() => setShowServerInviteModal(false)}
                className="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-gray-400 transition hover:bg-white/10 hover:text-white"
                title="Close"
              >
                <FaTimes />
              </button>
            </div>

            <div className="px-6 pb-4">
              <div className="flex h-11 items-center gap-3 rounded-xl border border-white/10 bg-black/30 px-4 focus-within:border-cyan-400/50">
                <FaSearch className="text-sm text-gray-500" />
                <input
                  value={serverInviteSearch}
                  onChange={(event) => setServerInviteSearch(event.target.value)}
                  placeholder="Search for players"
                  className="min-w-0 flex-1 bg-transparent text-sm text-white outline-none placeholder:text-gray-500"
                />
              </div>
            </div>

            <div className="min-h-[170px] flex-1 overflow-y-auto border-y border-white/10 px-3 py-2">
              {loadingCandidates ? (
                <div className="p-8 text-center text-sm text-gray-400">
                  Loading players...
                </div>
              ) : filteredServerInviteCandidates.length ? (
                filteredServerInviteCandidates.slice(0, 40).map((candidate) => {
                  const sent = serverInviteSentIds.includes(candidate.id);
                  const busy = serverInviteBusy === `user:${candidate.id}`;
                  return (
                    <div
                      key={`server-invite:${candidate.id}`}
                      className="flex items-center gap-3 rounded-xl px-3 py-2.5 transition hover:bg-white/[0.05]"
                    >
                      <ProfileAvatar profile={candidate} size="md" />
                      <div className="min-w-0 flex-1">
                        <p className="truncate text-sm font-bold text-white">
                          {displayName(candidate)}
                        </p>
                        <p className="truncate text-xs text-gray-500">
                          {candidate.username ? `@${candidate.username}` : "ComePlayers player"}
                        </p>
                      </div>
                      <button
                        type="button"
                        onClick={() => void sendServerInvite(candidate)}
                        disabled={sent || busy}
                        className="min-w-[76px] rounded-lg bg-[#34363f] px-4 py-2 text-sm font-bold text-white transition hover:bg-[#454852] disabled:cursor-default disabled:bg-emerald-500/15 disabled:text-emerald-300"
                      >
                        {busy ? "Sending" : sent ? "Invited" : "Invite"}
                      </button>
                    </div>
                  );
                })
              ) : (
                <div className="p-8 text-center text-sm text-gray-500">
                  No players match this search.
                </div>
              )}
            </div>

            <div className="space-y-4 bg-[#202127] px-6 py-5">
              <div className="flex items-center justify-between gap-3">
                <div>
                  <p className="text-sm font-bold text-white">
                    Server invite link
                  </p>
                  <p className="mt-0.5 text-xs text-gray-400">
                    Every generated code is random and belongs only to this server.
                  </p>
                </div>
                <label className="flex items-center gap-2 text-xs font-bold text-gray-300">
                  <FaClock className="text-cyan-300" />
                  <select
                    value={serverInviteExpiry}
                    onChange={(event) =>
                      void changeServerInviteExpiry(
                        event.target.value === "never" ? "never" : "30d",
                      )
                    }
                    disabled={Boolean(serverInviteBusy)}
                    className="rounded-lg border border-white/10 bg-[#11131a] px-3 py-2 text-xs text-white outline-none focus:border-cyan-400/50"
                  >
                    <option value="30d">Expires in 30 days</option>
                    <option value="never">Never expires</option>
                  </select>
                </label>
              </div>

              <div className="flex overflow-hidden rounded-xl border border-white/10 bg-[#11131a]">
                <input
                  readOnly
                  value={activeServerInvite?.url || "Generating invite link..."}
                  className="min-w-0 flex-1 bg-transparent px-4 py-3 text-sm text-gray-200 outline-none"
                />
                <button
                  type="button"
                  onClick={() =>
                    void copyText(activeServerInvite?.url || "", "invite")
                  }
                  disabled={!activeServerInvite?.url || Boolean(serverInviteBusy)}
                  className="flex min-w-[92px] items-center justify-center gap-2 bg-indigo-500 px-4 text-sm font-black text-white transition hover:bg-indigo-400 disabled:opacity-50"
                >
                  {serverInviteCopied === "invite" ? <FaCheck /> : <FaCopy />}
                  {serverInviteCopied === "invite" ? "Copied" : "Copy"}
                </button>
              </div>

              <div className="flex flex-wrap items-center justify-between gap-3 text-xs text-gray-400">
                <span>
                  {activeServerInvite?.isPermanent
                    ? "This invite link never expires."
                    : activeServerInvite?.expires_at
                      ? `Expires ${new Date(activeServerInvite.expires_at).toLocaleString()}`
                      : "Preparing expiration settings..."}
                </span>
                <button
                  type="button"
                  onClick={() => void regenerateServerInvite()}
                  disabled={Boolean(serverInviteBusy)}
                  className="inline-flex items-center gap-2 font-bold text-cyan-300 hover:text-cyan-200 disabled:opacity-50"
                >
                  <FaRedo /> Generate new random link
                </button>
              </div>

              <div className="border-t border-white/10 pt-4">
                <p className="mb-2 text-xs font-bold text-gray-300">
                  Direct server/channel address
                </p>
                <div className="flex overflow-hidden rounded-xl border border-white/10 bg-[#11131a]">
                  <input
                    readOnly
                    value={
                      serverChannelUrl ||
                      (selectedChannelId
                        ? `${typeof window !== "undefined" ? window.location.origin : ""}${serverChannelPath(selectedRoomId, selectedChannelId)}`
                        : "Select a server channel")
                    }
                    className="min-w-0 flex-1 bg-transparent px-4 py-3 text-xs text-gray-300 outline-none"
                  />
                  <button
                    type="button"
                    onClick={() =>
                      void copyText(
                        serverChannelUrl ||
                          `${window.location.origin}${serverChannelPath(selectedRoomId, selectedChannelId)}`,
                        "channel",
                      )
                    }
                    disabled={!serverChannelUrl && !selectedChannelId}
                    className="flex min-w-[92px] items-center justify-center gap-2 border-l border-white/10 px-4 text-xs font-black text-cyan-300 hover:bg-white/5 disabled:opacity-50"
                  >
                    {serverInviteCopied === "channel" ? <FaCheck /> : <FaCopy />}
                    {serverInviteCopied === "channel" ? "Copied" : "Copy"}
                  </button>
                </div>
              </div>

              {serverInviteLinks.filter((invite) => invite.isActive).length > 1 ? (
                <div className="border-t border-white/10 pt-4">
                  <p className="mb-2 text-xs font-bold text-gray-300">
                    Other active invite links
                  </p>
                  <div className="max-h-24 space-y-1 overflow-y-auto">
                    {serverInviteLinks
                      .filter((invite) => invite.isActive)
                      .slice(0, 6)
                      .map((invite) => (
                        <button
                          key={invite.id}
                          type="button"
                          onClick={() => {
                            setActiveServerInvite(invite);
                            setServerInviteExpiry(
                              invite.isPermanent ? "never" : "30d",
                            );
                          }}
                          className={`flex w-full items-center justify-between gap-3 rounded-lg px-3 py-2 text-left text-xs transition ${
                            activeServerInvite?.id === invite.id
                              ? "bg-cyan-400/10 text-cyan-200"
                              : "text-gray-400 hover:bg-white/5 hover:text-white"
                          }`}
                        >
                          <span className="truncate">/{invite.code}</span>
                          <span className="shrink-0">
                            {invite.isPermanent ? "Permanent" : "30 days"}
                          </span>
                        </button>
                      ))}
                  </div>
                </div>
              ) : null}
            </div>
          </div>
        </div>
      ) : null}
      {showLiveLobbyPicker ? (
        <div
          className="fixed inset-0 z-[130] flex items-center justify-center bg-black/75 p-4 backdrop-blur-sm"
          role="dialog"
          aria-modal="true"
          aria-label="Choose a Voice Lobby for live streaming"
          onMouseDown={(event) => {
            if (event.target === event.currentTarget) {
              setShowLiveLobbyPicker(false);
            }
          }}
        >
          <div className="w-full max-w-xl overflow-hidden rounded-3xl border border-cyan-400/30 bg-[#061421]/98 shadow-[0_30px_100px_rgba(0,0,0,0.75),0_0_50px_rgba(6,182,212,0.12)]">
            <div className="flex items-start justify-between gap-4 border-b border-white/10 px-6 py-5">
              <div>
                <p className="text-xs font-black uppercase tracking-[0.2em] text-cyan-300">
                  Go Live
                </p>
                <h2 className="mt-1 text-xl font-black text-white">
                  Choose a Voice Lobby
                </h2>
                <p className="mt-1 text-sm text-slate-400">
                  Live streaming is only available from a server Voice Lobby. Select one to join and go live automatically.
                </p>
              </div>
              <button
                type="button"
                onClick={() => setShowLiveLobbyPicker(false)}
                className="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-white/10 text-slate-400 transition hover:bg-white/5 hover:text-white"
                title="Close"
              >
                <FaTimes />
              </button>
            </div>

            <div className="max-h-[48vh] space-y-2 overflow-y-auto p-5">
              {serverVoiceChannels.map((channel) => {
                const selected = selectedLiveLobbyId === channel.id;
                const connected =
                  voiceDockState.connected &&
                  voiceDockState.channelId === channel.id;
                return (
                  <button
                    key={`live-lobby:${channel.id}`}
                    type="button"
                    onClick={() => selectLiveLobbyForStreaming(channel)}
                    className={`flex w-full items-center gap-4 rounded-2xl border p-4 text-left transition ${
                      selected
                        ? "border-yellow-400/60 bg-yellow-400/10 shadow-[0_0_24px_rgba(250,204,21,0.12)]"
                        : "border-white/10 bg-white/[0.035] hover:border-cyan-400/35 hover:bg-cyan-400/[0.07]"
                    }`}
                  >
                    <span
                      className={`flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border text-lg ${
                        selected
                          ? "border-yellow-400/45 bg-yellow-400/15 text-yellow-300"
                          : "border-cyan-400/25 bg-cyan-400/10 text-cyan-300"
                      }`}
                    >
                      <FaVolumeUp />
                    </span>
                    <span className="min-w-0 flex-1">
                      <span className="block truncate text-sm font-black text-white">
                        {channel.name}
                      </span>
                      <span className="mt-1 block truncate text-xs text-slate-400">
                        {connected
                          ? `${voiceDockState.participantCount} connected`
                          : channel.topic || "Ready to join and start live"}
                      </span>
                    </span>
                    <span
                      className={`rounded-full px-3 py-1 text-[10px] font-black uppercase tracking-wider ${
                        selected
                          ? "bg-yellow-400 text-black"
                          : "border border-white/10 text-slate-400"
                      }`}
                    >
                      {selected ? "Joining" : "Auto Start"}
                    </span>
                  </button>
                );
              })}
            </div>

            <div className="flex items-center justify-between gap-3 border-t border-white/10 bg-black/20 px-5 py-4">
              <p className="text-xs font-bold text-slate-400">
                Pick one lobby and ComePlayers will join it and start live automatically.
              </p>
              <button
                type="button"
                onClick={() => setShowLiveLobbyPicker(false)}
                className="min-h-11 rounded-xl border border-white/10 px-5 text-sm font-black text-slate-300 transition hover:bg-white/5 hover:text-white"
              >
                Cancel
              </button>
            </div>
          </div>
        </div>
      ) : null}

      {selectedIsGroup && selectedRoom ? (
        <div
          className={`${styles.voiceDock} ${showMemberPanel ? "" : styles.voiceDockExpanded} fixed bottom-4 left-[370px] right-6 z-30 hidden h-20 items-center overflow-hidden rounded-2xl border border-yellow-400/25 bg-[#07131f]/94 shadow-[0_0_34px_rgba(250,204,21,0.12),inset_0_0_28px_rgba(255,255,255,0.025)] backdrop-blur-xl xl:flex 2xl:right-[365px]`}
        >
          <div className="flex h-full min-w-0 flex-1 items-center gap-4 px-4">
            <span
              className={`inline-flex min-h-10 shrink-0 items-center gap-2 rounded-xl border px-3 text-xs font-black uppercase tracking-wider ${
                streamIsActive
                  ? "border-red-400/35 bg-red-500/15 text-red-200"
                  : "border-yellow-400/25 bg-yellow-400/10 text-yellow-200"
              }`}
            >
              <FaBroadcastTower />
              {streamIsActive ? "Live Now" : "Live Ready"}
            </span>

            <ServerAvatar
              name={selectedServer?.name || roomTitle(selectedRoom)}
              iconUrl={selectedServer?.icon_url}
              className="h-12 w-12 rounded-full border-2 border-yellow-400/35 shadow-[0_0_18px_rgba(250,204,21,0.18)]"
            />

            <div className="min-w-0 border-r border-white/10 pr-5">
              <p className="truncate text-sm font-black text-white">
                {selectedServer?.name || roomTitle(selectedRoom)} Server
              </p>
              <p className="truncate text-[11px] text-gray-400">
                {streamIsActive
                  ? selectedRoom.stream_title || selectedRoom.party_game || "Live gameplay"
                  : selectedRoom.party_game || "Start a server livestream"}
                {selectedRoom.party_mode ? ` Â· ${selectedRoom.party_mode}` : ""}
              </p>
            </div>

            <div className="hidden min-w-[105px] items-center gap-3 border-r border-white/10 pr-5 lg:flex">
              <span className={`h-2.5 w-2.5 rounded-full ${streamIsActive ? "bg-red-500 shadow-[0_0_12px_rgba(239,68,68,0.7)]" : "bg-gray-600"}`} />
              <div>
                <p className="text-lg font-black leading-5 text-white">{streamViewerCount}</p>
                <p className="text-[9px] text-gray-500">Watching Now</p>
              </div>
            </div>

            <div className="hidden min-w-[125px] items-center gap-3 border-r border-white/10 pr-5 xl:flex">
              <FaClock className="text-cyan-300" />
              <div>
                <p className="text-sm font-black text-white">
                  {streamIsActive ? <LiveDuration startedAt={selectedRoom.stream_started_at} /> : "00:00:00"}
                </p>
                <p className="text-[9px] text-gray-500">
                  {streamIsActive
                    ? `Started by ${displayName(selectedRoom.stream_host)}`
                    : "Live Duration"}
                </p>
              </div>
            </div>

            <div className="ml-auto hidden items-center -space-x-2 2xl:flex">
              {conversationMembers.slice(0, 5).map((member) => (
                <ProfileAvatar
                  key={`live-audience:${member.user_id}`}
                  profile={member.profile}
                  size="sm"
                  className="border-2 border-[#07131f]"
                />
              ))}
              {conversationMembers.length > 5 ? (
                <span className="flex h-9 w-9 items-center justify-center rounded-full border-2 border-[#07131f] bg-yellow-400/15 text-[9px] font-black text-yellow-200">
                  +{conversationMembers.length - 5}
                </span>
              ) : null}
            </div>

            <button
              type="button"
              onClick={handleDockLiveAction}
              className="ml-auto min-h-11 shrink-0 rounded-xl bg-gradient-to-r from-yellow-500 via-yellow-400 to-amber-300 px-6 text-sm font-black text-black shadow-[0_0_24px_rgba(250,204,21,0.34)] transition hover:brightness-110"
            >
              {streamIsActive
                ? selectedRoom.stream_host_id === userId
                  ? "Stop Live"
                  : streamViewerActive
                    ? "Leave Live"
                    : "Watch Live"
                : "Go Live"}
            </button>
          </div>
        </div>
      ) : null}
    </main>
  );
}


