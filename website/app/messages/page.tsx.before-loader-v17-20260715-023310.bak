                              ) : (
                                <p className={styles.rightPanelEmpty}>No members online.</p>
                              )}
                            </div>

                            <div className={styles.memberStatusSection}>
                              <p>Offline â€” {offlineConversationMembers.length}</p>
                              {offlineConversationMembers.slice(0, 6).map((member) => (
                                <button
                                  key={`offline:${member.user_id}`}
                                  type="button"
                                  onClick={() => void openCommunityOverlay("members")}
                                  className={`${styles.rightMemberRow} opacity-60`}
                                >
                                  <span className="relative shrink-0 grayscale">
                                    <ProfileAvatar profile={member.profile} size="sm" />
                                    <span className="absolute -bottom-0.5 -right-0.5 h-3 w-3 rounded-full border-2 border-[#071827] bg-slate-600" />
                                  </span>
                                  <span className="min-w-0 flex-1">
                                    <span className="block truncate text-xs font-bold text-gray-300">
                                      {displayName(member.profile)}
                                    </span>
                                    <span className="block text-[10px] text-gray-600">Offline</span>
                                  </span>
                                </button>
                              ))}
                            </div>
                          </>
                        ) : null}

                        {rightPanelTab === "squad" ? (
                          <>
                            <div className={styles.rightPanelHeading}>
                              <div>
                                <p>Squad</p>
                                <span>
                                  {conversationMembers.length}/
                                  {selectedRoom.party_size || Math.max(conversationMembers.length, 5)} players
                                </span>
