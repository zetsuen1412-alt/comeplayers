<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#D4AF37</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#090E18</item>
        <item name="android:navigationBarColor">#111A2A</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#0B101A</item>
        <item name="android:colorControlNormal">#C4CCD8</item>
        <item name="android:colorControlActivated">#D4AF37</item>
        <item name="android:alertDialogTheme">@style/LuxuryDialog</item>
    </style>
    <style name="LuxuryDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#D4AF37</item>
        <item name="android:windowBackground">#1C2739</item>
        <item name="android:textColorPrimary">#F8FAFC</item>
        <item name="android:textColorSecondary">#AAB9CD</item>
        <item name="android:fontFamily">sans</item>
    </style>
</resources>