# Must match the website value exactly. Generate a random value of 32+ characters.
EMPIRES_ALLIES_SHARED_SECRET=replace-with-a-long-random-secret

# Public embedding/security settings
COMEPLAYERS_EMBED_MODE=1
COMEPLAYERS_ALLOW_GUEST=0
COMEPLAYERS_REQUIRE_ONLINE_STORAGE=0
# Writable folder for SQLite saves and sessions, relative to this service folder.
COMEPLAYERS_DATA_DIR=data
COMEPLAYERS_COOKIE_SECURE=0
COMEPLAYERS_COOKIE_SAMESITE=Lax
COMEPLAYERS_COOKIE_PARTITIONED=0
COMEPLAYERS_FRAME_ANCESTORS='self' https://comeplayers.com https://www.comeplayers.com http://localhost:3000 http://127.0.0.1:3000
COMEPLAYERS_CORS_ORIGINS=https://comeplayers.com,https://www.comeplayers.com,http://localhost:3000,http://127.0.0.1:3000

# Ruffle official CDN. Replace with a self-hosted ruffle.js URL when desired.
RUFFLE_SCRIPT_URL=https://unpkg.com/@ruffle-rs/ruffle

HOST=127.0.0.1
PORT=5005
