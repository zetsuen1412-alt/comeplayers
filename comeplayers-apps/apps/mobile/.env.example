# Shared ComePlayers API. The app uses native screens; it does not render this URL.
EXPO_PUBLIC_COMEPLAYERS_API_URL=https://www.comeplayers.com

# Use the same Supabase project as the ComePlayers website.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Public OAuth client identifier used by the native Google sign-in screen.
EXPO_PUBLIC_GOOGLE_AUTH_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
