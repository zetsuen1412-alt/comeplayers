{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "comeplayers-website",
  "description": "Permit only the official ComePlayers website to open validated Google sign-in and show bounded, silent Windows notifications.",
  "windows": ["main"],
  "platforms": ["windows"],
  "local": false,
  "remote": {
    "urls": ["https://www.comeplayers.com"]
  },
  "permissions": ["allow-open-google-oauth", "allow-notification-permission", "allow-request-notification-permission", "allow-show-comeplayers-notification", "allow-close-comeplayers-notification"]
}
